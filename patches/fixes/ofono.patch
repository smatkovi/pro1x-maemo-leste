 }
 
+/*
+ * The data path of an embedded Qualcomm SoC with the mainline Linux IPA
+ * driver (drivers/net/ipa), set up as ModemManager's qcom-soc support does
+ * it (src/mm-port-qmi.c, ModemManager 1.24):
+ *
+ *  - DPM "Open Port" binds the IPA endpoints that face the modem (sysfs
+ *    device/modem/{rx,tx}_endpoint_id of rmnet_ipa0) to the embedded data
+ *    port (endpoint type EMBEDDED, interface 1, as gprs-context's
+ *    BIND_MUX_DATA_PORT uses);
+ *  - WDA "Set Data Format" on that port: raw IP, QMAPv5, else QMAPv4, else
+ *    QMAP, each read back with "Get Data Format";
+ *  - rmnet links with the checksum offload the IPA hardware does (sysfs
+ *    device/feature/{rx,tx}_offload: "MAPv4" below IPA v4.5, "MAPv5" from
+ *    it; ipa_sysfs.c), which the IPA expects on uplink packets and appends
+ *    to downlink ones.
+ *
+ * A failure (or no answer within IPA_SETUP_TIMEOUT) only costs the data
+ * contexts: the modem is powered anyway, for calls and SMS.
+ *
+ * For tests on a device, without a rebuild (environment of ofonod, e.g.
+ * exported in /etc/default/ofono):
+ *   OFONO_IPA_WDA=qmapv5|qmapv4|qmap  only this aggregation protocol
+ *   OFONO_IPA_DPM=0                   no DPM "Open Port"
+ *   OFONO_IPA_RMNET_FLAGS=<n>         the rmnet links' data format instead
+ *                                     of the one from sysfs (0xd: DEAGG,
+ *                                     MAP checksum v4 in and out)
+ */
+static const uint32_t ipa_wda_protocols[] = {
+	QMI_WDA_AGGREGATION_PROTOCOL_QMAPV5,
+	QMI_WDA_AGGREGATION_PROTOCOL_QMAPV4,
+	QMI_WDA_AGGREGATION_PROTOCOL_QMAP,
+};
+
+static const char *const ipa_wda_names[] = { "qmapv5", "qmapv4", "qmap" };
+
+static const struct qmi_endpoint_info ipa_endpoint_info = {
+	.endpoint_type = L_CPU_TO_LE32(QMI_DATA_ENDPOINT_TYPE_EMBEDDED),
+	.interface_number = L_CPU_TO_LE32(0x01),
+};
+
+struct qmi_dpm_hw_data_ports {
+	uint8_t n_ports;
+	uint32_t endpoint_type;
+	uint32_t interface_number;
+	uint32_t rx_endpoint_number;
+	uint32_t tx_endpoint_number;
+} __attribute__((packed));
+
+static int ipa_read_sysfs(const char *ifname, const char *attr,
+						char *buf, size_t len)
+{
+	char path[128];
+	ssize_t n;
+	int fd;
+	int r;
+
+	r = snprintf(path, sizeof(path), "/sys/class/net/%s/device/%s",
+							ifname, attr);
+	if (r < 0 || (size_t) r >= sizeof(path))
+		return -ENAMETOOLONG;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+
+	n = read(fd, buf, len - 1);
+	r = n < 0 ? -errno : 0;
+	close(fd);
+
+	if (r < 0)
+		return r;
+
+	buf[n] = '\0';
+	buf[strcspn(buf, "\n")] = '\0';
+
+	return 0;
+}
+
+static void ipa_setup_done(struct qrtrqmi_data *data)
+{
+	l_timeout_remove(data->ipa_timeout);
+	data->ipa_timeout = NULL;
+	qmi_service_free(data->dpm);
+	data->dpm = NULL;
+}
+
+static void ipa_data_unavailable(struct ofono_modem *modem, const char *why)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+
+	ofono_warn("%s: no mobile data: %s", ofono_modem_get_path(modem), why);
+
+	ipa_setup_done(data);
+
+	if (data->rmnet_id) {
+		rmnet_cancel(data->rmnet_id);
+		data->rmnet_id = 0;
+	}
+
+	data->n_premux = 0;
+	ofono_modem_set_powered(modem, TRUE);
+}
+
+static void ipa_setup_timeout(struct l_timeout *timeout, void *user_data)
+{
+	struct ofono_modem *modem = user_data;
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+
+	/* Freeing the services drops their pending requests */
+	qmi_service_free(data->wda);
+	data->wda = NULL;
+
+	ipa_data_unavailable(modem, "no answer from the modem");
+}
+
+static void ipa_create_links(struct ofono_modem *modem)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+
+	data->rmnet_id = rmnet_get_interfaces_flags(data->main_net_ifindex,
+						MAX_CONTEXTS,
+						data->ipa_rmnet_flags,
+						rmnet_get_interfaces_cb,
+						modem, NULL);
+	if (data->rmnet_id > 0)
+		return;
+
+	data->rmnet_id = 0;
+	ipa_data_unavailable(modem, "unable to request the rmnet links");
+}
+
+static int ipa_wda_get_format(struct ofono_modem *modem,
+					qmi_service_result_func_t func)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	struct qmi_param *param = NULL;
+
+	if (data->ipa_wda_endpoint) {
+		param = qmi_param_new();
+		qmi_param_append(param, 0x10, sizeof(ipa_endpoint_info),
+							&ipa_endpoint_info);
+	}
+
+	if (qmi_service_send(data->wda, QMI_WDA_GET_DATA_FORMAT, param,
+					func, modem, NULL) > 0)
+		return 0;
+
+	qmi_param_free(param);
+	return -EIO;
+}
+
+static void ipa_wda_set_next(struct ofono_modem *modem);
+
+static void ipa_wda_verify_cb(struct qmi_result *result, void *user_data)
+{
+	struct ofono_modem *modem = user_data;
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	uint32_t want = ipa_wda_protocols[data->ipa_wda_try];
+	uint32_t llp, ul, dl;
+	uint16_t error;
+
+	if (qmi_result_set_error(result, &error)) {
+		ofono_warn("%s: WDA data format not read back (%u), "
+				"taking protocol %u as set",
+				ofono_modem_get_path(modem), error, want);
+		goto done;
+	}
+
+	if (!qmi_result_get_uint32(result, 0x11, &llp) ||
+			!qmi_result_get_uint32(result, 0x12, &ul) ||
+			!qmi_result_get_uint32(result, 0x13, &dl)) {
+		ofono_warn("%s: WDA data format incomplete, "
+				"taking protocol %u as set",
+				ofono_modem_get_path(modem), want);
+		goto done;
+	}
+
+	if (llp != QMI_WDA_DATA_LINK_PROTOCOL_RAW_IP || ul != want ||
+			dl != want) {
+		DBG("asked for protocol %u, modem has link layer %u, "
+			"uplink %u, downlink %u", want, llp, ul, dl);
+		data->ipa_wda_try += 1;
+		ipa_wda_set_next(modem);
+		return;
+	}
+
+done:
+	ofono_info("%s: WDA data format: raw IP, aggregation protocol %u "
+			"(5 QMAP, 8 QMAPv4, 9 QMAPv5)",
+			ofono_modem_get_path(modem), want);
+	ipa_create_links(modem);
+}
+
+static void ipa_wda_set_cb(struct qmi_result *result, void *user_data)
+{
+	struct ofono_modem *modem = user_data;
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	uint16_t error;
+
+	if (qmi_result_set_error(result, &error)) {
+		DBG("protocol %u refused: %u",
+			ipa_wda_protocols[data->ipa_wda_try], error);
+		data->ipa_wda_try += 1;
+		ipa_wda_set_next(modem);
+		return;
+	}
+
+	if (ipa_wda_get_format(modem, ipa_wda_verify_cb) < 0)
+		ipa_create_links(modem);
+}
+
+static void ipa_wda_set_next(struct ofono_modem *modem)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	struct qmi_param *param;
+	uint32_t protocol;
+
+	if (data->ipa_wda_try >= data->ipa_wda_end) {
+		ipa_data_unavailable(modem,
+			"the modem took none of QMAPv5, QMAPv4 and QMAP (WDA)");
+		return;
+	}
+
+	protocol = ipa_wda_protocols[data->ipa_wda_try];
+	DBG("WDA set data format: protocol %u, endpoint info %s", protocol,
+					data->ipa_wda_endpoint ? "yes" : "no");
+
+	param = qmi_param_new();
+	qmi_param_append_uint32(param, 0x11, QMI_WDA_DATA_LINK_PROTOCOL_RAW_IP);
+	qmi_param_append_uint32(param, 0x12, protocol);
+	qmi_param_append_uint32(param, 0x13, protocol);
+	qmi_param_append_uint32(param, 0x15, DEFAULT_DL_DATAGRAMS);
+	qmi_param_append_uint32(param, 0x16, DEFAULT_DL_AGGREGATION_SIZE);
+
+	if (data->ipa_wda_endpoint)
+		qmi_param_append(param, 0x17, sizeof(ipa_endpoint_info),
+							&ipa_endpoint_info);
+
+	if (qmi_service_send(data->wda, QMI_WDA_SET_DATA_FORMAT, param,
+					ipa_wda_set_cb, modem, NULL) > 0)
+		return;
+
+	qmi_param_free(param);
+	ipa_data_unavailable(modem, "unable to send WDA set data format");
+}
+
+static void ipa_wda_get_first_cb(struct qmi_result *result, void *user_data)
+{
+	struct ofono_modem *modem = user_data;
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	uint32_t llp = 0, ul = 0, dl = 0;
+	uint16_t error;
+
+	if (qmi_result_set_error(result, &error)) {
+		/*
+		 * As ModemManager: a modem that misses the endpoint info
+		 * says so; ask again with it, and set the format with it
+		 */
+		if (error == QMI_PROTOCOL_ERROR_MISSING_ARGUMENT &&
+				!data->ipa_wda_endpoint) {
+			data->ipa_wda_endpoint = true;
+
+			if (ipa_wda_get_format(modem,
+						ipa_wda_get_first_cb) == 0)
+				return;
+		}
+
+		DBG("WDA get data format failed: %u", error);
+	} else {
+		qmi_result_get_uint32(result, 0x11, &llp);
+		qmi_result_get_uint32(result, 0x12, &ul);
+		qmi_result_get_uint32(result, 0x13, &dl);
+		DBG("WDA data format now: link layer %u, uplink %u, "
+					"downlink %u", llp, ul, dl);
+	}
+
+	ipa_wda_set_next(modem);
+}
+
+static void ipa_wda_start(struct ofono_modem *modem)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	const char *env = getenv("OFONO_IPA_WDA");
+	unsigned int i;
+
+	data->ipa_wda_endpoint = false;
+	data->ipa_wda_try = 0;
+	data->ipa_wda_end = L_ARRAY_SIZE(ipa_wda_protocols);
+
+	for (i = 0; env && i < L_ARRAY_SIZE(ipa_wda_names); i++) {
+		if (strcmp(env, ipa_wda_names[i]))
+			continue;
+
+		ofono_info("%s: OFONO_IPA_WDA: only %s",
+				ofono_modem_get_path(modem), env);
+		data->ipa_wda_try = i;
+		data->ipa_wda_end = i + 1;
+	}
+
+	if (ipa_wda_get_format(modem, ipa_wda_get_first_cb) < 0)
+		ipa_data_unavailable(modem, "unable to send WDA get data format");
+}
+
+static void ipa_dpm_open_port_cb(struct qmi_result *result, void *user_data)
+{
+	struct ofono_modem *modem = user_data;
+	uint16_t error;
+
+	/* ModemManager stops here; the port may still be open from before */
+	if (qmi_result_set_error(result, &error))
+		ofono_warn("%s: DPM open port failed (%u), going on",
+					ofono_modem_get_path(modem), error);
+	else
+		ofono_info("%s: DPM port open",
+					ofono_modem_get_path(modem));
+
+	ipa_wda_start(modem);
+}
+
+static int ipa_dpm_open_port(struct ofono_modem *modem)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	struct qmi_dpm_hw_data_ports port;
+	struct qmi_param *param;
+	char rx[16], tx[16];
+	uint32_t rx_id, tx_id;
+
+	if (!qmi_qrtr_node_has_service(data->node, QMI_SERVICE_DPM)) {
+		ofono_warn("%s: modem has no DPM service",
+					ofono_modem_get_path(modem));
+		return -ENOENT;
+	}
+
+	if (ipa_read_sysfs(data->main_net_name, "modem/rx_endpoint_id",
+					rx, sizeof(rx)) < 0 ||
+			ipa_read_sysfs(data->main_net_name,
+					"modem/tx_endpoint_id",
+					tx, sizeof(tx)) < 0 ||
+			l_safe_atou32(rx, &rx_id) < 0 ||
+			l_safe_atou32(tx, &tx_id) < 0) {
+		ofono_warn("%s: no IPA endpoint ids in sysfs, DPM port "
+				"not opened", ofono_modem_get_path(modem));
+		return -ENOENT;
+	}
+
+	data->dpm = qmi_qrtr_node_get_service(data->node, QMI_SERVICE_DPM);
+	if (!data->dpm)
+		return -EIO;
+
+	/*
+	 * As ModemManager: the modem's RX endpoint is the IPA's TX one
+	 * (AP_MODEM_TX, sysfs tx_endpoint_id), its TX endpoint the IPA's
+	 * RX one (AP_MODEM_RX)
+	 */
+	port.n_ports = 1;
+	port.endpoint_type = L_CPU_TO_LE32(QMI_DATA_ENDPOINT_TYPE_EMBEDDED);
+	port.interface_number = L_CPU_TO_LE32(0x01);
+	port.rx_endpoint_number = L_CPU_TO_LE32(tx_id);
+	port.tx_endpoint_number = L_CPU_TO_LE32(rx_id);
+
+	ofono_info("%s: DPM open port: modem RX endpoint %u, TX endpoint %u",
+				ofono_modem_get_path(modem), tx_id, rx_id);
+
+	param = qmi_param_new();
+	qmi_param_append(param, 0x11, sizeof(port), &port);
+
+	if (qmi_service_send(data->dpm, QMI_DPM_OPEN_PORT, param,
+					ipa_dpm_open_port_cb, modem, NULL) > 0)
+		return 0;
+
+	qmi_param_free(param);
+	return -EIO;
+}
+
+static void ipa_setup_data_path(struct ofono_modem *modem)
+{
+	struct qrtrqmi_data *data = ofono_modem_get_data(modem);
+	uint32_t flags = RMNET_FLAGS_INGRESS_DEAGGREGATION;
+	const char *env;
+	char buf[32];
+
+	if (!qmi_qrtr_node_has_service(data->node, QMI_SERVICE_WDA)) {
+		ipa_data_unavailable(modem, "the modem has no WDA service");
+		return;
+	}
+
+	if (ipa_read_sysfs(data->main_net_name, "feature/rx_offload",
+					buf, sizeof(buf)) == 0) {
+		if (l_str_has_prefix(buf, "MAPv4"))
+			flags |= RMNET_FLAGS_INGRESS_MAP_CKSUMV4;
+		else if (l_str_has_prefix(buf, "MAPv5"))
+			flags |= RMNET_FLAGS_INGRESS_MAP_CKSUMV5;
+	}
+
+	if (ipa_read_sysfs(data->main_net_name, "feature/tx_offload",
+					buf, sizeof(buf)) == 0) {
+		if (l_str_has_prefix(buf, "MAPv4"))
+			flags |= RMNET_FLAGS_EGRESS_MAP_CKSUMV4;
+		else if (l_str_has_prefix(buf, "MAPv5"))
+			flags |= RMNET_FLAGS_EGRESS_MAP_CKSUMV5;
+	}
