-			dbus_g_proxy_call(p->location_ui_proxy, "close", NULL, G_TYPE_INVALID);
+			dbus_g_proxy_call(p->location_ui_proxy, "close", NULL, G_TYPE_INVALID,
+					G_TYPE_INVALID);
 			p->ui_open = FALSE;
 		}
