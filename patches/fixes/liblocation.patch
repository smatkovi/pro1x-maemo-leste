-			"type='signal',interface='com.nokia.Location.Uncertainty",
+			"type='signal',interface='com.nokia.Location.Uncertainty'",
 			NULL);
 		dbus_connection_add_filter(p->bus,
 			(DBusHandleMessageFunction)on_locationdaemon_signal,
diff --git a/src/location-gpsd-control.c b/src/location-gpsd-control.c
index b0b9c69..75ddf59 100644
--- a/src/location-gpsd-control.c
+++ b/src/location-gpsd-control.c
@@ -167,7 +167,8 @@ void ui_proxy_close(LocationGPSDControl *control)
 
 	if (p->location_ui_proxy) {
 		if (p->ui_open) {
-			dbus_g_proxy_call(p->location_ui_proxy, "close", NULL, G_TYPE_INVALID);
+			dbus_g_proxy_call(p->location_ui_proxy, "close", NULL, G_TYPE_INVALID,
+					G_TYPE_INVALID);
 			p->ui_open = FALSE;
 		}
 		g_object_unref(p->location_ui_proxy);
@@ -180,11 +181,13 @@ int get_selected_method(LocationGPSDControl *control, int method)
 	int acwp, gnss, agnss, result;
 	LocationGPSDControlPrivate *p = location_gpsd_control_get_instance_private(control);
 
-	if (method) {
+	/* LOCATION_METHOD_USER_SELECTED (0): every method the user allows
+	 * (cell positioning, CWP, being a network one) */
+	if (!method) {
 		acwp = LOCATION_METHOD_ACWP;
 		gnss = LOCATION_METHOD_GNSS;
 		agnss = LOCATION_METHOD_AGNSS;
-		result = LOCATION_METHOD_CWP;
+		result = p->net_disabled ? 0 : LOCATION_METHOD_CWP;
 		goto out;
 	}
 
@@ -271,7 +274,7 @@ void register_dbus_signal_callback(LocationGPSDControl *control,
 		dbus_g_proxy_connect_signal(p->location_ui_proxy, "response",
 				handler_func, control, NULL);
 		dbus_g_proxy_call(p->location_ui_proxy, "display",
-				&ierr, G_TYPE_INVALID);
+				&ierr, G_TYPE_INVALID, G_TYPE_INVALID);
 
 		/* TODO: Some error is raised here */
 		if (ierr) {
@@ -751,10 +754,16 @@ void get_location_method(LocationGPSDControl *control, const GConfValue *value)
 	LocationGPSDControlPrivate *p;
 	GConfValue *car_ret, *cdr_ret;
 	const gchar *cdr_str, *car_str;
+	gboolean was_running;
 
 	p = location_gpsd_control_get_instance_private(control);
 
-	if (p->gpsd_running)
+	/* Restarted with the new method only where positioning ran: called
+	 * from location_gpsd_control_init() too, where it ran nowhere, and
+	 * creating a control must not start it (location_gpsd_control_start()
+	 * does, with the dialogs it may need) */
+	was_running = p->gpsd_running;
+	if (was_running)
 		gpsd_shutdown(control);
 
 	if (p->device != NULL) {
@@ -768,7 +777,7 @@ void get_location_method(LocationGPSDControl *control, const GConfValue *value)
 	}
 
 	if (!value) {
-		if (!p->gpsd_running)
+		if (was_running)
 			g_signal_emit(control, signals[GPSD_STOPPED], 0);
 		return;
 	}
@@ -779,7 +788,7 @@ void get_location_method(LocationGPSDControl *control, const GConfValue *value)
 	if (car_ret) {
 		if (!cdr_ret || car_ret->type != GCONF_VALUE_STRING
 				|| cdr_ret->type != GCONF_VALUE_STRING) {
-			if (!p->gpsd_running)
+			if (was_running)
 				g_signal_emit(control, signals[GPSD_STOPPED], 0);
 		} else {
 			cdr_str = gconf_value_get_string(cdr_ret);
@@ -789,7 +798,7 @@ void get_location_method(LocationGPSDControl *control, const GConfValue *value)
 			g_debug("car_str: %s", car_str);
 			p->device_car = g_strdup(car_str);
 
-			if (!p->gpsd_running)
+			if (was_running)
 				location_gpsd_control_prestart_internal(control, TRUE);
 		}
 	}
