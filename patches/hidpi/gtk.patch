-#define HILDON_HEIGHT_FINGER    70
+gint
+_hildon_gtk_scale (gint pixels)
+{
+  static gdouble scale = 0;
+
+  if (scale == 0)
+    {
+      const gchar *env = g_getenv ("HILDON_SCALE");
+      gchar *theme = NULL;
+
+      /* Else the factor the theme was made for (pro1x-theme-scale) */
+      if (!env && g_file_get_contents ("/etc/hildon/theme/.pro1x-theme",
+                                       &theme, NULL, NULL))
+        env = strchr (theme, '\n') ? strchr (theme, '\n') + 1 : NULL;
+      scale = env ? g_ascii_strtod (env, NULL) : 1;
+      if (!(scale >= 0.5 && scale <= 8))
+        scale = 1;
+      g_free (theme);
+    }
+
+  return (gint) floor (pixels * scale + 0.5);
+}
+
+#define HILDON_HEIGHT_FINGER    _hildon_gtk_scale (70)
 
-#define HILDON_HEIGHT_THUMB     105
+#define HILDON_HEIGHT_THUMB     _hildon_gtk_scale (105)
 
 #define HILDON_WIDTH_FULLSCREEN (gdk_screen_get_width (gdk_screen_get_default ()))
 
