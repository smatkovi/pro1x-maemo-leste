diff --git a/src/hd-scale.h b/src/hd-scale.h
new file mode 100644
index 0000000..3a52dee
--- /dev/null
+++ b/src/hd-scale.h
@@ -0,0 +1,40 @@
+/*
+ * HiDPI: Hildon's lengths are the N900's pixels; on a denser screen they
+ * are scaled by HILDON_SCALE from the environment, or else by the factor
+ * the theme was made for (/etc/hildon/theme/.pro1x-theme, written by
+ * pro1x-theme-scale), e.g. 2.25 on 2160x1080 for the N900's proportion.
+ */
+
+#ifndef __HD_SCALE_H__
+#define __HD_SCALE_H__
+
+#include <math.h>
+#include <string.h>
+#include <glib.h>
+
+static inline gdouble
+hd_scale (void)
+{
+  static gdouble scale = 0;
+
+  if (scale == 0)
+    {
+      const gchar *env = g_getenv ("HILDON_SCALE");
+      gchar *theme = NULL;
+
+      /* Else the factor the theme was made for (pro1x-theme-scale) */
+      if (!env && g_file_get_contents ("/etc/hildon/theme/.pro1x-theme",
+                                       &theme, NULL, NULL))
+        env = strchr (theme, '\n') ? strchr (theme, '\n') + 1 : NULL;
+      scale = env ? g_ascii_strtod (env, NULL) : 1;
+      if (!(scale >= 0.5 && scale <= 8))
+        scale = 1;
+      g_free (theme);
+    }
+
+  return scale;
+}
+
+#define HD_S(x) ((gint) floor ((x) * hd_scale () + 0.5))
+
+#endif
