+/* The MeeGo-like look: one row as high as the N9's status bar, black,
+ * across the screen as hildon-desktop places it then: the first special
+ * item (the signal) and the other icons on the left, the other special
+ * items (the battery) and the clock on the right */
+static void
+meego_layout (HDStatusArea *status_area)
+{
+  HDStatusAreaPrivate *priv = HD_STATUS_AREA_PRIVATE (status_area);
+  GtkWidget *w[HD_STATUS_AREA_NUM_SPECIAL_ITEMS + 2];
+  guint i, n = 0;
+
+  /* off their places */
+  w[n++] = priv->clock_box;
+  w[n++] = priv->icon_box;
+  for (i = 0; i < HD_STATUS_AREA_NUM_SPECIAL_ITEMS; i++)
+    if (priv->special_item_image[i])
+      w[n++] = priv->special_item_image[i];
+  for (i = 0; i < n; i++)
+    {
+      g_object_ref (w[i]);
+      if (gtk_widget_get_parent (w[i]))
+        gtk_container_remove (GTK_CONTAINER (gtk_widget_get_parent (w[i])),
+                              w[i]);
+    }
+
+  if (priv->meego)
+    {
+      gtk_widget_hide (priv->left_alignment);
+      if (priv->special_item_image[0])
+        gtk_box_pack_start (GTK_BOX (priv->main_hbox),
+                            priv->special_item_image[0], FALSE, FALSE,
+                            HD_S (HILDON_MARGIN_DEFAULT));
+      gtk_box_pack_start (GTK_BOX (priv->main_hbox), priv->icon_box,
+                          FALSE, FALSE, 0);
+      gtk_box_pack_end (GTK_BOX (priv->main_hbox), priv->clock_box,
+                        FALSE, FALSE, HD_S (HILDON_MARGIN_DEFAULT));
+      for (i = HD_STATUS_AREA_NUM_SPECIAL_ITEMS - 1; i > 0; i--)
+        if (priv->special_item_image[i])
+          gtk_box_pack_end (GTK_BOX (priv->main_hbox),
+                            priv->special_item_image[i], FALSE, FALSE,
+                            HD_S (HILDON_MARGIN_HALF));
+      gtk_alignment_set (GTK_ALIGNMENT (priv->main_alignment),
+                         0.5, 0.5, 1.0, 0.0);
+    }
+  else
+    {
+      gtk_widget_show (priv->left_alignment);
+      gtk_box_pack_start (GTK_BOX (priv->left_hbox), priv->clock_box,
+                          FALSE, FALSE, 0);
+      gtk_box_reorder_child (GTK_BOX (priv->left_hbox), priv->clock_box, 0);
+      for (i = 0; i < HD_STATUS_AREA_NUM_SPECIAL_ITEMS; i++)
+        if (priv->special_item_image[i])
+          gtk_box_pack_start (GTK_BOX (priv->special_hbox),
+                              priv->special_item_image[i], FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (priv->main_hbox), priv->icon_box,
+                          TRUE, TRUE, 0);
+      gtk_alignment_set (GTK_ALIGNMENT (priv->main_alignment),
+                         0.5, 0.5, 0.0, 0.0);
+    }
+  for (i = 0; i < n; i++)
+    g_object_unref (w[i]);
+
+  hd_status_area_box_set_one_row (HD_STATUS_AREA_BOX (priv->icon_box),
+                                  priv->meego);
+  gtk_widget_set_size_request (GTK_WIDGET (status_area), -1,
+                               priv->meego ? MEEGO_BAR_HEIGHT
+                                           : STATUS_AREA_HEIGHT);
+  /* asked for anew: hildon-desktop gives it the look's place */
+  gtk_window_resize (GTK_WINDOW (status_area), 1,
+                     priv->meego ? MEEGO_BAR_HEIGHT : STATUS_AREA_HEIGHT);
+  gtk_widget_queue_draw (GTK_WIDGET (status_area));
+}
+
+static void
+meego_update (HDStatusArea *status_area)
+{
+  HDStatusAreaPrivate *priv = HD_STATUS_AREA_PRIVATE (status_area);
+  Display *dpy = GDK_DISPLAY_XDISPLAY (gdk_display_get_default ());
+  Atom type;
+  int format;
+  unsigned long n, after;
+  unsigned char *data = NULL;
+  gboolean meego = FALSE;
+
+  if (XGetWindowProperty (dpy, DefaultRootWindow (dpy), priv->meego_atom,
+                          0, 1, False, XA_CARDINAL, &type, &format, &n,
+                          &after, &data) == Success && data)
+    {
+      meego = n == 1 && format == 32 && *(long *) data != 0;
+      XFree (data);
+    }
+  if (meego != priv->meego)
+    {
+      priv->meego = meego;
+      meego_layout (status_area);
+    }
+}
+
+static GdkFilterReturn
+meego_root_filter (GdkXEvent *xevent,
+                   GdkEvent  *event,
+                   gpointer   data)
+{
+  XEvent *xev = xevent;
+  HDStatusAreaPrivate *priv = HD_STATUS_AREA_PRIVATE (data);
+
+  if (xev->type == PropertyNotify && xev->xproperty.atom == priv->meego_atom)
+    meego_update (HD_STATUS_AREA (data));
+
+  return GDK_FILTER_CONTINUE;
+}
+
+static void
+meego_watch (HDStatusArea *status_area)
+{
+  HDStatusAreaPrivate *priv = HD_STATUS_AREA_PRIVATE (status_area);
+  GdkWindow *root = gdk_get_default_root_window ();
+
+  priv->meego_atom = gdk_x11_get_xatom_by_name ("_HILDON_MEEGO_LOOK");
+  gdk_window_set_events (root, gdk_window_get_events (root)
+                               | GDK_PROPERTY_CHANGE_MASK);
+  gdk_window_add_filter (root, meego_root_filter, status_area);
+  meego_update (status_area);
+}
