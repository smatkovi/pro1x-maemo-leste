+      if (geom.y < 0)
+        geom.y = -geom.height;
+    }
+
+  client->frame_geometry.x = geom.x;
+  client->frame_geometry.y = geom.y;
+  client->frame_geometry.width  = geom.width;
+  client->frame_geometry.height = geom.height;
+  client->window->geometry.x = geom.x;
+  client->window->geometry.y = geom.y;
+  client->window->geometry.width  = geom.width;
+  client->window->geometry.height = geom.height;
 
   mb_wm_client_geometry_mark_dirty (client);
 
   return True; /* Geometry accepted */
 }
 
+/* Its place for the current look and orientation (hd-meego.c) */
+void
+hd_status_area_update_geometry (MBWindowManagerClient *client)
+{
+  MBGeometry geom = client->frame_geometry;
+
+  hd_status_area_request_geometry (client, &geom, MBWMClientReqGeomForced);
+  mb_wm_comp_mgr_client_configure (client->cm_client);
+}
