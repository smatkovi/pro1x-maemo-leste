+   * page): the drags along the pages go to it (hd-home.c) */
+  settings = hd_util_get_win_prop_data_and_validate (wm->xdpy,
+                                                     win->xwindow,
+                                                     XInternAtom (wm->xdpy,
+                                                                  "_HILDON_MEEGO_SCROLLING_APPLET",
+                                                                  False),
+                                                     XA_CARDINAL,
+                                                     32,
+                                                     1,
+                                                     &n_items);
+  if (settings)
+    {
+      applet->meego_scrolls = *settings != 0;
+      XFree (settings);
+    }
   else
     {
       applet->settings = False;
