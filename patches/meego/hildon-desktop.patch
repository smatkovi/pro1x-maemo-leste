+/* The states with the status area; in the MeeGo-like look also the launcher
+ * and the task navigator, as the N9's status bar is over its Applications
+ * and Open applications (hd-meego.c) */
+static gboolean
+hd_render_manager_state_shows_status_area (HDRMStateEnum state)
+{
+  return STATE_SHOW_STATUS_AREA (state)
+         || (hd_meego_pages_enabled () && STATE_TOOLBAR_FOREGROUND (state));
+}
+
+/* The status area's actor in the title bar, but over the launcher and the
+ * task navigator (which lie above the title bar) in the front group, in the
+ * MeeGo-like look */
+static void
+hd_render_manager_place_status_area (void)
+{
+  HdRenderManagerPrivate *priv = render_manager->priv;
+  ClutterActor *parent;
+
+  if (!priv->status_area)
+    return;
+  parent = hd_meego_pages_enabled () && STATE_TOOLBAR_FOREGROUND (priv->state)
+           ? CLUTTER_ACTOR (priv->front) : CLUTTER_ACTOR (priv->title_bar);
+  if (clutter_actor_get_parent (priv->status_area) != parent)
+    clutter_actor_reparent (priv->status_area, parent);
+  clutter_actor_raise_top (priv->status_area);
+}
