+/* A motion or the release of a drag that the applet takes itself (an
+ * applet that scrolls, hd-meego.c), with the time of the event, which its
+ * scrolling may follow */
+static void
+hd_home_applet_emit_motion_event (HdHome       *home,
+                                  ClutterActor *applet,
+                                  int           x,
+                                  int           y,
+                                  guint32       time,
+                                  int           type)
+{
+  HdHomePrivate      *priv = home->priv;
+  MBWindowManager    *wm;
+  MBWMCompMgrClient  *cclient;
+  XEvent              xev;
+  Window              root, win, child;
+  int                 wx, wy;
+
+  wm = MB_WM_COMP_MGR(priv->comp_mgr)->wm;
+  cclient = g_object_get_data (G_OBJECT (applet),
+                               "HD-MBWMCompMgrClutterClient");
+  if (!cclient || !cclient->wm_client)
+    return;
+  root = wm->root_win->xwindow;
+  win = MB_WM_CLIENT_XWIN (cclient->wm_client);
+
+  /* the window inside the applet there */
+  XTranslateCoordinates (wm->xdpy, root, win, x, y, &wx, &wy, &child);
+  while (child)
+    {
+      win = child;
+      XTranslateCoordinates (wm->xdpy, root, win, x, y, &wx, &wy, &child);
+    }
+
+  memset (&xev, 0, sizeof (xev));
+  if (type == MotionNotify)
+    {
+      xev.xmotion.type = MotionNotify;
+      xev.xmotion.display = wm->xdpy;
+      xev.xmotion.window = win;
+      xev.xmotion.root = root;
+      xev.xmotion.time = time;
+      xev.xmotion.x = wx;
+      xev.xmotion.y = wy;
+      xev.xmotion.x_root = x;
+      xev.xmotion.y_root = y;
+      xev.xmotion.state = Button1Mask;
+      xev.xmotion.is_hint = NotifyNormal;
+      xev.xmotion.same_screen = True;
+    }
+  else
+    {
+      xev.xbutton.type = ButtonRelease;
+      xev.xbutton.display = wm->xdpy;
+      xev.xbutton.window = win;
+      xev.xbutton.root = root;
+      xev.xbutton.time = time;
+      xev.xbutton.x = wx;
+      xev.xbutton.y = wy;
+      xev.xbutton.x_root = x;
+      xev.xbutton.y_root = y;
+      xev.xbutton.state = Button1Mask;
+      xev.xbutton.button = Button1;
+      xev.xbutton.same_screen = True;
+    }
+  XSendEvent (wm->xdpy, win, True, 0, &xev);
+}
