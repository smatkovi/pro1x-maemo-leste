+ * shape kept. */
+static void
+calc_meego_layout (Layout * lout)
+{
+  GtkRequisition *size = &Meego_thumbsizes[IS_PORTRAIT];
+  gint side = IS_PORTRAIT ? HD_S (14) : HD_S (30);
+  gint top  = IS_PORTRAIT ? HD_S (24) : HD_S (30);
+  gint gap  = IS_PORTRAIT ? HD_S (20) : HD_S (24);
+  /* the applications' area, as layout_thumbs() scales it */
+  gint appw = IS_PORTRAIT ? App_window_geometry_height + HD_COMP_MGR_TOP_MARGIN
+                          : App_window_geometry_width;
+  gint apph = IS_PORTRAIT ? App_window_geometry_width - HD_COMP_MGR_TOP_MARGIN
+                          : App_window_geometry_height;
+
+  size->width = (DESKTOP_WIDTH - 2 * side - gap) / 2;
+  size->height = (size->width - 2 * FRAME_WIDTH) * apph / appw
+                 + FRAME_TOP_HEIGHT + FRAME_BOTTOM_HEIGHT;
+  lout->thumbsize = size;
+  lout->cells_per_row = 2;
+  lout->xpos = lout->last_row_xpos = side;
+  lout->ypos = HD_MEEGO_BAR_HEIGHT + top;
+  lout->hspace = size->width + gap;
+  lout->vspace = size->height + gap;
