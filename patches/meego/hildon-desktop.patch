diff --git a/src/util/hd-meego.c b/src/util/hd-meego.c
new file mode 100644
index 0000000..b21bb2a
--- /dev/null
+++ b/src/util/hd-meego.c
@@ -0,0 +1,718 @@
+/*
+ * MeeGo-like home: the home views (Hildon's desktops, up to four), the
+ * launcher and the task navigator as pages side by side in a ring,
+ * changed by a horizontal swipe, like the Nokia N9's Events, Applications
+ * and Open applications; the buttons in the top left corner go. Past the
+ * last home view comes the launcher, then the task navigator (when
+ * applications are open), then the first home view again. On while the
+ * GConf key /apps/osso/hildon-desktop/meego_pages is true.
+ *
+ * The swipe is seen in the X events themselves (hd_clutter_x11_event_filter),
+ * before Clutter: the launcher's and the task navigator's scrollers grab
+ * the pointer, so their actors would not see a drag that started on them.
+ * The thresholds are those of Harmattan's home screen (meegotouchhome,
+ * PagedPanning): a page changes after a third of the screen, or after a
+ * quicker flick of a tenth.
+ *
+ * In an application, swipes from the screen's edges as on the N9: from the
+ * left or right edge inwards to the open applications, from the top edge
+ * down to close it; a tap on the top edge opens its menu. Thin input-only
+ * windows along those edges catch them, above the application, only while
+ * one is in front.
+ *
+ * Applications have no title bar: the status area lies across the top as
+ * the N9's thin status bar (hildon-status-menu draws it so while the root
+ * window has _HILDON_MEEGO_LOOK, which libhildon's menus and pickers follow
+ * too), the applications' windows begin below it. The top edge is then
+ * the left half of that bar: a tap there opens the application's menu, a
+ * swipe down from it closes the application; the right half, with the
+ * battery and the clock, opens the status menu. The launcher's icons get
+ * the N9's shape: the N9's own icon where its theme is installed and has
+ * one for the application, else the application's icon in the N9's
+ * rounded square.
+ */
+
+#include <math.h>
+#include <string.h>
+#include <gconf/gconf-client.h>
+#include <glib.h>
+
+#include <X11/Xatom.h>
+#include <X11/Xutil.h>
+#include <matchbox/core/mb-wm.h>
+#include <matchbox/theme-engines/mb-wm-theme-xml.h>
+
+#include "hd-meego.h"
+#include "hd-comp-mgr.h"
+#include "hd-home.h"
+#include "hd-wm.h"
+#include "hd-render-manager.h"
+#include "hd-task-navigator.h"
+#include "launcher/hd-launcher.h"
+#include "launcher/hd-launcher-tree.h"
+#include "hd-util.h"
+
+#define GCONF_KEY_MEEGO_PAGES "/apps/osso/hildon-desktop/meego_pages"
+
+/* A swipe: horizontal (twice as far across as down) and either a third of
+ * the screen or a tenth within 300 ms */
+#define SWIPE_SLOW_FRACTION   3
+#define SWIPE_FAST_FRACTION   10
+#define SWIPE_FAST_MS         300
+#define SWIPE_MAX_MS          1500
+
+static gboolean enabled;
+static gboolean pressed;
+static int press_x, press_y;
+static Time press_time;
+
+/* Edge swipes in applications */
+enum edge { EDGE_LEFT, EDGE_RIGHT, EDGE_TOP, N_EDGES };
+/* a strip of 1.5 % of the screen's width (32 px at 2160) */
+#define EDGE_FRACTION       66
+/* a swipe goes a tenth of the screen in, a tap less than 2 % */
+#define EDGE_SWIPE_FRACTION 10
+#define EDGE_TAP_FRACTION   50
+static Window edges[N_EDGES];
+static gboolean edges_shown;
+static int edge_pressed = -1;
+
+extern MBWindowManager *hd_mb_wm;
+
+static void edges_update (void);
+
+/* The root window's _HILDON_MEEGO_LOOK (1) while the look is on */
+static void
+root_property_update (void)
+{
+  Display *dpy;
+  Window root;
+  Atom atom;
+  long on = 1;
+
+  if (!hd_mb_wm)
+    return;
+  dpy = hd_mb_wm->xdpy;
+  root = hd_mb_wm->root_win->xwindow;
+  atom = XInternAtom (dpy, "_HILDON_MEEGO_LOOK", False);
+  if (enabled)
+    XChangeProperty (dpy, root, atom, XA_CARDINAL, 32, PropModeReplace,
+                     (unsigned char *) &on, 1);
+  else
+    XDeleteProperty (dpy, root, atom);
+}
+
+/* The theme's north decor of applications (Hildon's title bar) as high as
+ * the status bar while the look is on, the theme's own height else. A new
+ * theme (the user chose another) brings its own height. */
+static MBWMTheme *decor_theme;
+static int decor_north;
+
+static void
+app_decor_update (void)
+{
+  MBWindowManagerClient *c;
+  MBWMXmlClient *xc;
+  MBWMXmlDecor *d;
+  int want;
+
+  if (!hd_mb_wm || !hd_mb_wm->theme)
+    return;
+  xc = mb_wm_xml_client_find_by_type (hd_mb_wm->theme->xml_clients,
+                                      MBWMClientTypeApp);
+  d = xc ? mb_wm_xml_decor_find_by_type (xc->decors, MBWMDecorTypeNorth)
+         : NULL;
+  if (!d)
+    return;
+  if (hd_mb_wm->theme != decor_theme)
+    {
+      decor_theme = hd_mb_wm->theme;
+      decor_north = d->height;
+    }
+  want = enabled ? HD_MEEGO_BAR_HEIGHT : decor_north;
+  if (d->height == want)
+    return;
+  d->height = want;
+  /* the applications' decors anew and the applications laid out again, as
+   * after a change of the theme */
+  mb_wm_stack_enumerate (hd_mb_wm, c)
+    if (MB_WM_CLIENT_CLIENT_TYPE (c) == MBWMClientTypeApp)
+      mb_wm_client_theme_change (c);
+  mb_wm_display_sync_queue (hd_mb_wm, MBWMSyncGeometry | MBWMSyncVisibility
+                                      | MBWMSyncDecor);
+}
+
+static void
+meego_pages_changed (GConfClient *client, guint id, GConfEntry *entry,
+                     gpointer data)
+{
+  gboolean on = gconf_client_get_bool (client, GCONF_KEY_MEEGO_PAGES, NULL);
+
+  if (on != enabled)
+    {
+      enabled = on;
+      root_property_update ();
+      app_decor_update ();
+      edges_update ();
+      /* the top left buttons come and go with the pages, the title bar
+       * and the status area's place with the look */
+      hd_render_manager_set_state (hd_render_manager_get_state ());
+      hd_render_manager_restack ();
+      hd_render_manager_place_titlebar_elements ();
+      /* the launcher's icons in the other shape */
+      hd_launcher_tree_refresh (hd_launcher_get_tree ());
+    }
+}
+
+void
+hd_meego_init (void)
+{
+  GConfClient *client = gconf_client_get_default ();
+
+  enabled = gconf_client_get_bool (client, GCONF_KEY_MEEGO_PAGES, NULL);
+  gconf_client_add_dir (client, "/apps/osso/hildon-desktop",
+                        GCONF_CLIENT_PRELOAD_NONE, NULL);
+  gconf_client_notify_add (client, GCONF_KEY_MEEGO_PAGES,
+                           meego_pages_changed, NULL, NULL, NULL);
+  root_property_update ();
+}
+
+static void
+edges_place (void)
+{
+  Display *dpy = hd_mb_wm->xdpy;
+  int w = hd_util_display_width (), h = hd_util_display_height ();
+  HDRMStateEnum state = hd_render_manager_get_state ();
+  int sw, sh, strip;
+
+  sw = STATE_IS_PORTRAIT (state) ? h : w;
+  sh = STATE_IS_PORTRAIT (state) ? w : h;
+  strip = MAX (8, MAX (sw, sh) / EDGE_FRACTION);
+  /* the top edge: the left half of the status bar (the right one opens
+   * the status menu) */
+  XMoveResizeWindow (dpy, edges[EDGE_LEFT], 0, HD_MEEGO_BAR_HEIGHT,
+                     strip, sh - HD_MEEGO_BAR_HEIGHT);
+  XMoveResizeWindow (dpy, edges[EDGE_RIGHT], sw - strip, HD_MEEGO_BAR_HEIGHT,
+                     strip, sh - HD_MEEGO_BAR_HEIGHT);
+  XMoveResizeWindow (dpy, edges[EDGE_TOP], 0, 0, sw / 2, HD_MEEGO_BAR_HEIGHT);
+}
+
+static void
+edges_create (void)
+{
+  Display *dpy = hd_mb_wm->xdpy;
+  XSetWindowAttributes a;
+  int i;
+
+  a.override_redirect = True;
+  a.event_mask = ButtonPressMask | ButtonReleaseMask;
+  for (i = 0; i < N_EDGES; i++)
+    {
+      edges[i] = XCreateWindow (dpy, hd_mb_wm->root_win->xwindow, 0, 0, 1, 1,
+                                0, 0, InputOnly, CopyFromParent,
+                                CWOverrideRedirect | CWEventMask, &a);
+      XStoreName (dpy, edges[i], "hildon-desktop meego edge");
+    }
+}
+
+/* The edges above the application in front, only then */
+static void
+edges_update (void)
+{
+  gboolean show = enabled && STATE_IS_APP (hd_render_manager_get_state ())
+    && !STATE_ONE_OF (hd_render_manager_get_state (),
+                      HDRM_STATE_NON_COMPOSITED | HDRM_STATE_NON_COMP_PORT)
+    && !hd_wm_has_modal_blockers (hd_mb_wm);
+  Display *dpy;
+  int i;
+
+  if (!hd_mb_wm)
+    return;
+  dpy = hd_mb_wm->xdpy;
+  if (show && !edges[0])
+    edges_create ();
+  if (!edges[0])
+    return;
+  if (show)
+    {
+      edges_place ();
+      for (i = 0; i < N_EDGES; i++)
+        XMapRaised (dpy, edges[i]);
+    }
+  else if (edges_shown)
+    {
+      for (i = 0; i < N_EDGES; i++)
+        XUnmapWindow (dpy, edges[i]);
+      edge_pressed = -1;
+    }
+  edges_shown = show;
+}
+
+void
+hd_meego_state_changed (void)
+{
+  /* hildon-desktop's start: the window manager is there now */
+  static gboolean started;
+
+  if (!started && hd_mb_wm)
+    {
+      started = TRUE;
+      root_property_update ();
+    }
+  app_decor_update ();
+  edges_update ();
+}
+
+/* Open the menu of the application in front (as its title does) */
+static void
+app_menu (void)
+{
+  HdCompMgr *cmgr = HD_COMP_MGR (hd_mb_wm->comp_mgr);
+  HdCompMgrClient *client = hd_comp_mgr_get_current_client (cmgr);
+  MBWindowManagerClient *c;
+
+  if (!client)
+    return;
+  c = MB_WM_COMP_MGR_CLIENT (client)->wm_client;
+  mb_wm_client_deliver_message (c, hd_mb_wm->atoms[MBWM_ATOM_MB_GRAB_TRANSFER],
+                                CurrentTime, c->window->xwindow,
+                                hd_mb_wm->root_win->xwindow, 0, 0);
+  XSync (hd_mb_wm->xdpy, False);
+  XUngrabPointer (hd_mb_wm->xdpy, CurrentTime);
+}
+
+static gboolean
+edge_action (gpointer data)
+{
+  int action = GPOINTER_TO_INT (data);
+  HDRMStateEnum state = hd_render_manager_get_state ();
+  HdCompMgr *cmgr;
+  HdCompMgrClient *client;
+
+  if (!STATE_IS_APP (state))
+    return FALSE;
+  switch (action)
+    {
+    case EDGE_LEFT:
+    case EDGE_RIGHT:
+      /* to the open applications */
+      hd_render_manager_set_state (STATE_IS_PORTRAIT (state) ?
+                                   HDRM_STATE_TASK_NAV_PORTRAIT :
+                                   HDRM_STATE_TASK_NAV);
+      break;
+    case EDGE_TOP:
+      /* close it */
+      cmgr = HD_COMP_MGR (hd_mb_wm->comp_mgr);
+      client = hd_comp_mgr_get_current_client (cmgr);
+      if (client)
+        hd_comp_mgr_close_client (cmgr, &client->parent);
+      break;
+    default:
+      app_menu ();
+      break;
+    }
+  return FALSE;
+}
+
+static void
+edge_event (XEvent *xev)
+{
+  int i, dx, dy, sw, sh;
+
+  if (xev->type == ButtonPress)
+    {
+      for (i = 0; i < N_EDGES && edges[i] != xev->xbutton.window; i++)
+        ;
+      edge_pressed = i < N_EDGES ? i : -1;
+      press_x = xev->xbutton.x_root;
+      press_y = xev->xbutton.y_root;
+      press_time = xev->xbutton.time;
+      return;
+    }
+  if (edge_pressed < 0)
+    return;
+  /* the release goes to the window that had the press */
+  dx = xev->xbutton.x_root - press_x;
+  dy = xev->xbutton.y_root - press_y;
+  sw = STATE_IS_PORTRAIT (hd_render_manager_get_state ()) ?
+       hd_util_display_height () : hd_util_display_width ();
+  sh = STATE_IS_PORTRAIT (hd_render_manager_get_state ()) ?
+       hd_util_display_width () : hd_util_display_height ();
+  i = edge_pressed;
+  edge_pressed = -1;
+  if ((int) (xev->xbutton.time - press_time) > SWIPE_MAX_MS)
+    return;
+  if ((i == EDGE_LEFT && dx >= sw / EDGE_SWIPE_FRACTION && dx > 2 * ABS (dy)) ||
+      (i == EDGE_RIGHT && -dx >= sw / EDGE_SWIPE_FRACTION && -dx > 2 * ABS (dy)) ||
+      (i == EDGE_TOP && dy >= sh / EDGE_SWIPE_FRACTION && dy > 2 * ABS (dx)))
+    g_idle_add (edge_action, GINT_TO_POINTER (i));
+  else if (i == EDGE_TOP && ABS (dx) < sw / EDGE_TAP_FRACTION &&
+           ABS (dy) < sh / EDGE_TAP_FRACTION)
+    g_idle_add (edge_action, GINT_TO_POINTER (N_EDGES));
+}
+
+gboolean
+hd_meego_pages_enabled (void)
+{
+  return enabled;
+}
+
+/* The pages in their order; @dir +1 is the one to the right */
+static HDRMStateEnum
+next_page (HDRMStateEnum state, int dir)
+{
+  gboolean portrait = STATE_IS_PORTRAIT (state);
+  HDRMStateEnum pages[3];
+  int i, n;
+
+  pages[0] = portrait ? HDRM_STATE_HOME_PORTRAIT : HDRM_STATE_HOME;
+  pages[1] = portrait ? HDRM_STATE_LAUNCHER_PORTRAIT : HDRM_STATE_LAUNCHER;
+  pages[2] = portrait ? HDRM_STATE_TASK_NAV_PORTRAIT : HDRM_STATE_TASK_NAV;
+
+  for (i = 0; i < 3 && pages[i] != state; i++)
+    ;
+  if (i == 3)
+    return HDRM_STATE_UNDEFINED;
+
+  for (n = 0; n < 2; n++)
+    {
+      i = (i + dir + 3) % 3;
+      /* no open applications: nothing to show on that page */
+      if (STATE_IS_TASK_NAV (pages[i]) && hd_task_navigator_is_empty ())
+        continue;
+      return pages[i];
+    }
+  return HDRM_STATE_UNDEFINED;
+}
+
+static gboolean
+change_page (gpointer data)
+{
+  int dir = GPOINTER_TO_INT (data);
+  HDRMStateEnum to = next_page (hd_render_manager_get_state (), dir);
+
+  if (to == HDRM_STATE_UNDEFINED)
+    return FALSE;
+  /* coming back to the home views from the right: the last of them */
+  if (STATE_IS_HOME (to))
+    hd_home_meego_show_end_view (hd_render_manager_get_home (), dir < 0);
+  hd_render_manager_set_state (to);
+  return FALSE;
+}
+
+void
+hd_meego_leave_home (int dir)
+{
+  g_idle_add (change_page, GINT_TO_POINTER (dir));
+}
+
+void
+hd_meego_x_event (XEvent *xev)
+{
+  HDRMStateEnum state;
+  int width, dx, dy, dt;
+
+  if (!enabled)
+    return;
+  /* windows mapped or restacked above the edges: the edges on top again
+   * (the window the event is about, not the root that reports it; raising
+   * the edges reports them, which must not raise them again) */
+  if (edges_shown && (xev->type == MapNotify || xev->type == ConfigureNotify))
+    {
+      Window w = xev->type == MapNotify ? xev->xmap.window
+                                        : xev->xconfigure.window;
+      int i;
+
+      if (w != edges[0] && w != edges[1] && w != edges[2])
+        for (i = 0; i < N_EDGES; i++)
+          XRaiseWindow (hd_mb_wm->xdpy, edges[i]);
+    }
+  if (xev->type != ButtonPress && xev->type != ButtonRelease)
+    return;
+  if (edges_shown && (edge_pressed >= 0 || (xev->type == ButtonPress &&
+      (xev->xbutton.window == edges[0] || xev->xbutton.window == edges[1] ||
+       xev->xbutton.window == edges[2]))))
+    {
+      edge_event (xev);
+      return;
+    }
+
+  /* the home views see their swipes themselves (hd-home.c) */
+  state = hd_render_manager_get_state ();
+  if (!STATE_IS_LAUNCHER (state) && !STATE_IS_TASK_NAV (state))
+    {
+      pressed = FALSE;
+      return;
+    }
+
+  if (xev->type == ButtonPress)
+    {
+      pressed = TRUE;
+      press_x = xev->xbutton.x_root;
+      press_y = xev->xbutton.y_root;
+      press_time = xev->xbutton.time;
+      return;
+    }
+
+  if (!pressed)
+    return;
+  pressed = FALSE;
+
+  dx = xev->xbutton.x_root - press_x;
+  dy = xev->xbutton.y_root - press_y;
+  dt = (int) (xev->xbutton.time - press_time);
+  width = STATE_IS_PORTRAIT (state) ? hd_util_display_height ()
+                                    : hd_util_display_width ();
+  if (ABS (dx) < 2 * ABS (dy) || dt > SWIPE_MAX_MS)
+    return;
+  if (ABS (dx) < width / SWIPE_SLOW_FRACTION
+      && !(ABS (dx) >= width / SWIPE_FAST_FRACTION && dt <= SWIPE_FAST_MS))
+    return;
+
+  /* After this release has gone through Clutter: the finger moving left
+   * brings the page on the right */
+  g_idle_add (change_page, GINT_TO_POINTER (dx < 0 ? 1 : -1));
+}
+
+/* The status bar over the launcher and the task navigator: Hildon shows the
+ * status menu over Home, so a menu opened from them goes back there when it
+ * closes (unless something else, a dialog, came meanwhile) */
+static HDRMStateEnum menu_from = HDRM_STATE_UNDEFINED;
+
+void
+hd_meego_status_menu_opened (int state)
+{
+  menu_from = enabled ? (HDRMStateEnum) state : HDRM_STATE_UNDEFINED;
+}
+
+static gboolean
+menu_back (gpointer data)
+{
+  HDRMStateEnum to = GPOINTER_TO_INT (data), state = hd_render_manager_get_state ();
+  gboolean portrait = STATE_IS_PORTRAIT (state);
+
+  if (!enabled || !STATE_IS_HOME (state) || hd_wm_has_modal_blockers (hd_mb_wm))
+    return FALSE;
+  if (STATE_IS_LAUNCHER (to))
+    to = portrait ? HDRM_STATE_LAUNCHER_PORTRAIT : HDRM_STATE_LAUNCHER;
+  else if (STATE_IS_TASK_NAV (to) && !hd_task_navigator_is_empty ())
+    to = portrait ? HDRM_STATE_TASK_NAV_PORTRAIT : HDRM_STATE_TASK_NAV;
+  else
+    return FALSE;
+  hd_render_manager_set_state (to);
+  return FALSE;
+}
+
+void
+hd_meego_status_menu_closed (void)
+{
+  if (menu_from != HDRM_STATE_UNDEFINED)
+    g_idle_add (menu_back, GINT_TO_POINTER (menu_from));
+  menu_from = HDRM_STATE_UNDEFINED;
+}
+
+/* The launcher's icons in the N9's shape.
+ *
+ * The N9's own icons (its theme, blanco, is Nokia's and not part of this:
+ * used where it is installed) for the applications Hildon names by these
+ * icons; the others in the N9's rounded square, a superellipse
+ * |x|^n + |y|^n = 1 with n = 2.6 (as the outlines of the N9's icons are,
+ * 78 of their 80 pixels wide). */
+static const struct
+{
+  const char *hildon, *n9;
+} n9_icons[] = {
+  { "general_web", "icon-l-browser" },
+  { "general_email", "icon-l-email" },
+  { "general_sms", "icon-l-conversation" },
+  { "general_contacts", "icon-l-contacts" },
+  { "general_calendar", "icon-l-calendar" },
+  { "general_clock", "icon-l-clock" },
+  { "general_call", "icon-l-telephony" },
+  { "general_application_call", "icon-l-telephony" },
+  { "general_image_viewer", "icon-l-gallery" },
+  { "general_map", "icon-l-maps" },
+  { "general_mediaplayer", "icon-l-music" },
+  { "general_video_player", "icon-l-videos-tv" },
+  { "general_notes", "icon-l-notes" },
+  { "general_settings", "icon-l-settings" },
+  { "general_pdf", "icon-l-documents" },
+  { "general_rss", "icon-l-rss" },
+  { "tasklaunch_calculator", "icon-l-calculator" },
+  { "tasklaunch_camera", "icon-l-camera" },
+  { "tasklaunch_user_guide", "icon-l-user-guide" },
+  { "tasklaunch_default_application", "icon-l-default-application" },
+  { "terminal", "icon-l-terminal" },
+  { "firefox", "icon-l-firefox" },
+  { "firefox-esr", "icon-l-firefox" },
+  { "skype", "icon-l-skype" },
+  { "twitter", "icon-l-twitter" },
+  { "facebook", "icon-l-facebook" },
+};
+static const char *n9_icon_dirs[] = {
+  "/usr/share/themes/blanco/meegotouch/icons",
+  "/usr/local/share/themes/blanco/meegotouch/icons",
+};
+
+#define SQUIRCLE_N 2.6
+/* 4 x 4 samples a pixel */
+#define SQUIRCLE_SAMPLES 4
+/* an icon covering less than this of the shape (in 1/100) goes on a plate */
+#define SQUIRCLE_FULL 90
+/* the icon on a plate: 72 % of it, as the N9's own drawings in theirs */
+#define PLATE_ICON 72
+/* an icon lighter than this on average (0..255) on a dark plate */
+#define PLATE_LIGHT 190
+
+/* The shape's coverage of each pixel of a size x size icon (0..255), the
+ * N9's one pixel margin around it */
+static const guchar *
+squircle_mask (int size)
+{
+  static guchar *mask;
+  static int mask_size;
+  double r = size / 2.0 - 1, c = size / 2.0;
+  int x, y, i, j, n;
+
+  if (mask && mask_size == size)
+    return mask;
+  g_free (mask);
+  mask = g_malloc (size * size);
+  mask_size = size;
+  for (y = 0; y < size; y++)
+    for (x = 0; x < size; x++)
+      {
+        n = 0;
+        for (j = 0; j < SQUIRCLE_SAMPLES; j++)
+          for (i = 0; i < SQUIRCLE_SAMPLES; i++)
+            {
+              double px = fabs (x + (i + 0.5) / SQUIRCLE_SAMPLES - c) / r;
+              double py = fabs (y + (j + 0.5) / SQUIRCLE_SAMPLES - c) / r;
+
+              if (pow (px, SQUIRCLE_N) + pow (py, SQUIRCLE_N) <= 1)
+                n++;
+            }
+        mask[y * size + x] = n * 255 / (SQUIRCLE_SAMPLES * SQUIRCLE_SAMPLES);
+      }
+  return mask;
+}
+
+static GdkPixbuf *
+n9_icon (const gchar *icon_name, gint size)
+{
+  guint i, j;
+
+  if (!icon_name)
+    return NULL;
+  for (i = 0; i < G_N_ELEMENTS (n9_icons); i++)
+    if (!strcmp (n9_icons[i].hildon, icon_name))
+      for (j = 0; j < G_N_ELEMENTS (n9_icon_dirs); j++)
+        {
+          gchar *path = g_strdup_printf ("%s/%s.png", n9_icon_dirs[j],
+                                         n9_icons[i].n9);
+          GdkPixbuf *p = NULL;
+
+          if (g_file_test (path, G_FILE_TEST_EXISTS))
+            p = gdk_pixbuf_new_from_file_at_size (path, size, size, NULL);
+          g_free (path);
+          if (p)
+            return p;
+        }
+  return NULL;
+}
+
+/* The icon from @fname (or the N9's for @icon_name) at @size, in the N9's
+ * shape: an icon that (nearly) fills the square cut to the shape, any
+ * other on a light plate of that shape */
+GdkPixbuf *
+hd_meego_launcher_icon (const gchar *icon_name, const gchar *fname, gint size)
+{
+  GdkPixbuf *src, *out;
+  const guchar *mask;
+  guchar *s, *d;
+  int x, y, w, h, ss, ds, covered = 0, inside = 0;
+  long light = 0;
+
+  if ((out = n9_icon (icon_name, size)))
+    return out;
+  src = gdk_pixbuf_new_from_file_at_size (fname, size, size, NULL);
+  if (!src)
+    return NULL;
+  if (!gdk_pixbuf_get_has_alpha (src))
+    {
+      GdkPixbuf *a = gdk_pixbuf_add_alpha (src, FALSE, 0, 0, 0);
+
+      g_object_unref (src);
+      src = a;
+    }
+  w = gdk_pixbuf_get_width (src);
+  h = gdk_pixbuf_get_height (src);
+  mask = squircle_mask (size);
+
+  /* how much of the shape the icon covers, where it is in the square, and
+   * how light it is */
+  s = gdk_pixbuf_get_pixels (src);
+  ss = gdk_pixbuf_get_rowstride (src);
+  for (y = 0; y < size; y++)
+    for (x = 0; x < size; x++)
+      if (mask[y * size + x] == 255)
+        {
+          int sx = x - (size - w) / 2, sy = y - (size - h) / 2;
+
+          inside++;
+          if (sx >= 0 && sy >= 0 && sx < w && sy < h
+              && s[sy * ss + sx * 4 + 3] >= 200)
+            {
+              const guchar *p = s + sy * ss + sx * 4;
+
+              covered++;
+              light += (p[0] * 3 + p[1] * 6 + p[2]) / 10;
+            }
+        }
+
+  out = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, size, size);
+  d = gdk_pixbuf_get_pixels (out);
+  ds = gdk_pixbuf_get_rowstride (out);
+  if (covered * 100 >= inside * SQUIRCLE_FULL)
+    {
+      /* cut to the shape */
+      gdk_pixbuf_fill (out, 0);
+      gdk_pixbuf_copy_area (src, 0, 0, w, h, out, (size - w) / 2,
+                            (size - h) / 2);
+      for (y = 0; y < size; y++)
+        for (x = 0; x < size; x++)
+          d[y * ds + x * 4 + 3] = d[y * ds + x * 4 + 3]
+                                  * mask[y * size + x] / 255;
+    }
+  else
+    {
+      /* a plate, light grey getting darker downwards and at its rim (dark
+       * grey for a light icon, as the N9's settings and terminal), the
+       * icon smaller in its middle */
+      int iw = MAX (1, w * PLATE_ICON / 100), ih = MAX (1, h * PLATE_ICON / 100);
+      int top = covered && light / covered > PLATE_LIGHT ? 0x4a : 0xf2;
+
+      for (y = 0; y < size; y++)
+        for (x = 0; x < size; x++)
+          {
+            guchar *p = d + y * ds + x * 4;
+            int v = top - 0x26 * y / size;
+
+            /* a darker line along the edge: where the shape fades out */
+            if (mask[y * size + x] < 255 ||
+                (x > 0 && mask[y * size + x - 1] < 255) ||
+                (x < size - 1 && mask[y * size + x + 1] < 255) ||
+                (y > 0 && mask[(y - 1) * size + x] < 255) ||
+                (y < size - 1 && mask[(y + 1) * size + x] < 255))
+              v = MAX (0, v - 0x30);
+            p[0] = p[1] = p[2] = v;
+            p[3] = mask[y * size + x];
+          }
+      gdk_pixbuf_composite (src, out, (size - iw) / 2, (size - ih) / 2,
+                            iw, ih, (size - iw) / 2.0, (size - ih) / 2.0,
+                            (double) iw / w, (double) ih / h,
+                            GDK_INTERP_BILINEAR, 255);
+    }
+  g_object_unref (src);
+  return out;
+}
