+/**
+ * Display state filter: low power mode instead of off while in use and
+ * the system is in user state; no low power mode when not in use
+ *
+ * @param data The display state stored in a pointer
+ * @return The filtered display state stored in a pointer
+ */
+static gpointer display_state_filter(gpointer data)
+{
+	system_state_t system_state = datapipe_get_gint(system_state_pipe);
+	display_state_t display_state = GPOINTER_TO_INT(data);
+
+	if (lpm_usable() == false) {
+		if ((display_state == MCE_DISPLAY_LPM_OFF) ||
+		    (display_state == MCE_DISPLAY_LPM_ON))
+			display_state = MCE_DISPLAY_OFF;
+	} else if ((display_state == MCE_DISPLAY_OFF) &&
+		   (system_state == MCE_STATE_USER)) {
+		display_state = MCE_DISPLAY_LPM_ON;
+	}
+
+	return GINT_TO_POINTER(display_state);
+}
+
+/**
+ * Proximity in low power mode: covered for a while, blank; uncovered,
+ * the stand-by screen again
+ *
+ * @param data The proximity sensor state stored in a pointer
+ */
+static void proximity_sensor_trigger(gconstpointer data)
+{
+	display_state_t display_state = datapipe_get_gint(display_state_pipe);
+	cover_state_t proximity_sensor_state = GPOINTER_TO_INT(data);
+
+	if ((display_state == MCE_DISPLAY_LPM_ON) &&
+	    (proximity_sensor_state == COVER_CLOSED)) {
+		if (lpm_proximity_blank_timeout_cb_id == 0)
+			setup_lpm_proximity_blank_timeout();
+	} else {
+		cancel_lpm_proximity_blank_timeout();
+		if ((display_state == MCE_DISPLAY_LPM_OFF) &&
+		    (proximity_sensor_state == COVER_OPEN))
+			(void)execute_datapipe(&display_state_pipe,
+					       GINT_TO_POINTER(MCE_DISPLAY_LPM_ON),
+					       USE_INDATA, CACHE_INDATA);
+	}
+}
+
+/**
+ * rtconf callback for use_low_power_mode
+ */
+static void use_low_power_mode_cb(const gchar *key, guint cb_id, void *user_data)
+{
+	display_state_t display_state = datapipe_get_gint(display_state_pipe);
+	gboolean use = use_low_power_mode;
+
+	(void)key;
+	(void)cb_id;
+	(void)user_data;
+
+	if (mce_rtconf_get_bool(MCE_USE_LPM_KEY, &use) == FALSE)
+		return;
+	use_low_power_mode = use;
+	mce_log(LL_DEBUG, "%s: low power mode %s", MODULE_NAME,
+		use ? "on" : "off");
+
+	/* switched off while in low power mode, or on while off */
+	if (((display_state == MCE_DISPLAY_LPM_OFF) ||
+	     (display_state == MCE_DISPLAY_LPM_ON)) && (lpm_usable() == false))
+		(void)execute_datapipe(&display_state_pipe,
+				       GINT_TO_POINTER(MCE_DISPLAY_OFF),
+				       USE_INDATA, CACHE_INDATA);
+	else if ((display_state == MCE_DISPLAY_OFF) && (lpm_usable() == true))
+		(void)execute_datapipe(&display_state_pipe,
+				       GINT_TO_POINTER(MCE_DISPLAY_LPM_ON),
+				       USE_INDATA, CACHE_INDATA);
+}
+
+/**
+ * The panel's low power mode switch, next to the backlight's brightness
+ */
+static void find_low_power_mode_file(void)
+{
+	gchar *dir, *file;
+
+	if (brightness_file == NULL)
+		return;
+	dir = g_path_get_dirname(brightness_file);
+	file = g_strconcat(dir, DISPLAY_GENERIC_LPM_FILE, NULL);
+	g_free(dir);
+	if (g_access(file, W_OK) == 0) {
+		low_power_mode_file = file;
+		mce_log(LL_DEBUG, "%s: low power mode through %s", MODULE_NAME,
+			file);
+	} else {
+		g_free(file);
+	}
+}
