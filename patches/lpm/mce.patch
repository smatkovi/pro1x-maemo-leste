+	cancel_lpm_blank_timeout();
+	if (disp_lpm_blank_timeout > 0)
+		lpm_blank_timeout_cb_id =
+			g_timeout_add_seconds(disp_lpm_blank_timeout,
+					      lpm_blank_timeout_cb, NULL);
+}
+
+static void cancel_lpm_proximity_blank_timeout(void)
