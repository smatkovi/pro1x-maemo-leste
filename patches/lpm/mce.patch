Low power mode for the display, ported from Harmattan's mce 1.11.20 (pro1x-maemo-leste
patches/lpm): MCE_DISPLAY_LPM_ON/LPM_OFF, the panel's sysfs "lpm", proximity,
display_status_ind "lpm" for a stand-by screen client. Off by default.

diff --git a/config/mce.ini b/config/mce.ini
index 7fbad5a..7976bc9 100644
--- a/config/mce.ini
+++ b/config/mce.ini
@@ -338,6 +338,17 @@ DimToBlankTimeout=5
 # If this is set the display is blanked during shutdown and reboot
 BlankDuringShutdown=1
 
+# Low power mode: instead of blanking, the panel keeps showing a stand-by
+# screen in its own low power mode (sysfs file "lpm" next to the
+# backlight's, as on the Nokia N9), at LowPowerModeBrightness percent;
+# display_status_ind says "lpm" for a client to draw the screen. Covered
+# (proximity) for 5 seconds, or after LowPowerModeBlankTimeout seconds
+# (0: never), it blanks. Can be switched at run time with
+# /system/osso/dsm/display/use_low_power_mode.
+UseLowPowerMode=0
+LowPowerModeBlankTimeout=0
+LowPowerModeBrightness=10
+
 [DisplayBrightness]
 
 # Brightness in percent used uring the dim phase before display blank
