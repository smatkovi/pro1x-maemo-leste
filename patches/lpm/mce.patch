+static void cancel_lpm_blank_timeout(void)
+{
+	if (lpm_blank_timeout_cb_id != 0) {
+		g_source_remove(lpm_blank_timeout_cb_id);
+		lpm_blank_timeout_cb_id = 0;
+	}
