+	lpm_blank_timeout_cb_id = 0;
+	(void)execute_datapipe(&display_state_pipe,
+			       GINT_TO_POINTER(MCE_DISPLAY_LPM_OFF),
+			       USE_INDATA, CACHE_INDATA);
+
+	return false;
+}
