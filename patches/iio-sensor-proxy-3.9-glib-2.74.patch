diff --git a/src/pro1x-glib-compat.h b/src/pro1x-glib-compat.h
new file mode 100644
--- /dev/null
+++ b/src/pro1x-glib-compat.h
@@ -0,0 +1,7 @@
+/* GLib 2.76 added g_autofd; Debian bookworm / Devuan daedalus ship 2.74. */
+#include <glib.h>
+#include <unistd.h>
+#if !GLIB_CHECK_VERSION(2, 76, 0)
+static inline void pro1x_autofd_close (int *fd) { if (*fd >= 0) { close (*fd); *fd = -1; } }
+#define g_autofd __attribute__((cleanup(pro1x_autofd_close)))
+#endif
