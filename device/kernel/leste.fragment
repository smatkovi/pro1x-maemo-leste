# Kernel options Maemo Leste needs on top of the NixOS port's config.
# Merged by scripts/30-build-kernel.sh after config.aarch64.

# CAL: Maemo keeps the device lock code and other settings in a CAL area,
# which libcal reads from /dev/mtd1. The Pro1X has no NAND, so a small file on
# userdata is attached as an MTD device through block2mtd (see
# /etc/init.d/pro1x-cal). The /dev/mtdN character devices need no option any
# more: mtdchar is part of the MTD core since MTD_CHAR was dropped.
CONFIG_MTD_BLOCK2MTD=m

# Kernel log of a crashed or watchdog-reset boot in /sys/fs/pstore. Built in so
# it already captures early boot; the region comes from the ramoops node in
# the device tree (patches/0001-leste-status-leds-and-ramoops.patch).
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Power, checked against the Nokia N9 (docs/power-management.md):
# RCU callbacks of idle CPUs batched by offload threads (lazy RCU) instead
# of waking the CPU for each grace period;
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
# transparent huge pages only where asked for (khugepaged otherwise scans
# every 10 s);
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# the LED trigger for hardware patterns (the PMI632's LPG runs a blink
# pattern itself, as the N9's LP5523 engines did, instead of mce toggling
# it from a timer)
CONFIG_LEDS_TRIGGER_PATTERN=y

# FM radio: the WCN3950's FM receiver as /dev/radio0, controlled over the
# Bluetooth UART (patches 0014, 0015)
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_RADIO_ADAPTERS=m
CONFIG_RADIO_QCA_FM=m

# FM audio: the WCN3950's SLIMbus interface on the LPASS SLIMbus
# (patches 0018-0021)
CONFIG_SLIMBUS=m
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_SND_SOC_WCN399X=m

# Wake-up audit (tools/pro1x-wakeups): the trace events of interrupts,
# timers, work items, task wake-ups and IPIs (with the IPI's call site), to
# tell what wakes an idle phone. Tracepoints only, no function tracer
# (no patched function entries); switched off they cost nothing.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# CONFIG_FUNCTION_TRACER is not set
