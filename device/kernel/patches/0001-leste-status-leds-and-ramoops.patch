-
-		led@1 {
-			reg = <1>;
-			color = <LED_COLOR_ID_RED>;
-		};
+	led@2 {
+		reg = <2>;
+		color = <LED_COLOR_ID_GREEN>;
+		function = LED_FUNCTION_STATUS;
+	};
 
-		led@2 {
-			reg = <2>;
-			color = <LED_COLOR_ID_GREEN>;
-		};
+	led@3 {
+		reg = <3>;
+		color = <LED_COLOR_ID_BLUE>;
+		function = LED_FUNCTION_STATUS;
+	};
+};
 
-		led@3 {
-			reg = <3>;
-			color = <LED_COLOR_ID_BLUE>;
-		};
+&reserved_memory {
+	/*
+	 * Kernel log of the previous boot in /sys/fs/pstore after a crash or a
+	 * watchdog reset. Same place as on the Lenovo J606F (also SM6115, same
+	 * ABL family), which the bootloader leaves alone across a warm reset.
+	 */
+	ramoops@ffc00000 {
+		compatible = "ramoops";
+		reg = <0x0 0xffc00000 0x0 0x100000>;
+		record-size = <0x1000>;
+		console-size = <0x40000>;
+		pmsg-size = <0x20000>;
+		ecc-size = <16>;
 	};
 };
 
