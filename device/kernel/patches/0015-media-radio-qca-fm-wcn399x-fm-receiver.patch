Subject: [PATCH] media: radio: add the Qualcomm WCN399x FM receiver

A V4L2 radio device for the FM receiver of the WCN399x, which hci_qca
carries over the Bluetooth UART (include/media/drv-intf/qca-fm.h). The
commands are Qualcomm's FM HCI set, the one radio-iris drives on WCNSS
parts: enable, receiver configuration (87.5-108 MHz, 100 kHz steps, RDS,
de-emphasis 50 or 75 us), stereo/mono, mute, tune (kHz), station
parameters (RSSI, stereo, RDS sync), seek, and the chip's own RDS
decoding of the programme service name and radio text, which become the
RDS controls. Commands go one at a time, each finished by a Command
Complete or Command Status event.

The receiver is switched on with the first open and off with the last
close; it brings the Bluetooth controller up for that if it is down.
The audio is not on this path: the chip sends it over SLIMbus
(FM_ENABLE_SLIMBUS), to the DSP.

Hooked up in the F(x)tec Pro1X device tree (WCN3950).

diff --git a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
index 07106fd57f..e043b46d2c 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
@@ -1428,6 +1428,11 @@ bluetooth {
 		 * 02:50:31:e8:00:03, written least significant byte first.
 		 */
 		local-bd-address = [03 00 e8 31 50 02];
+
+		/* The chip's FM receiver, driven over the same UART */
+		fm {
+			compatible = "qcom,wcn3950-fm";
+		};
 	};
 };
 
diff --git a/drivers/media/radio/Kconfig b/drivers/media/radio/Kconfig
index bbbdd054ba..65f45506fd 100644
--- a/drivers/media/radio/Kconfig
+++ b/drivers/media/radio/Kconfig
@@ -76,6 +76,18 @@ config RADIO_SHARK2
 	  To compile this driver as a module, choose M here: the
 	  module will be called radio-shark2.
 
+config RADIO_QCA_FM
+	tristate "Qualcomm WCN399x FM receiver"
+	depends on BT_HCIUART && BT_HCIUART_QCA && OF
+	help
+	  Choose Y here for the FM receiver in Qualcomm's WCN399x Bluetooth
+	  chips (the WCN3950 of the F(x)tec Pro1X), which is controlled over
+	  the Bluetooth UART. It tunes, seeks and reports the signal and RDS
+	  station name and text; the audio comes from the chip over SLIMbus.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called radio-qca-fm.
+
 config RADIO_SI4713
 	tristate "Silicon Labs Si4713 FM Radio with RDS Transmitter support"
 
