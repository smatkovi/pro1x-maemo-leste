Subject: [PATCH] phy: qcom-qmp-ufs: drop the UFS reset on exit; ufs-qcom: balance the PHY init

On PHYs without a PCS software reset (no_pcs_sw_reset), the first init
takes the "ufsphy" reset, which the UFS host controller (ufs-qcom)
provides as a reset controller of its own, and keeps it for good. When
the host is unbound, its reset controller is unregistered, and since the
reset core revokes the controls of a removed controller, the kept one
fails with -ENODEV from then on. Binding the host again then ends in

  ufshcd-qcom 4804000.ufshc: Failed to calibrate PHY: -19
  ufshcd-qcom 4804000.ufshc: Host controller enable failed

and UFS stays down. The Pro1X's boot menu does this every time it starts
FreeBSD (the host rebound with an identity IOMMU domain before kexec).

- qcom-qmp-ufs: take the reset without devm and put it in a new exit
  callback, so that the next init gets the reset of the host bound by
  then.
- ufs-qcom: every power-up sequence (each host reset) calls phy_init()
  without a phy_exit() for the one before, so the PHY's init count grows
  and the phy_exit() at removal never reaches the exit callback. End the
  earlier init first, as the power count is already handled there.

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
index b87314c837..0cde0e71d9 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -2032,7 +2032,7 @@ static int qmp_ufs_phy_init(struct phy *phy)
 	 */
 	if (!qmp->ufs_reset) {
 		qmp->ufs_reset =
-			devm_reset_control_get_exclusive(qmp->dev, "ufsphy");
+			reset_control_get_exclusive(qmp->dev, "ufsphy");
 
 		if (IS_ERR(qmp->ufs_reset)) {
 			ret = PTR_ERR(qmp->ufs_reset);
@@ -2045,8 +2045,25 @@ static int qmp_ufs_phy_init(struct phy *phy)
 	return 0;
 }
 
+static int qmp_ufs_phy_exit(struct phy *phy)
+{
+	struct qmp_ufs *qmp = phy_get_drvdata(phy);
+
+	/*
+	 * The UFS reset is provided by the UFS host controller, whose reset
+	 * controller goes away when the host is unbound: a reset control
+	 * kept from then on fails with -ENODEV. Drop it, so that the next
+	 * init takes the one of the host bound by then.
+	 */
+	reset_control_put(qmp->ufs_reset);
+	qmp->ufs_reset = NULL;
+
+	return 0;
+}
+
 static const struct phy_ops qcom_qmp_ufs_phy_ops = {
 	.init		= qmp_ufs_phy_init,
+	.exit		= qmp_ufs_phy_exit,
 	.power_on	= qmp_ufs_power_on,
 	.power_off	= qmp_ufs_power_off,
 	.calibrate	= qmp_ufs_phy_calibrate,
diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 9c0973a7ff..c4686440c1 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -511,6 +511,12 @@ static int ufs_qcom_power_up_sequence(struct ufs_hba *hba)
 	if (phy->power_count)
 		phy_power_off(phy);
 
+	/*
+	 * Every power-up initialises the PHY: end the init of the one before,
+	 * so that the phy_exit() at removal really exits it.
+	 */
+	if (phy->init_count)
+		phy_exit(phy);
 
 	/* phy initialization - calibrate the phy */
 	ret = phy_init(phy);
