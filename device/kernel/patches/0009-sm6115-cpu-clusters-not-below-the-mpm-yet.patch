From c0b2319a1abcf63c24dfab6ff77af47c1634d6c2 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 28 Oct 2026 22:16:02 +0100
Subject: [PATCH] sm6115: the CPU clusters not below the MPM yet

psci-cpuidle (a faux device since 6.16) probes once at device_initcall and
cannot defer: with the clusters' power domains below the MPM, which waits
for its mailbox and SRAM, they are not there yet, and the phone ends up
without cpuidle at all. The MPM stays for the wake-up interrupts; the
clusters go below it again once psci-cpuidle waits for its domains.
---
 arch/arm64/boot/dts/qcom/sm6115.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115.dtsi b/arch/arm64/boot/dts/qcom/sm6115.dtsi
index 47c180f3b5..ea0638cc62 100644
--- a/arch/arm64/boot/dts/qcom/sm6115.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6115.dtsi
@@ -360,13 +360,11 @@ cpu_pd7: power-domain-cpu7 {
 
 		cluster_0_pd: power-domain-cpu-cluster0 {
 			#power-domain-cells = <0>;
-			power-domains = <&mpm>;
 			domain-idle-states = <&cluster_0_sleep_0>, <&cluster_0_sleep_1>;
 		};
 
 		cluster_1_pd: power-domain-cpu-cluster1 {
 			#power-domain-cells = <0>;
-			power-domains = <&mpm>;
 			domain-idle-states = <&cluster_1_sleep_0>, <&cluster_1_sleep_1>;
 		};
 	};
-- 
2.56.0

