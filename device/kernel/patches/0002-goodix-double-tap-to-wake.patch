diff --git a/drivers/input/touchscreen/goodix.c b/drivers/input/touchscreen/goodix.c
index f8798d11ec..562c5d35ab 100644
--- a/drivers/input/touchscreen/goodix.c
+++ b/drivers/input/touchscreen/goodix.c
@@ -457,6 +457,65 @@ static void goodix_ts_report_key(struct goodix_ts_data *ts, u8 *data)
 	}
 }
 
+/*
+ * Double tap to wake. Phones blank the display by inhibiting the touchscreen
+ * input device (Maemo's mce does that); the controller keeps scanning and
+ * interrupting, but inhibited devices deliver nothing. With dt2w enabled the
+ * driver then looks for two short taps close to each other and reports a
+ * power key press on a separate, never inhibited input device, which user
+ * space already treats as "turn the display on".
+ */
+static bool dt2w;
+module_param(dt2w, bool, 0644);
+MODULE_PARM_DESC(dt2w, "Double tap the inhibited touchscreen to send KEY_POWER");
+
+#define GOODIX_DT2W_TAP_MAX_MS		300	/* finger down -> up */
+#define GOODIX_DT2W_GAP_MAX_MS		500	/* first tap up -> second tap up */
+
+static void goodix_dt2w_event(struct goodix_ts_data *ts, int touch_num, u8 *point_data)
+{
+	ktime_t now = ktime_get();
+	u8 *coor = &point_data[1];
+	int x, y, dist;
+
+	if (touch_num > 0) {
+		if (!ts->dt2w_down) {
+			ts->dt2w_down = true;
+			ts->dt2w_down_time = now;
+			if (ts->contact_size == 9)
+				coor++;
+			ts->dt2w_x = get_unaligned_le16(&coor[1]);
+			ts->dt2w_y = get_unaligned_le16(&coor[3]);
+		}
+		return;
+	}
+	if (!ts->dt2w_down)
+		return;
+
+	/* Finger lifted: was it a tap, and the second one close to the first? */
+	ts->dt2w_down = false;
+	x = ts->dt2w_x;
+	y = ts->dt2w_y;
+	if (ktime_ms_delta(now, ts->dt2w_down_time) > GOODIX_DT2W_TAP_MAX_MS) {
+		ts->dt2w_last_tap = 0;
+		return;
+	}
+	dist = max(ts->prop.max_x, ts->prop.max_y) / 8;
+	if (ts->dt2w_last_tap &&
+	    ktime_ms_delta(now, ts->dt2w_last_tap) <= GOODIX_DT2W_GAP_MAX_MS &&
+	    abs(x - ts->dt2w_last_x) < dist && abs(y - ts->dt2w_last_y) < dist) {
+		ts->dt2w_last_tap = 0;
+		input_report_key(ts->input_wake, KEY_POWER, 1);
+		input_sync(ts->input_wake);
+		input_report_key(ts->input_wake, KEY_POWER, 0);
+		input_sync(ts->input_wake);
+		return;
+	}
+	ts->dt2w_last_tap = now;
+	ts->dt2w_last_x = x;
+	ts->dt2w_last_y = y;
+}
+
 /**
  * goodix_process_events - Process incoming events
  *
@@ -475,6 +534,14 @@ static void goodix_process_events(struct goodix_ts_data *ts)
 	if (touch_num < 0)
 		return;
 
+	if (ts->input_wake && !input_device_enabled(ts->input_dev)) {
+		if (READ_ONCE(dt2w))
+			goodix_dt2w_event(ts, touch_num, point_data);
+		return;
+	}
+	ts->dt2w_down = false;
+	ts->dt2w_last_tap = 0;
+
 	/* The pen being down is always reported as a single touch */
 	if (touch_num == 1 && (point_data[1] & 0x80)) {
 		goodix_ts_report_pen_down(ts, point_data);
@@ -1239,6 +1306,19 @@ static int goodix_configure_dev(struct goodix_ts_data *ts)
 		return error;
 	}
 
+	/* Power key for double tap to wake; harmless while dt2w is off. */
+	ts->input_wake = devm_input_allocate_device(&ts->client->dev);
+	if (ts->input_wake) {
+		ts->input_wake->name = "Goodix double-tap wake";
+		ts->input_wake->phys = "input/ts-wake";
+		ts->input_wake->id.bustype = BUS_I2C;
+		input_set_capability(ts->input_wake, EV_KEY, KEY_POWER);
+		if (input_register_device(ts->input_wake)) {
+			dev_warn(&ts->client->dev, "double tap to wake unavailable\n");
+			ts->input_wake = NULL;
+		}
+	}
+
 	/*
 	 * Create the input_pen device before goodix_request_irq() calls
 	 * devm_request_threaded_irq() so that the devm framework frees
diff --git a/drivers/input/touchscreen/goodix.h b/drivers/input/touchscreen/goodix.h
