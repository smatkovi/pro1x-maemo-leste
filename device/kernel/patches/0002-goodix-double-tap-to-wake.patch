+	/* Double tap to wake while user space has the touchscreen inhibited. */
+	struct input_dev *input_wake;
+	bool dt2w_down;
+	ktime_t dt2w_down_time;
+	ktime_t dt2w_last_tap;
+	int dt2w_x, dt2w_y;
+	int dt2w_last_x, dt2w_last_y;
 };
 
