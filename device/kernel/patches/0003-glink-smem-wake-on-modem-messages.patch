diff --git a/drivers/rpmsg/qcom_glink_smem.c b/drivers/rpmsg/qcom_glink_smem.c
index 62adc4db23..c09d9f0409 100644
--- a/drivers/rpmsg/qcom_glink_smem.c
+++ b/drivers/rpmsg/qcom_glink_smem.c
@@ -22,6 +22,7 @@
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 #include <linux/list.h>
+#include <linux/pm_wakeup.h>
 
 #include <linux/rpmsg/qcom_glink.h>
 
@@ -45,8 +46,38 @@ struct qcom_glink_smem {
 	struct mbox_chan *mbox_chan;
 
 	u32 remote_pid;
+	bool wakeup;
 };
 
+/*
+ * Messages from these remote processors (glink-edge labels) are wake-up
+ * events: the modem's carry incoming calls and SMS, which would otherwise
+ * wait in the FIFO until something else woke the system. The interrupt is
+ * IRQF_NO_SUSPEND, so it keeps firing in s2idle; reporting a wake-up event
+ * resumes the system and also aborts a suspend about to start.
+ */
+static char *wakeup_edges = "mpss";
+module_param(wakeup_edges, charp, 0444);
+MODULE_PARM_DESC(wakeup_edges, "comma-separated glink-edge labels whose messages wake the system");
+
+static bool qcom_glink_smem_wakes(struct device_node *node)
+{
+	const char *label, *p = wakeup_edges;
+	size_t len;
+
+	if (!p || of_property_read_string(node, "label", &label))
+		return false;
+	len = strlen(label);
+	while (*p) {
+		if (!strncmp(p, label, len) && (p[len] == ',' || !p[len]))
+			return true;
+		p = strchrnul(p, ',');
+		if (*p)
+			p++;
+	}
+	return false;
+}
+
 struct glink_smem_pipe {
 	struct qcom_glink_pipe native;
 
@@ -205,6 +236,8 @@ static irqreturn_t qcom_glink_smem_intr(int irq, void *data)
 {
 	struct qcom_glink_smem *smem = data;
 
+	if (smem->wakeup)
+		pm_wakeup_dev_event(&smem->dev, 0, true);
 	qcom_glink_native_rx(smem->glink);
 
 	return IRQ_HANDLED;
@@ -256,6 +289,11 @@ struct qcom_glink_smem *qcom_glink_smem_register(struct device *parent,
 
 	smem->remote_pid = remote_pid;
 
+	if (qcom_glink_smem_wakes(node)) {
+		device_init_wakeup(dev, true);
+		smem->wakeup = true;
+	}
+
 	rx_pipe = devm_kzalloc(dev, sizeof(*rx_pipe), GFP_KERNEL);
 	tx_pipe = devm_kzalloc(dev, sizeof(*tx_pipe), GFP_KERNEL);
 	if (!rx_pipe || !tx_pipe) {
@@ -369,6 +407,8 @@ void qcom_glink_smem_unregister(struct qcom_glink_smem *smem)
 	qcom_glink_native_remove(glink);
 
 	mbox_free_channel(smem->mbox_chan);
+	if (smem->wakeup)
+		device_init_wakeup(&smem->dev, false);
 	device_unregister(&smem->dev);
 }
 EXPORT_SYMBOL_GPL(qcom_glink_smem_unregister);
