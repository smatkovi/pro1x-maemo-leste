# Aus boot_a des laufenden Sailfish-OS-Images ausgelesen (Pro1X, halium-qx1050)
# Quelle: scripts/lib/bootimg-params.py gegen /dev/disk/by-partlabel/boot_a
BOOT_HEADER_VERSION=2
BOOT_PAGESIZE=4096
BOOT_BASE=0x00000000
BOOT_KERNEL_OFFSET=0x00008000
BOOT_RAMDISK_OFFSET=0x01000000
BOOT_SECOND_OFFSET=0x00f00000
BOOT_TAGS_OFFSET=0x00000100
BOOT_DTB_OFFSET=0x01f00000
BOOT_PARTITION_SIZE_MIB=96
DTBO_PARTITION_SIZE_MIB=24
# Referenzwerte des SFOS-Images (nur zum Vergleich, nicht zum Nachbauen):
#   kernel  18.80 MiB, ramdisk 5.11 MiB, dtb 310.1 KiB, second 0, os_version 0x1600015a
