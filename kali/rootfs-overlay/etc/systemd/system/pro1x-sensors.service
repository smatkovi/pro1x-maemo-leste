# iio-sensor-proxy built with libssc (Leste's scripts/46): the Pro1X sensors
# sit on the ADSP. It takes the place of Kali's iio-sensor-proxy (masked).
[Unit]
Description=IIO sensor proxy for the Pro1X (SSC)
After=pro1x-hexagonrpcd.service
Wants=pro1x-hexagonrpcd.service

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/usr/lib/pro1x/iio-sensor-proxy
Environment=LD_LIBRARY_PATH=/usr/lib/pro1x
Restart=on-failure

[Install]
WantedBy=graphical.target
