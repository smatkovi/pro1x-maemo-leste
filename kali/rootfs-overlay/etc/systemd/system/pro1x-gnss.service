# The modem's GNSS engine over QMI, as NMEA to gpsd (udp://127.0.0.1:29470).
#
# Only while gpsd runs, as on Leste (whose location-daemon starts gpsd for
# an application): gpsd.socket starts gpsd for its first client, gpsd pulls
# this in (WantedBy) and stops it with itself (BindsTo); SIGTERM makes
# pro1x-gnss stop the LOC session. Started at boot instead (until
# 2026-10-31) the engine computed a fix every second for ever, with a
# wake-up of the phone for each. gpsd and the engine keep running after
# the last client; "systemctl stop gpsd.service" switches both off (the
# socket starts them again). Back to the engine from boot on:
# "systemctl enable gpsd.service".
[Unit]
Description=Pro1X GNSS (modem LOC service to gpsd)
BindsTo=gpsd.service
After=rmtfs.service gpsd.service

[Service]
ExecStart=/usr/lib/pro1x/pro1x-gnss -p 29470
Environment=LD_LIBRARY_PATH=/usr/lib/pro1x
Restart=on-failure
RestartSec=10

[Install]
WantedBy=gpsd.service
