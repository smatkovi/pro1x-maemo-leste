#!/bin/sh
# hildon-session: Maemo Leste's Hildon desktop as an X11 session on Arch
# (arch/40-hildon.sh), started by hildon.service or, with the MeeGo look,
# meego.service through xinit: what
# Leste's Xsession.d and Xsession.post scripts do. The status menu and home
# run beside hildon-desktop and come back when they crash; the session ends
# with hildon-desktop.
export GTK2_RC_FILES=/etc/hildon/theme/gtk-2.0/gtkrc
case ${LANG:-C} in C|C.*|POSIX) LANG=en_GB.UTF-8 ;; esac
export LANG
export HILDON_DESKTOP_APPS_PRESTART=auto
export CLUTTER_BACKEND=x11
export XDG_CURRENT_DESKTOP=Hildon
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] ||
	export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus

mkdir -p /tmp/hildon-desktop /tmp/af-piddir
# The MeeGo look (meego.service): the home views, the launcher and the open
# applications as pages in a ring, the edge gestures (patches/meego); plain
# Hildon (hildon.service) without
if [ "${PRO1X_LOOK:-}" = meego ]; then meego=true; else meego=false; fi
gconftool-2 -s -t bool /apps/osso/hildon-desktop/meego_pages $meego 2> /dev/null
# As Leste: no key repeat for Return and the hardware keys
xset -r 36 -r 70 -r 72 -r 9 -r 104 2> /dev/null
xset s off -dpms
# At the N900's size on the full resolution (pro1x-hidpi)
eval "$(/usr/local/bin/pro1x-hidpi env)"
/usr/local/bin/pro1x-hidpi x11

# The theme engine's image server before any GTK program
GDK_DISABLE_XSHM=1 /usr/lib/sapwood/sapwood-server &
sapwood=$!

# After a start by the RTC alarm: the N9's screens over the system UI's
# alarm dialog, then off again as the N9 (pro1x-alarmboot,
# docs/alarm-power-on.md); before alarmd and the system UI, so that it sees
# the dialog of an alarm already due come up; it ends at once after any
# other start. Its log: /tmp/pro1x-alarmboot.log
if [ -x /usr/bin/pro1x-alarmboot ]; then
	/usr/bin/pro1x-alarmboot -v > /dev/null 2> /tmp/pro1x-alarmboot.log &
fi

session=$$
respawn() {
	trap 'kill $pid 2> /dev/null; exit 0' TERM
	while kill -0 "$session" 2> /dev/null; do
		"$@" &
		pid=$!
		wait $pid
		sleep 2
	done
}
# Sound is PipeWire's, its PulseAudio server started by the user's
# systemd (pipewire-pulse.socket). The N9's volume bar on its default
# sink, seen while the MeeGo look is on (Leste:
# Xsession.post/46pro1x-volume-osd; arch/42-meego-look.sh)
extra=
if [ -x /usr/bin/pro1x-volume-osd ]; then
	respawn /usr/bin/pro1x-volume-osd &
	extra=$!
fi
# The alarm daemon and the system UI, which shows its alarm dialog (Leste:
# Xsession.d/03alarmd and 03osso-systemui), as this session's user (arch/
# alarm: its D-Bus policy, the queue's directory, rtc0 for it). alarmd sets
# the RTC's wake alarm through librtc-realtime: the Pro1X's RTC keeps no
# real time (tools/pro1x-rtc)
alarm=
if [ -x /usr/bin/alarmd ]; then
	if [ -f /usr/lib/pro1x/librtc-realtime.so ]; then
		respawn env LD_PRELOAD=/usr/lib/pro1x/librtc-realtime.so /usr/bin/alarmd &
	else
		respawn /usr/bin/alarmd &
	fi
	alarm=$!
fi
if [ -x /usr/bin/systemui ]; then
	respawn /usr/bin/systemui &
	alarm="$alarm $!"
fi
respawn /usr/bin/hildon-status-menu &
menu=$!
# The N9's Events page, the first home view while the MeeGo look is on
# (Leste: Xsession.post/47pro1x-events)
if [ -x /usr/bin/pro1x-events ]; then
	respawn /usr/bin/pro1x-events &
	extra="$extra $!"
fi
respawn /usr/bin/hildon-home &
home=$!
# The desktop is up: alarmd shows alarms only then (out of its "limbo"),
# as Leste's Xsession.post/21hildon-desktop-wait and 99initdone tell it
if [ -n "$alarm" ]; then
	(
		for _ in $(seq 120); do
			[ -e /tmp/hildon-desktop/desktop-started.stamp ] && break
			sleep 1
		done
		sleep 5
		dbus-send --system --type=signal /com/nokia/HildonDesktop/ready \
			com.nokia.HildonDesktop.ready
		dbus-send --system --type=signal /com/nokia/startup/signal \
			com.nokia.startup.signal.init_done
	) &
fi
/usr/bin/hildon-desktop
kill $menu $home $extra $alarm $sapwood 2> /dev/null
