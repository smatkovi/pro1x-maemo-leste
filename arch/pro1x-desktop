#!/bin/sh
# pro1x-desktop phosh|hildon|meego|harmattan: (hildon: Leste's desktop;
# meego: it with the N9's pages and gestures; harmattan: the N9's own UI) the session the phone starts for alarm
# (as root): enables that one's unit, disables the others and switches now.
#
# Run as alarm it asks sudo first (alarm's password), before anything
# changes: as alarm, systemctl asked polkit, whose agent is the session's
# own (Phosh's); with the old session stopped, nobody could answer for the
# new one any more, and no session was left enabled. The switch itself runs
# outside the caller's terminal, which stops with the old session.
set -eu
want=${1:?phosh, hildon, meego or harmattan}
case $want in phosh|hildon|meego|harmattan) ;; *) echo "phosh, hildon, meego or harmattan" >&2; exit 2 ;; esac
[ -f "/etc/systemd/system/$want.service" ] || { echo "$want is not installed" >&2; exit 1; }
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
systemctl enable "$want.service"
others=
for s in phosh hildon meego harmattan; do
	[ "$s" = "$want" ] && continue
	systemctl disable "$s.service" 2> /dev/null || true
	others="$others $s.service"
done
systemd-run --quiet --no-block --collect --unit="pro1x-desktop-$want" \
	/bin/sh -c "systemctl stop$others; systemctl start $want.service"
