#!/bin/sh
# Moves the backing partition (userdata) into the new root, so that the
# loop image does not hang off an orphaned mount and the Sailfish rootfs is
# reachable from Leste.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

if mountpoint -q /host 2>/dev/null || grep -q ' /host ' /proc/mounts; then
  mkdir -p "${rootmnt}/host"
  mount --move /host "${rootmnt}/host"
fi
exit 0
