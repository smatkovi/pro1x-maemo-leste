#!/bin/sh
# Provides the Maemo Leste rootfs image as /dev/loop0, so that
# initramfs-tools can mount it as root=/dev/loop0.
#
# Background: the Pro1X has no free partition for a second system
# (userdata is the last partition of the LUN). Leste therefore lives as an
# image file on userdata, next to the Sailfish rootfs. Modern
# initramfs-tools no longer knows root=...,loop=, so we do it ourselves.
#
# Kernel cmdline: pro1x.backing=UUID=<fs-uuid>  pro1x.image=/path/in/backing
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

. /scripts/functions

BACKING=""
IMAGE=""
for x in $(cat /proc/cmdline); do
  case "$x" in
    pro1x.backing=*) BACKING="${x#pro1x.backing=}" ;;
    pro1x.image=*)   IMAGE="${x#pro1x.image=}" ;;
  esac
done
[ -n "$BACKING" ] || panic "pro1x-loop-root: pro1x.backing= missing from the cmdline"
[ -n "$IMAGE" ] || IMAGE=/maemo-leste.img

# The file systems' options for energy (docs/power-management.md, "File
# systems"): the journals commit every 30 s instead of 5, timestamps are
# written lazily (lazytime), the images' loop devices use direct I/O. All
# back to the old ones with a file /host/pro1x-fs-defaults (the next start).
HOST_OPTS=rw,noatime,lazytime,commit=30

# Resolve the backing device into $dev; UFS takes a moment to appear.
find_backing() {
  dev=""
  i=0
  while [ $i -lt 120 ]; do
    case "$BACKING" in
      UUID=*)     dev=$(blkid -U "${BACKING#UUID=}" 2>/dev/null) ;;
      PARTUUID=*) dev=$(blkid -t "PARTUUID=${BACKING#PARTUUID=}" -o device 2>/dev/null | head -1) ;;
      *)          [ -b "$BACKING" ] && dev="$BACKING" ;;
    esac
    [ -n "$dev" ] && [ -b "$dev" ] && return 0
    dev=""
    i=$((i + 1))
    sleep 0.25
  done
  return 1
}
find_backing || panic "pro1x-loop-root: backing device $BACKING not found"

# The SoC's APSS watchdog (0x0f017000, kpss layout, 32 kHz), armed for its
# longest time, about 32 s; reloaded to the full time again; stopped. Linux's
# qcom_wdt is not loaded at this point. Without devmem, nothing (a start
# that hangs then needs the power key).
wdt_arm() {
  command -v devmem > /dev/null || return 0
  devmem 0x0f017008 32 0
  devmem 0x0f017004 32 1
  devmem 0x0f017010 32 0xfffff
  devmem 0x0f017014 32 0xfffff
  devmem 0x0f017008 32 1
}
wdt_reload() { command -v devmem > /dev/null && devmem 0x0f017004 32 1; }
wdt_stop() { command -v devmem > /dev/null && devmem 0x0f017008 32 0; }
# A line in the kernel log at error level, so that the RAM console of a
# start that went wrong (pstore, loglevel=4) shows how far it got
kmsg() { echo "<3>pro1x-loop-root: $*" > /dev/kmsg 2> /dev/null; }

mkdir -p /host
mount -t ext4 -o "$HOST_OPTS" "$dev" /host \
  || panic "pro1x-loop-root: could not mount $dev on /host"
FS_DEFAULTS=
if [ -e /host/pro1x-fs-defaults ]; then
  FS_DEFAULTS=1
  HOST_OPTS=rw,noatime
  mount -o remount,rw,noatime,nolazytime,commit=5 /host
fi

# Boot menu: pick the system image (or switch to Sailfish in slot a).
# A one-shot "next" choice (pro1x-boot next ...) is preselected, else the
# default; after the countdown the preselected entry starts by itself.
if [ -x /sbin/pro1x-bootmenu ] && [ -x /sbin/pro1x-boot ]; then
  export PRO1X_BOOT_HOST=/host
  # What this start chose and why, for a look from the running system
  # (a start that went elsewhere than asked, from the PC)
  BOOTLOG=/host/pro1x-boot/last-boot
  bootlog() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> $BOOTLOG 2>/dev/null; }
  : > $BOOTLOG 2>/dev/null
  # A trial of a new kernel (pro1x-boot trial, 65-kernel-update.sh): over
  # if a start of it was confirmed (slot b successful again), dropped if
  # another kernel runs, else this start is one of its tries
  trial=$(pro1x-boot trial-check 2>/dev/null) || trial=none
  entries=$(pro1x-boot entries)
  # Powered on by the RTC alarm: the system that set the alarm starts at
  # once, without the menu, so that its alarm rings (pro1x-boot
  # alarm-check, docs/alarm-power-on.md; it writes /host/pro1x-boot/
  # alarmboot for that system). A one-shot choice stays for the next
  # start then, unless it names that system (older Leste init scripts set
  # one at a shutdown with an alarm).
  alarm=
  if aline=$(pro1x-boot alarm-check 2>&1); then
    alarm=${aline%% *}
  fi
  bootlog "alarm-check: $aline"
  if [ -n "$alarm" ]; then
    want=$alarm
    [ "$(cat /host/pro1x-boot/next 2>/dev/null)" != "$alarm" ] || pro1x-boot take-next > /dev/null
  else
    want=$(pro1x-boot take-next)
  fi
  # a one-shot choice (another system tried from the PC, say) gets the
  # watchdog like a trial start: a hang ends in the default system again;
  # so does a start by the alarm
  oneshot=${want:+1}
  [ -n "$want" ] || want=$(pro1x-boot get-default)
  timeout=$(pro1x-boot get-timeout)
  bootlog "want=[$want] oneshot=$oneshot alarm=[$alarm] trial=$trial timeout=$timeout"
  count=0
  default=0
  set --
  # a snapshot (system@number) preselects its system's snapshots entry; a
  # system without @ its own entry, not the snapshots one after it
  case $want in *@*) snapentry=${want%@*}@ ;; *) snapentry= ;; esac
  while IFS='|' read -r key label image; do
    { [ "$key" = "$want" ] || [ "$key" = "$snapentry" ]; } && default=$count
    set -- "$@" "$label"
    count=$((count + 1))
  done <<EOF
$entries
EOF
  choice=$default
  if [ -z "$alarm" ] && [ "$count" -gt 1 ] && [ "$timeout" -gt 0 ]; then
    choice=$(pro1x-bootmenu -t "$timeout" -d "$default" "$@") || choice=$default
  fi
  line=$(echo "$entries" | sed -n "$((choice + 1))p")
  key=${line%%|*}
  image=${line##*|}
  bootlog "entries: $(echo "$entries" | cut -d'|' -f1 | tr '\n' ' ')"
  bootlog "default=$default count=$count choice=$choice key=$key image=$image"
  # A system's snapshots (Btrfs): a second menu, newest first, 8 to a page
  # and "More" for the next. A snapshot chosen with "pro1x-boot next
  # system@number" starts after the countdown (at once without a menu);
  # chosen by hand, the menu waits.
  case $key in
  *@)
    sys=${key%@}
    snaps=$(pro1x-boot snapshots "$sys")
    total=$(echo "$snaps" | grep -c .)
    page=0 sdefault=0 stimeout=0 direct=
    case $want in
    "$sys"@[0-9]*)
      n=$(echo "$snaps" | cut -d'|' -f1 | grep -nx "$want" | cut -d: -f1)
      if [ -n "$n" ]; then
        page=$(((n - 1) / 8)) sdefault=$(((n - 1) % 8)) stimeout=$timeout
        [ "$timeout" -gt 0 ] && [ "$count" -gt 1 ] && [ -z "$alarm" ] || direct=1
      fi ;;
    esac
    while :; do
      pagelines=$(echo "$snaps" | sed -n "$((page * 8 + 1)),$((page * 8 + 8))p")
      set --
      while IFS='|' read -r skey slabel; do
        set -- "$@" "${skey#*@} $slabel"
      done <<SNAPS
$pagelines
SNAPS
      more=
      [ "$total" -gt $(((page + 1) * 8)) ] && { more=$#; set -- "$@" "More ..."; }
      if [ -n "$direct" ]; then
        schoice=$sdefault
      else
        schoice=$(pro1x-bootmenu -t "$stimeout" -d "$sdefault" "$@") || schoice=$sdefault
      fi
      if [ -n "$more" ] && [ "$schoice" = "$more" ]; then
        page=$((page + 1)) sdefault=0 stimeout=0
        continue
      fi
      break
    done
    key=$(echo "$pagelines" | sed -n "$((schoice + 1))p" | cut -d'|' -f1)
    [ -n "$key" ] || key=$sys
    # read-only snapshot, its changes in RAM (init-bottom/pro1x-overlay-root)
    [ "$key" = "$sys" ] || SUBVOL=@snapshots/${key#*@}/snapshot
    ;;
  esac
  if [ "$key" = sailfish ]; then
    log_begin_msg "Switching to Sailfish OS (slot a)"
    pro1x-boot slot a && sync && umount /host && reboot -f
    log_failure_msg "slot switch failed, booting $IMAGE"
  elif { [ "$key" = freebsd ] || [ "$key" = kolibri ]; } && [ -x /sbin/kexec ]; then
    # FreeBSD (freebsd/ in the repo) and KolibriOS (github
    # smatkovi/kolibrios-arm) run their own kernels: load it with
    # kexec_file, which hands over the device tree this kernel booted with,
    # and jump. Linux ends here. FreeBSD reads only bootargs that start
    # with "FreeBSD:"; cmdline next to the kernel adds to them (FreeBSD:
    # kernel environment, e.g. hint.ufshci.0.disabled=1; KolibriOS:
    # kolibri.lifetime=N, kolibri.noinput).
    log_begin_msg "Starting $key"
    pro1x-boot set-current "$key"
    # its own kernel: a Linux kernel on trial that came as far as this
    # menu counts as started
    [ "$trial" != running ] || pro1x-boot trial-ok > /dev/null
    args=$(cat "/host${image%/*}/cmdline" 2>/dev/null)
    if [ "$key" = freebsd ]; then
      # The time: the RTC only counts, Leste keeps the offset (pro1x-rtc)
      off=$(cat /host/pro1x-rtc-offset 2>/dev/null)
      case "$off" in
        ''|*[!0-9-]*) ;;
        *) args="$args hint.qcom_rtc.0.offset=$off" ;;
      esac
      # a start by its alarm (kenv pro1x.alarmboot, rc.d/pro1x_alarmboot;
      # pro1x.alarmdue: the alarm's real time, when the offset is known)
      if [ "$alarm" = freebsd ]; then
        args="$args pro1x.alarmboot=1"
        due=$(sed -n 's/^due=\([0-9][0-9]*\)$/\1/p' /host/pro1x-boot/alarmboot 2>/dev/null)
        [ -z "$due" ] || args="$args pro1x.alarmdue=$due"
      fi
      args="FreeBSD:$args"
    fi
    # FreeBSD has no driver for the SMMU in front of UFS and hands the
    # controller physical addresses. UFS stays bound and translated here;
    # the kexec itself switches translation off for its stream, after its
    # last command (device/kernel/patches/0040: arm_smmu.kexec_bypass), and
    # keeps it powered (0004). A kernel without 0040 does not start FreeBSD.
    # (Until 2026-10-31, UFS was unbound, put into an identity domain and
    # bound again here: the rebound host lost its commands' DMA, the probe
    # never finished, and the phone hung, docs/device-day-2026-10-31.md
    # block 12.) KolibriOS leaves UFS alone.
    smmu_bypass=/sys/module/arm_smmu/parameters/kexec_bypass
    if [ "$key" = freebsd ] && [ ! -e $smmu_bypass ]; then
      log_failure_msg "kernel $(uname -r) cannot hand UFS over to FreeBSD (needs patch 0040), booting $IMAGE"
      kmsg "no arm_smmu.kexec_bypass in $(uname -r): not starting $key"
      bootlog "not starting $key: no arm_smmu.kexec_bypass in $(uname -r)"
    elif kexec -s -l "/host$image" --command-line="$args"; then
      bootlog "starting $key: $image loaded; the watchdog, umount, kexec"
      sync
      # The watchdog from here on: a hang anywhere until the next system
      # feeds it (umount, the kexec's shutdown of Linux, the jump, the
      # next system's early start) resets the phone into this menu, whose
      # default starts then (the one-shot choice was taken above).
      wdt_arm
      kmsg "starting $key: watchdog armed"
      umount /host
      [ "$key" != freebsd ] || echo 4804000.ufshc > $smmu_bypass
      # FreeBSD and KolibriOS drive these on the setup Linux leaves (no
      # clock drivers): runtime-active from here on, their clocks stay on.
      # 4a84000.i2c: the keyboard's I2C bus.
      for d in 4a84000.i2c; do
        pm=/sys/bus/platform/devices/$d/power/control
        [ -e $pm ] && echo on > $pm
      done
      # The full 32 s again for the jump: FreeBSD's qcom_wdt (KolibriOS's
      # timer) keeps feeding it, and a system that hangs before or after
      # that resets the phone. Nothing stops it on the way out.
      wdt_reload
      kexec -e
      # kexec -e came back: Linux still runs, and so does UFS
      [ "$key" != freebsd ] || echo > $smmu_bypass
      wdt_stop
      kmsg "kexec -e failed: not starting $key"
      find_backing && mount -t ext4 -o "$HOST_OPTS" "$dev" /host
      log_failure_msg "kexec failed, booting $IMAGE"
    else
      log_failure_msg "kexec failed, booting $IMAGE"
    fi
    key=leste
  elif [ -n "$image" ]; then
    IMAGE=$image
  fi
  # The running system reads this (MeeGo may boot the Leste image).
  pro1x-boot set-current "$key"
  bootlog "starting $key: IMAGE=$IMAGE SUBVOL=${SUBVOL:-}"
  sync
  # On trial, and for a one-shot choice: the SoC's watchdog runs from here
  # on (the APSS watchdog, wdt_arm, as for FreeBSD above). qcom_wdt
  # finds it running and the kernel feeds it until the system takes it
  # over (dsme on Leste and the MeeGo copy, systemd's RuntimeWatchdog
  # elsewhere, 66-boot-trial-install.sh) or for at most 15 minutes. A start
  # that hangs thus resets the phone: into the default system after a
  # one-shot choice; on trial pro1x-boot-trial in the system confirms the
  # start once its user interface runs, or reboots, and the bootloader
  # takes one of the trial's tries for every start.
  if [ "$trial" = running ] || [ -n "$oneshot" ]; then
    echo 900 > /sys/module/watchdog/parameters/open_timeout 2> /dev/null
    wdt_arm
    modprobe qcom_wdt || log_warning_msg "pro1x-loop-root: no watchdog for this start"
  fi
fi

[ -f "/host$IMAGE" ] || panic "pro1x-loop-root: /host$IMAGE does not exist"

# Loop device deterministically on loop0, so that root=/dev/loop0 matches.
# With direct I/O the image's pages are not cached a second time as the
# backing file's, and not written back a second time from there; the loop
# device then takes the disk's 4 KiB sectors, so only an image whose file
# system has 4 KiB blocks (or larger) gets it (blkid's BLOCK_SIZE), else,
# or when losetup cannot, the plain loop device as before.
[ -b /dev/loop0 ] || mknod /dev/loop0 b 7 0
bs=$(blkid -o value -s BLOCK_SIZE "/host$IMAGE" 2>/dev/null)
if [ -z "$FS_DEFAULTS" ] && [ "${bs:-0}" -ge 4096 ] 2>/dev/null &&
   losetup --direct-io=on /dev/loop0 "/host$IMAGE" 2>/dev/null; then
  echo "pro1x-loop-root: /dev/loop0 with direct I/O" > /dev/kmsg 2>/dev/null
else
  losetup /dev/loop0 "/host$IMAGE" \
    || panic "pro1x-loop-root: losetup on /host$IMAGE failed"
fi

# A Btrfs image (Arch): the root is its subvolume @, or a snapshot of it,
# mounted read-only below a RAM overlay (init-bottom/pro1x-overlay-root);
# initramfs-tools mounts the root with what /conf/param.conf says
if [ "$(blkid -o value -s TYPE /dev/loop0 2>/dev/null)" = btrfs ]; then
  modprobe btrfs 2>/dev/null
  echo "ROOTFSTYPE=btrfs" >> /conf/param.conf
  echo "ROOTFLAGS='-o subvol=${SUBVOL:-@},noatime${FS_DEFAULTS:-,lazytime},compress=zstd:1'" >> /conf/param.conf
  [ -z "${SUBVOL:-}" ] || : > /conf/pro1x-overlay
elif [ -z "$FS_DEFAULTS" ]; then
  # ext4 (Leste, the MeeGo copy, Kali, LuneOS); each system's fstab has
  # the same options for its root, or its boot-time remount would drop
  # lazytime again
  echo "ROOTFLAGS='-o lazytime,commit=30'" >> /conf/param.conf
fi

exit 0
