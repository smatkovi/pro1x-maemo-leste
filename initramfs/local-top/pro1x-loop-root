#!/bin/sh
# Provides the Maemo Leste rootfs image as /dev/loop0, so that
# initramfs-tools can mount it as root=/dev/loop0.
#
# Background: the Pro1X has no free partition for a second system
# (userdata is the last partition of the LUN). Leste therefore lives as an
# image file on userdata, next to the Sailfish rootfs. Modern
# initramfs-tools no longer knows root=...,loop=, so we do it ourselves.
#
# Kernel cmdline: pro1x.backing=UUID=<fs-uuid>  pro1x.image=/path/in/backing
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

. /scripts/functions

BACKING=""
IMAGE=""
for x in $(cat /proc/cmdline); do
  case "$x" in
    pro1x.backing=*) BACKING="${x#pro1x.backing=}" ;;
    pro1x.image=*)   IMAGE="${x#pro1x.image=}" ;;
  esac
done
[ -n "$BACKING" ] || panic "pro1x-loop-root: pro1x.backing= missing from the cmdline"
[ -n "$IMAGE" ] || IMAGE=/maemo-leste.img

# Resolve the backing device into $dev; UFS takes a moment to appear.
find_backing() {
  dev=""
  i=0
  while [ $i -lt 120 ]; do
    case "$BACKING" in
      UUID=*)     dev=$(blkid -U "${BACKING#UUID=}" 2>/dev/null) ;;
      PARTUUID=*) dev=$(blkid -t "PARTUUID=${BACKING#PARTUUID=}" -o device 2>/dev/null | head -1) ;;
      *)          [ -b "$BACKING" ] && dev="$BACKING" ;;
    esac
    [ -n "$dev" ] && [ -b "$dev" ] && return 0
    dev=""
    i=$((i + 1))
    sleep 0.25
  done
  return 1
}
find_backing || panic "pro1x-loop-root: backing device $BACKING not found"

mkdir -p /host
mount -t ext4 -o rw,noatime "$dev" /host \
  || panic "pro1x-loop-root: could not mount $dev on /host"

# Boot menu: pick the system image (or switch to Sailfish in slot a).
# A one-shot "next" choice (pro1x-boot next ...) is preselected, else the
# default; after the countdown the preselected entry starts by itself.
if [ -x /sbin/pro1x-bootmenu ] && [ -x /sbin/pro1x-boot ]; then
  export PRO1X_BOOT_HOST=/host
  # A trial of a new kernel (pro1x-boot trial, 65-kernel-update.sh): over
  # if a start of it was confirmed (slot b successful again), dropped if
  # another kernel runs, else this start is one of its tries
  trial=$(pro1x-boot trial-check 2>/dev/null) || trial=none
  entries=$(pro1x-boot entries)
  want=$(pro1x-boot take-next)
  # a one-shot choice (another system tried from the PC, say) gets the
  # watchdog like a trial start: a hang ends in the default system again
  oneshot=${want:+1}
  [ -n "$want" ] || want=$(pro1x-boot get-default)
  timeout=$(pro1x-boot get-timeout)
  count=0
  default=0
  set --
  # a snapshot (system@number) preselects its system's snapshots entry; a
  # system without @ its own entry, not the snapshots one after it
  case $want in *@*) snapentry=${want%@*}@ ;; *) snapentry= ;; esac
  while IFS='|' read -r key label image; do
    { [ "$key" = "$want" ] || [ "$key" = "$snapentry" ]; } && default=$count
    set -- "$@" "$label"
    count=$((count + 1))
  done <<EOF
$entries
EOF
  choice=$default
  if [ "$count" -gt 1 ] && [ "$timeout" -gt 0 ]; then
    choice=$(pro1x-bootmenu -t "$timeout" -d "$default" "$@") || choice=$default
  fi
  line=$(echo "$entries" | sed -n "$((choice + 1))p")
  key=${line%%|*}
  image=${line##*|}
  # A system's snapshots (Btrfs): a second menu, newest first, 8 to a page
  # and "More" for the next. A snapshot chosen with "pro1x-boot next
  # system@number" starts after the countdown (at once without a menu);
  # chosen by hand, the menu waits.
  case $key in
  *@)
    sys=${key%@}
    snaps=$(pro1x-boot snapshots "$sys")
    total=$(echo "$snaps" | grep -c .)
    page=0 sdefault=0 stimeout=0 direct=
    case $want in
    "$sys"@[0-9]*)
      n=$(echo "$snaps" | cut -d'|' -f1 | grep -nx "$want" | cut -d: -f1)
      if [ -n "$n" ]; then
        page=$(((n - 1) / 8)) sdefault=$(((n - 1) % 8)) stimeout=$timeout
        [ "$timeout" -gt 0 ] && [ "$count" -gt 1 ] || direct=1
      fi ;;
    esac
    while :; do
      pagelines=$(echo "$snaps" | sed -n "$((page * 8 + 1)),$((page * 8 + 8))p")
      set --
      while IFS='|' read -r skey slabel; do
        set -- "$@" "${skey#*@} $slabel"
      done <<SNAPS
$pagelines
SNAPS
      more=
      [ "$total" -gt $(((page + 1) * 8)) ] && { more=$#; set -- "$@" "More ..."; }
      if [ -n "$direct" ]; then
        schoice=$sdefault
      else
        schoice=$(pro1x-bootmenu -t "$stimeout" -d "$sdefault" "$@") || schoice=$sdefault
      fi
      if [ -n "$more" ] && [ "$schoice" = "$more" ]; then
        page=$((page + 1)) sdefault=0 stimeout=0
        continue
      fi
      break
    done
    key=$(echo "$pagelines" | sed -n "$((schoice + 1))p" | cut -d'|' -f1)
    [ -n "$key" ] || key=$sys
    # read-only snapshot, its changes in RAM (init-bottom/pro1x-overlay-root)
    [ "$key" = "$sys" ] || SUBVOL=@snapshots/${key#*@}/snapshot
    ;;
  esac
  if [ "$key" = sailfish ]; then
    log_begin_msg "Switching to Sailfish OS (slot a)"
    pro1x-boot slot a && sync && umount /host && reboot -f
    log_failure_msg "slot switch failed, booting $IMAGE"
  elif { [ "$key" = freebsd ] || [ "$key" = kolibri ]; } && [ -x /sbin/kexec ]; then
    # FreeBSD (freebsd/ in the repo) and KolibriOS (github
    # smatkovi/kolibrios-arm) run their own kernels: load it with
    # kexec_file, which hands over the device tree this kernel booted with,
    # and jump. Linux ends here. FreeBSD reads only bootargs that start
    # with "FreeBSD:"; cmdline next to the kernel adds to them (FreeBSD:
    # kernel environment, e.g. hint.ufshci.0.disabled=1; KolibriOS:
    # kolibri.lifetime=N, kolibri.noinput).
    log_begin_msg "Starting $key"
    pro1x-boot set-current "$key"
    # its own kernel: a Linux kernel on trial that came as far as this
    # menu counts as started
    [ "$trial" != running ] || pro1x-boot trial-ok > /dev/null
    args=$(cat "/host${image%/*}/cmdline" 2>/dev/null)
    if [ "$key" = freebsd ]; then
      # The time: the RTC only counts, Leste keeps the offset (pro1x-rtc)
      off=$(cat /host/pro1x-rtc-offset 2>/dev/null)
      case "$off" in
        ''|*[!0-9-]*) ;;
        *) args="$args hint.qcom_rtc.0.offset=$off" ;;
      esac
      args="FreeBSD:$args"
    fi
    if kexec -s -l "/host$image" --command-line="$args"; then
      sync
      umount /host
      # FreeBSD has no driver for the SMMU in front of UFS and gives the
      # controller physical addresses: rebind UFS with an identity
      # mapping. This also starts UFS over, and the kernel keeps it
      # powered across kexec (device/kernel/patches/0004). KolibriOS
      # leaves UFS alone.
      ufs=/sys/bus/platform/devices/4804000.ufshc
      grp=
      [ "$key" != freebsd ] || grp=$(readlink "$ufs/iommu_group")
      if [ -n "$grp" ]; then
        echo 4804000.ufshc > $ufs/driver/unbind
        echo identity > "/sys/kernel/iommu_groups/${grp##*/}/type" ||
          log_warning_msg "UFS stays behind the SMMU"
        echo 4804000.ufshc > /sys/bus/platform/drivers/ufshcd-qcom/bind
        # back once its partitions are
        find_backing
      fi
      # FreeBSD and KolibriOS drive these on the setup Linux leaves (no
      # clock drivers): runtime-active from here on, their clocks stay on.
      # 4a84000.i2c: the keyboard's I2C bus.
      for d in 4a84000.i2c; do
        pm=/sys/bus/platform/devices/$d/power/control
        [ -e $pm ] && echo on > $pm
      done
      # The APSS watchdog (0x0f017000, kpss layout, 32 kHz) armed for its
      # longest time, about 32 s: FreeBSD's qcom_wdt (KolibriOS's timer)
      # keeps feeding it, and a system that hangs before or after that
      # resets the phone into this menu again. Linux's qcom_wdt is not
      # loaded here, so nothing stops it on the way out.
      if command -v devmem > /dev/null; then
        devmem 0x0f017008 32 0
        devmem 0x0f017004 32 1
        devmem 0x0f017010 32 0xfffff
        devmem 0x0f017014 32 0xfffff
        devmem 0x0f017008 32 1
      fi
      kexec -e
      command -v devmem > /dev/null && devmem 0x0f017008 32 0
      find_backing && mount -t ext4 -o rw,noatime "$dev" /host
    fi
    log_failure_msg "kexec failed, booting $IMAGE"
    key=leste
  elif [ -n "$image" ]; then
    IMAGE=$image
  fi
  # The running system reads this (MeeGo may boot the Leste image).
  pro1x-boot set-current "$key"
  # On trial, and for a one-shot choice: the SoC's watchdog runs from here
  # on (the APSS watchdog, 0x0f017000, as for FreeBSD above). qcom_wdt
  # finds it running and the kernel feeds it until the system takes it
  # over (dsme on Leste and the MeeGo copy, systemd's RuntimeWatchdog
  # elsewhere, 66-boot-trial-install.sh) or for at most 15 minutes. A start
  # that hangs thus resets the phone: into the default system after a
  # one-shot choice; on trial pro1x-boot-trial in the system confirms the
  # start once its user interface runs, or reboots, and the bootloader
  # takes one of the trial's tries for every start.
  if [ "$trial" = running ] || [ -n "$oneshot" ]; then
    echo 900 > /sys/module/watchdog/parameters/open_timeout 2> /dev/null
    if command -v devmem > /dev/null; then
      devmem 0x0f017008 32 0
      devmem 0x0f017004 32 1
      devmem 0x0f017010 32 0xfffff
      devmem 0x0f017014 32 0xfffff
      devmem 0x0f017008 32 1
    fi
    modprobe qcom_wdt || log_warning_msg "pro1x-loop-root: no watchdog for this start"
  fi
fi

[ -f "/host$IMAGE" ] || panic "pro1x-loop-root: /host$IMAGE does not exist"

# Loop device deterministically on loop0, so that root=/dev/loop0 matches.
[ -b /dev/loop0 ] || mknod /dev/loop0 b 7 0
losetup /dev/loop0 "/host$IMAGE" \
  || panic "pro1x-loop-root: losetup on /host$IMAGE failed"

# A Btrfs image (Arch): the root is its subvolume @, or a snapshot of it,
# mounted read-only below a RAM overlay (init-bottom/pro1x-overlay-root);
# initramfs-tools mounts the root with what /conf/param.conf says
if [ "$(blkid -o value -s TYPE /dev/loop0 2>/dev/null)" = btrfs ]; then
  modprobe btrfs 2>/dev/null
  echo "ROOTFSTYPE=btrfs" >> /conf/param.conf
  echo "ROOTFLAGS='-o subvol=${SUBVOL:-@},noatime,compress=zstd:1'" >> /conf/param.conf
  [ -z "${SUBVOL:-}" ] || : > /conf/pro1x-overlay
fi

exit 0
