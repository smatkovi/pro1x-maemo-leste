# F(x)tec Pro1X (sourced by Xsession): after a start by the RTC alarm
# (docs/alarm-power-on.md), pro1x-alarmboot shows the N9's alarm screen
# over the system UI's alarm dialog, rings by itself should no dialog
# come, then switches the phone off again as the N9 did; it ends at once
# after any other start (tools/pro1x-alarmboot, package pro1x-alarmboot
# from scripts/mkdeb-tools.sh). Before the system UI (03osso-systemui), so
# that it sees the dialog of an alarm already due come up. What it did:
# /tmp/pro1x-alarmboot.log.
if [ -x /usr/bin/pro1x-alarmboot ]; then
	/usr/bin/pro1x-alarmboot -v > /dev/null 2> /tmp/pro1x-alarmboot.log &
fi
