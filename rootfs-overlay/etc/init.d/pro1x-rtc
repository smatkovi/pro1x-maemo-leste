#!/sbin/openrc-run
# The real time across power off (tools/pro1x-rtc): the PMIC's RTC cannot be
# set, so the clock comes from the RTC plus the offset saved at shutdown.

description="Clock from the Pro1X RTC and its saved offset"

depend() {
	after hwclock fake-hwclock
	before clockd alarmd
}

start() {
	ebegin "Setting the clock from the RTC"
	# rtc-pm8xxx is a module: rtc0 comes late in the boot (about 17 s), and
	# its registration sets the clock to the RTC's own count (hctosys).
	# Without it the offset never went on top, and the clock stayed at the
	# last shutdown's time. So wait for it (at most 30 s), and a moment
	# more for that, before clockd and alarmd start.
	i=0
	while [ ! -e /sys/class/rtc/rtc0 ] && [ $i -lt 60 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	sleep 1
	/usr/local/sbin/pro1x-rtc-sync restore
	eend 0
}

stop() {
	ebegin "Saving the RTC offset"
	# also next to the system images, for the other systems (FreeBSD gets
	# it from the boot menu as hint.qcom_rtc.0.offset)
	/usr/local/sbin/pro1x-rtc-sync save
	# A wake alarm (alarmd, or timed in the MeeGo boot) stays set: when it
	# switches the phone on, the boot menu starts this system at once
	# (pro1x-boot alarm-check in the initramfs, docs/alarm-power-on.md).
	# Nothing to note here: the menu sees which system set it. (Before, a
	# one-shot "pro1x-boot next" for this system went here, which also sent
	# a start by the power key there.)
	eend 0
}
