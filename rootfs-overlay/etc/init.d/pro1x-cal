#!/sbin/openrc-run
# CAL area for Maemo on the Pro1X.
#
# Maemo keeps the device lock code (libdevlock) and a few other settings in
# "CAL", which libcal reads and writes through /dev/mtd1 -- the CAL partition
# of the N900's NAND. The Pro1X has no NAND, so a 512 KiB file on userdata
# (four 128 KiB erase blocks, initially 0xFF like erased flash) is
# attached through a loop device and block2mtd; the udev rule
# 83-pro1x-cal.rules gives that MTD device the name /dev/mtd1.

description="CAL area (device lock code) for Maemo, emulated with block2mtd"

CAL_IMAGE=/host/pro1x-cal.img
CAL_SIZE=524288          # 512 KiB: libcal needs at least three erase blocks
ERASE_SIZE=131072        # 128 KiB, as on the N900

depend() {
	after localmount mountall udev
	before mce dsme
}

start() {
	ebegin "Attaching the CAL area"
	if [ ! -e "$CAL_IMAGE" ]; then
		# Fresh area: all 0xFF, which libcal sees as empty flash.
		dd if=/dev/zero bs="$CAL_SIZE" count=1 2>/dev/null |
			tr '\000' '\377' > "$CAL_IMAGE" || { eend 1 "cannot create $CAL_IMAGE"; return 1; }
	fi
	loop=$(losetup -j "$CAL_IMAGE" | cut -d: -f1)
	[ -n "$loop" ] || loop=$(losetup -f --show "$CAL_IMAGE") || { eend 1 "losetup failed"; return 1; }
	if ! grep -q "block2mtd: $loop" /proc/mtd 2>/dev/null; then
		modprobe block2mtd "block2mtd=$loop,$ERASE_SIZE" || { eend 1 "block2mtd failed"; return 1; }
	fi
	udevadm settle -t 5
	eend 0
}

stop() {
	# block2mtd devices cannot be removed one by one; the module goes away.
	modprobe -r block2mtd 2>/dev/null
	loop=$(losetup -j "$CAL_IMAGE" | cut -d: -f1)
	[ -n "$loop" ] && losetup -d "$loop"
	sync
	return 0
}
