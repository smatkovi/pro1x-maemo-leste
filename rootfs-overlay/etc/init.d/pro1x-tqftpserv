#!/sbin/openrc-run
# TFTP server over QRTR: serves the modem its firmware files (among others
# wlanmdsp.mbn for the Wi-Fi, which on the SM6115 runs through the modem).
# Debian only ships a systemd unit; qrtr-ns is part of the kernel.

description="QRTR TFTP service (firmware for the modem)"
command=/usr/bin/tqftpserv
supervisor=supervise-daemon
respawn_delay=1
respawn_max=0

depend() {
	after localmount mountall
	before pro1x-rmtfs
}
