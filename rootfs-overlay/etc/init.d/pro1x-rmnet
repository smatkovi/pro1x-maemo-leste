#!/sbin/openrc-run
# Creates the rmnet data channels on top of the IPA modem interface.
#
# oFono 2.18 (udevng, driver "qrtrsoc") only sets up an embedded Qualcomm
# modem if at least three rmnet_dataN links already exist on rmnet_ipa0, with
# mux id N+1. It does not create them itself.

description="rmnet data channels for the Pro1X modem (oFono qrtrsoc)"

depend() {
	after pro1x-rmtfs
	before ofono
}

start() {
	ebegin "Creating rmnet_data0..3 on rmnet_ipa0"
	modprobe -q rmnet
	i=0
	while [ "$i" -lt 30 ] && [ ! -e /sys/class/net/rmnet_ipa0 ]; do
		i=$((i + 1))
		sleep 1
	done
	ip link set rmnet_ipa0 up || { eend 1 "rmnet_ipa0 missing"; return 1; }
	for n in 0 1 2 3; do
		[ -e "/sys/class/net/rmnet_data$n" ] ||
			ip link add link rmnet_ipa0 name "rmnet_data$n" type rmnet mux_id $((n + 1))
	done
	eend $?
}

stop() {
	for n in 0 1 2 3; do
		ip link del "rmnet_data$n" 2>/dev/null
	done
	return 0
}
