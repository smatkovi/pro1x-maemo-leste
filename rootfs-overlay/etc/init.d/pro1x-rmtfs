#!/sbin/openrc-run
# Qualcomm remote filesystem service: provides modemst1/2, fsg and fsc to the
# modem and starts it (-s). Without a running modem the Pro1X has neither
# cellular nor Wi-Fi.
#
# -r: read-only -- the modem's writes stay in RAM, the partitions (IMEI,
# calibration) are never modified. The NixOS port does the same.

description="Qualcomm remote filesystem service (modemst1/2, fsg, fsc)"
command=/usr/bin/rmtfs
command_args="-r -P -s"
supervisor=supervise-daemon
respawn_delay=1
respawn_max=0

depend() {
	need pro1x-tqftpserv
	after localmount mountall
	before ofono
}

start_pre() {
	modprobe -q rmtfs_mem
	# The modem remoteproc instance only appears once qcom_q6v5_pas is loaded.
	i=0
	while [ "$i" -lt 60 ]; do
		for n in /sys/class/remoteproc/*/name; do
			[ -r "$n" ] && [ "$(cat "$n")" = modem ] && return 0
		done
		i=$((i + 1))
		sleep 1
	done
	eerror "modem remoteproc not found"
	return 1
}
