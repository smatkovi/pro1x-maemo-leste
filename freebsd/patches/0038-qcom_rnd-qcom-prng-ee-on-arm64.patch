-/* Driver for Qualcomm MSM entropy device. */
+/*
+ * Driver for Qualcomm MSM entropy device.
+ *
+ * "qcom,prng": the whole PRNG, set up here when nobody did (IPQ4018).
+ * "qcom,prng-ee": its execution environment's window, as on the SM6115
+ * (F(x)tec Pro1X): TrustZone set it up and owns its configuration, the
+ * clock is voted on around each read in the GCC the node's "clocks" names
+ * (FreeBSD has no clock driver for it), a word of zero or the same word
+ * twice fails the read (qcom_rnd_ee.h). Three failed reads in a row and
+ * the source gives nothing any more.
+ */
 
 #include <sys/param.h>
 #include <sys/kernel.h>
@@ -35,6 +46,14 @@
 #include <sys/random.h>
 #include <sys/stdatomic.h>
 
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/rman.h>
+#include <sys/sysctl.h>
+
+#include <vm/vm.h>
+#include <vm/pmap.h>
+
 #include <machine/bus.h>
 #include <machine/resource.h>
 #include <sys/bus.h>
@@ -42,16 +61,37 @@
 #include <dev/fdt/fdt_common.h>
 #include <dev/ofw/ofw_bus.h>
 #include <dev/ofw/ofw_bus_subr.h>
+#include <dev/ofw/ofw_subr.h>
+#include <dev/ofw/openfirm.h>
 
 #include <dev/random/randomdev.h>
 #include <dev/random/random_harvestq.h>
 
 #include <dev/qcom_rnd/qcom_rnd_reg.h>
+#include <dev/qcom_rnd/qcom_rnd_ee.h>
+
+/* gcc-sm6115.c's gcc_prng_ahb_clk */
+static const struct qcom_rnd_clk qcom_rnd_clks[] = {
+	{ "qcom,gcc-sm6115", 0x79004, 13, 0x21004 },
+};
+
+static struct ofw_compat_data compat_data[] = {
+	{ "qcom,prng",		1 },
+	{ "qcom,prng-ee",	2 },
+	{ NULL,			0 }
+};
 
 struct qcom_rnd_softc {
 	device_t	 dev;
 	int		reg_rid;
 	struct resource	*reg;
+	bool		 ee;		/* qcom,prng-ee */
+	struct qcom_rnd_ee e;
+	void		*gcc;		/* the GCC's registers (ee with a clock) */
+	vm_size_t	 gcc_size;
+	struct mtx	 mtx;
+	u_int		 failed;	/* failed reads in a row */
+	bool		 dead;
 };
 
 static int	qcom_rnd_modevent(module_t, int, void *);
@@ -99,10 +139,91 @@
 		return (ENXIO);
 	}
 
-	if (ofw_bus_is_compatible(dev, "qcom,prng") == 0) {
+	if (ofw_bus_search_compatible(dev, compat_data)->ocd_data == 0) {
 		return (ENXIO);
 	}
 
+	device_set_desc(dev, "Qualcomm PRNG");
+	return (0);
+}
+
+static uint32_t
+qcom_rnd_ee_prng_rd(void *ctx, uint32_t off)
+{
+	struct qcom_rnd_softc *sc = ctx;
+
+	return (bus_read_4(sc->reg, off));
+}
+
+static uint32_t
+qcom_rnd_ee_gcc_rd(void *ctx, uint32_t off)
+{
+	struct qcom_rnd_softc *sc = ctx;
+
+	return (*(volatile uint32_t *)((char *)sc->gcc + off));
+}
+
+static void
+qcom_rnd_ee_gcc_wr(void *ctx, uint32_t off, uint32_t v)
+{
+	struct qcom_rnd_softc *sc = ctx;
+
+	*(volatile uint32_t *)((char *)sc->gcc + off) = v;
+	wmb();
+}
+
+static void
+qcom_rnd_ee_delay(void *ctx, int us)
+{
+	DELAY(us);
+}
+
+/* the GCC the node's "clocks" names, if this driver knows it */
+static int
+qcom_rnd_ee_setup(struct qcom_rnd_softc *sc)
+{
+	struct sysctl_ctx_list *ctx;
+	struct sysctl_oid_list *kids;
+	pcell_t cells[2];
+	phandle_t gcc;
+	bus_addr_t pa;
+	bus_size_t size;
+	u_int i;
+
+	sc->e = (struct qcom_rnd_ee){ .prng_rd = qcom_rnd_ee_prng_rd,
+	    .gcc_rd = qcom_rnd_ee_gcc_rd, .gcc_wr = qcom_rnd_ee_gcc_wr,
+	    .delay = qcom_rnd_ee_delay, .ctx = sc };
+	if (OF_getencprop(ofw_bus_get_node(sc->dev), "clocks", cells,
+	    sizeof(cells)) >= (ssize_t)sizeof(cells[0])) {
+		gcc = OF_node_from_xref(cells[0]);
+		for (i = 0; i < nitems(qcom_rnd_clks); i++)
+			if (ofw_bus_node_is_compatible(gcc,
+			    qcom_rnd_clks[i].gcc_compat))
+				break;
+		if (i == nitems(qcom_rnd_clks) ||
+		    ofw_reg_to_paddr(gcc, 0, &pa, &size, NULL) != 0) {
+			device_printf(sc->dev,
+			    "its clock's controller is not known here\n");
+			return (ENXIO);
+		}
+		sc->gcc = pmap_mapdev(pa, size);
+		sc->gcc_size = size;
+		sc->e.clk = &qcom_rnd_clks[i];
+	}
+	ctx = device_get_sysctl_ctx(sc->dev);
+	kids = SYSCTL_CHILDREN(device_get_sysctl_tree(sc->dev));
+	SYSCTL_ADD_U32(ctx, kids, OID_AUTO, "words", CTLFLAG_RD,
+	    &sc->e.words, 0, "Words read");
+	SYSCTL_ADD_U32(ctx, kids, OID_AUTO, "zeros", CTLFLAG_RD,
+	    &sc->e.zeros, 0, "Reads failed by a word of zero");
+	SYSCTL_ADD_U32(ctx, kids, OID_AUTO, "timeouts", CTLFLAG_RD,
+	    &sc->e.timeouts, 0, "Reads failed by no word in 10 ms");
+	SYSCTL_ADD_U32(ctx, kids, OID_AUTO, "repeats", CTLFLAG_RD,
+	    &sc->e.repeats, 0, "Reads failed by a word as the one before");
+	SYSCTL_ADD_U32(ctx, kids, OID_AUTO, "clock_stuck", CTLFLAG_RD,
+	    &sc->e.clock_stuck, 0, "Reads failed by a clock that did not come on");
+	SYSCTL_ADD_BOOL(ctx, kids, OID_AUTO, "dead", CTLFLAG_RD,
+	    &sc->dead, 0, "Not used any more (three failed reads in a row)");
 	return (0);
 }
 
@@ -126,14 +247,41 @@
 	}
 
 	sc->reg_rid = 0;
-	sc->reg = bus_alloc_resource_anywhere(dev, SYS_RES_MEMORY,
-	    &sc->reg_rid, 0x140, RF_ACTIVE);
+	sc->ee = ofw_bus_search_compatible(dev, compat_data)->ocd_data == 2;
+	if (sc->ee)
+		sc->reg = bus_alloc_resource_any(dev, SYS_RES_MEMORY,
+		    &sc->reg_rid, RF_ACTIVE);
+	else
+		sc->reg = bus_alloc_resource_anywhere(dev, SYS_RES_MEMORY,
+		    &sc->reg_rid, 0x140, RF_ACTIVE);
 	if (sc->reg == NULL) {
 		device_printf(dev, "Couldn't allocate memory resource!\n");
+		atomic_store_explicit(&g_qcom_rnd_softc, NULL,
+		    memory_order_release);
 		return (ENXIO);
 	}
+	mtx_init(&sc->mtx, "qcom_rnd", NULL, MTX_DEF);
 
-	device_set_desc(dev, "Qualcomm PRNG");
+	if (sc->ee) {
+		uint32_t probe[2];
+
+		/* TrustZone's: its configuration is not touched */
+		if (qcom_rnd_ee_setup(sc) != 0 ||
+		    qcom_rnd_ee_read(&sc->e, probe, sizeof(probe)) == 0) {
+			device_printf(dev, "the execution environment's window "
+			    "gives no words (zeros %u, timeouts %u, repeats %u, "
+			    "clock stuck %u): not used\n", sc->e.zeros,
+			    sc->e.timeouts, sc->e.repeats, sc->e.clock_stuck);
+			qcom_rnd_detach(dev);
+			return (ENXIO);
+		}
+		explicit_bzero(probe, sizeof(probe));
+		device_printf(dev, "the execution environment's window, %s\n",
+		    sc->e.clk != NULL ? "its clock voted around each read" :
+		    "no clock of its own");
+		random_source_register(&random_qcom_rnd);
+		return (0);
+	}
 
 	/*
 	 * Check to see whether the PRNG has already been setup or not.
@@ -176,6 +324,12 @@
 	random_source_deregister(&random_qcom_rnd);
 	if (sc->reg != NULL) {
 		bus_release_resource(sc->dev, SYS_RES_MEMORY, sc->reg_rid, sc->reg);
+		sc->reg = NULL;
+		mtx_destroy(&sc->mtx);
+	}
+	if (sc->gcc != NULL) {
+		pmap_unmapdev(sc->gcc, sc->gcc_size);
+		sc->gcc = NULL;
 	}
 	atomic_store_explicit(&g_qcom_rnd_softc, NULL, memory_order_release);
 	return (0);
@@ -195,6 +349,27 @@
 	size_t rz = 0;
 	uint32_t reg;
 
+	if (sc->ee) {
+		if (sc->dead)
+			return (EAGAIN);
+		mtx_lock(&sc->mtx);
+		rz = qcom_rnd_ee_read(&sc->e, buf, *sz);
+		if (rz == 0 && ++sc->failed >= 3 && !sc->dead) {
+			sc->dead = true;
+			device_printf(sc->dev, "three failed reads in a row "
+			    "(zeros %u, timeouts %u, repeats %u, clock stuck "
+			    "%u): not used any more\n", sc->e.zeros,
+			    sc->e.timeouts, sc->e.repeats, sc->e.clock_stuck);
+		}
+		if (rz != 0)
+			sc->failed = 0;
+		mtx_unlock(&sc->mtx);
+		if (rz == 0)
+			return (EAGAIN);
+		*sz = rz;
+		return (0);
+	}
+
 	while (rz < *sz) {
 		bus_barrier(sc->reg, 0, 0x120, BUS_SPACE_BARRIER_READ);
 		reg = bus_read_4(sc->reg, QCOM_RND_PRNG_STATUS);
--- /dev/null
+++ b/sys/dev/qcom_rnd/qcom_rnd_ee.h
@@ -0,0 +1,136 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * The Qualcomm PRNG's execution environment window ("qcom,prng-ee", the
+ * SM6115's at 0x1b53000), read the way Linux's drivers/crypto/qcom-rng.c
+ * reads it, its AHB clock voted on in the GCC around each read the way
+ * Linux's clk-branch.c votes a BRANCH_HALT_VOTED branch. Plain C on the
+ * accessors given, so that freebsd/rng/test builds it on the PC against a
+ * model of the registers.
+ *
+ *  - TrustZone set the PRNG up and owns its configuration (LFSR_CFG at
+ *    0x100, CONFIG at 0x104): nothing here touches it (Linux: skip_init)
+ *  - the clock: the vote bit set, then CLK_OFF (CBCR bit 31) clear or the
+ *    NOC FSM's status on within 200 us, nothing waited for while the branch
+ *    is under hardware gating (HW_CTL, CBCR bit 1); the vote back
+ *    afterwards, 10 us
+ *  - a word whenever STATUS says one is there, polled every 200 us for at
+ *    most 10 ms (readl_poll_timeout); a word of zero fails the whole read
+ *  - FIPS 140-2's continuous test (4.9.2): a word as the one before fails
+ *    the read too
+ */
+#ifndef _QCOM_RND_EE_H_
+#define _QCOM_RND_EE_H_
+
+#define	QCOM_RND_EE_DATA_OUT		0x000
+#define	QCOM_RND_EE_STATUS		0x004
+#define	QCOM_RND_EE_DATA_AVAIL		(1u << 0)
+
+#define	QCOM_RND_CBCR_CLK_OFF		(1u << 31)
+#define	QCOM_RND_CBCR_FSM(v)		(((v) >> 28) & 7)
+#define	QCOM_RND_CBCR_FSM_ON		2
+#define	QCOM_RND_CBCR_HW_CTL		(1u << 1)
+
+/* the PRNG's AHB clock in a GCC: its vote register and bit, its CBCR */
+struct qcom_rnd_clk {
+	const char	*gcc_compat;
+	uint32_t	vote;
+	uint32_t	bit;
+	uint32_t	cbcr;
+};
+
+struct qcom_rnd_ee {
+	uint32_t	(*prng_rd)(void *ctx, uint32_t off);
+	uint32_t	(*gcc_rd)(void *ctx, uint32_t off);
+	void		(*gcc_wr)(void *ctx, uint32_t off, uint32_t v);
+	void		(*delay)(void *ctx, int us);
+	void		*ctx;
+	const struct qcom_rnd_clk *clk;	/* NULL: no clock of its own */
+	uint32_t	last;		/* the continuous test's word */
+	bool		has_last;
+	/* what happened */
+	uint32_t	words, zeros, timeouts, clock_stuck, repeats;
+};
+
+static inline bool
+qcom_rnd_ee_clock_on(struct qcom_rnd_ee *e)
+{
+	const struct qcom_rnd_clk *c = e->clk;
+	uint32_t v;
+	int i;
+
+	if (c == NULL)
+		return (true);
+	e->gcc_wr(e->ctx, c->vote, e->gcc_rd(e->ctx, c->vote) | 1u << c->bit);
+	for (i = 0; i <= 200; i++) {
+		v = e->gcc_rd(e->ctx, c->cbcr);
+		if ((v & QCOM_RND_CBCR_HW_CTL) != 0 ||
+		    (v & QCOM_RND_CBCR_CLK_OFF) == 0 ||
+		    QCOM_RND_CBCR_FSM(v) == QCOM_RND_CBCR_FSM_ON)
+			return (true);
+		e->delay(e->ctx, 1);
+	}
+	e->clock_stuck++;
+	e->gcc_wr(e->ctx, c->vote, e->gcc_rd(e->ctx, c->vote) & ~(1u << c->bit));
+	return (false);
+}
+
+static inline void
+qcom_rnd_ee_clock_off(struct qcom_rnd_ee *e)
+{
+	const struct qcom_rnd_clk *c = e->clk;
+
+	if (c == NULL)
+		return;
+	e->gcc_wr(e->ctx, c->vote, e->gcc_rd(e->ctx, c->vote) & ~(1u << c->bit));
+	e->delay(e->ctx, 10);
+}
+
+/* len bytes, or 0 (and buf cleared) when the read failed */
+static inline size_t
+qcom_rnd_ee_read(struct qcom_rnd_ee *e, void *buf, size_t len)
+{
+	uint8_t *out = buf;
+	size_t done, n;
+	uint32_t v;
+	int t;
+	bool ok = true;
+
+	if (!qcom_rnd_ee_clock_on(e))
+		return (0);
+	for (done = 0; done < len && ok; done += n) {
+		for (t = 0; t <= 50 && (e->prng_rd(e->ctx, QCOM_RND_EE_STATUS) &
+		    QCOM_RND_EE_DATA_AVAIL) == 0; t++)
+			e->delay(e->ctx, 200);
+		if (t > 50) {
+			e->timeouts++;
+			ok = false;
+			break;
+		}
+		v = e->prng_rd(e->ctx, QCOM_RND_EE_DATA_OUT);
+		if (v == 0) {
+			e->zeros++;
+			ok = false;
+			break;
+		}
+		if (e->has_last && v == e->last) {
+			e->repeats++;
+			ok = false;
+			break;
+		}
+		e->last = v;
+		e->has_last = true;
+		e->words++;
+		n = len - done < 4 ? len - done : 4;
+		memcpy(out + done, &v, n);
+	}
+	qcom_rnd_ee_clock_off(e);
+	v = 0;
+	if (!ok) {
+		memset(buf, 0, len);
+		return (0);
+	}
+	return (len);
+}
+
+#endif /* _QCOM_RND_EE_H_ */
