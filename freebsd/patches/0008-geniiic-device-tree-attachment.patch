From 2712ff741f0edb93e8b1cd6c18cd3c2b5194446f Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Sun, 25 Oct 2026 18:28:27 +0100
Subject: [PATCH 1/2] geniiic: device tree attachment, QUP v3 wrapper bus

The GENI I2C driver had only an ACPI attachment and no build entries.
geni_iic_fdt.c attaches it to qcom,geni-i2c nodes, refuses serial
engines without FIFO access (GPI DMA only) and leaves the engine's DMA
mode; qcom_geni_qup.c makes the serial engines under a
qcom,geni-se-qup wrapper visible. The ACPI iicbus attachment is built
only with ACPI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/arm64/qualcomm/qcom_geni_qup.c            |  46 +++++
 sys/conf/files.arm64                          |   3 +
 sys/dev/iicbus/controller/qcom/geni_iic.c     |   2 +
 sys/dev/iicbus/controller/qcom/geni_iic_fdt.c | 188 ++++++++++++++++++
 4 files changed, 239 insertions(+)
 create mode 100644 sys/arm64/qualcomm/qcom_geni_qup.c
 create mode 100644 sys/dev/iicbus/controller/qcom/geni_iic_fdt.c

diff --git a/sys/arm64/qualcomm/qcom_geni_qup.c b/sys/arm64/qualcomm/qcom_geni_qup.c
new file mode 100644
index 000000000..fd526b2ca
--- /dev/null
+++ b/sys/arm64/qualcomm/qcom_geni_qup.c
@@ -0,0 +1,46 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Qualcomm QUP v3 wrapper ("qcom,geni-se-qup"): the common block in front
+ * of a group of GENI serial engines (I2C, SPI, UART), whose nodes are its
+ * children. Its clocks are left as the boot set them; as a bus it only
+ * makes the serial engines visible.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/module.h>
+
+#include <dev/fdt/simplebus.h>
+#include <dev/ofw/ofw_bus.h>
+#include <dev/ofw/ofw_bus_subr.h>
+
+static int
+qcom_geni_qup_probe(device_t dev)
+{
+	if (!ofw_bus_status_okay(dev))
+		return (ENXIO);
+	if (!ofw_bus_is_compatible(dev, "qcom,geni-se-qup"))
+		return (ENXIO);
+	device_set_desc(dev, "Qualcomm QUP v3 wrapper");
+	return (BUS_PROBE_DEFAULT);
+}
+
+static int
+qcom_geni_qup_attach(device_t dev)
+{
+	return (simplebus_attach(dev));
+}
+
+static device_method_t qcom_geni_qup_methods[] = {
+	DEVMETHOD(device_probe,		qcom_geni_qup_probe),
+	DEVMETHOD(device_attach,	qcom_geni_qup_attach),
+	DEVMETHOD_END
+};
+
+DEFINE_CLASS_1(qcom_geni_qup, qcom_geni_qup_driver, qcom_geni_qup_methods,
+    sizeof(struct simplebus_softc), simplebus_driver);
+EARLY_DRIVER_MODULE(qcom_geni_qup, simplebus, qcom_geni_qup_driver, 0, 0,
+    BUS_PASS_BUS + BUS_PASS_ORDER_MIDDLE);
