diff --git a/sys/dev/iicbus/controller/qcom/geni_iic_fdt.c b/sys/dev/iicbus/controller/qcom/geni_iic_fdt.c
new file mode 100644
index 000000000..59ff00ca6
--- /dev/null
+++ b/sys/dev/iicbus/controller/qcom/geni_iic_fdt.c
@@ -0,0 +1,188 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Device tree attachment of the Qualcomm GENI I2C controller.
+ *
+ * As with the ACPI attachment, the serial engine is used as the boot left
+ * it: firmware loaded, clocks on, the bus timing programmed (on the F(x)tec
+ * Pro1X, Linux before kexec). The driver works the FIFOs; an engine that
+ * the firmware set up for GPI DMA only (no FIFO access) is refused.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/module.h>
+#include <sys/mutex.h>
+#include <sys/rman.h>
+#include <sys/sx.h>
+
+#include <machine/bus.h>
+#include <machine/resource.h>
+
+#include <dev/iicbus/iicbus.h>
+#include <dev/iicbus/iiconf.h>
+#include <dev/ofw/ofw_bus.h>
+#include <dev/ofw/ofw_bus_subr.h>
+
+#include <dev/iicbus/controller/qcom/geni_iic_var.h>
+
+#include "ofw_bus_if.h"
+
+#define	GENI_IF_DISABLE_RO	0x064
+#define	 FIFO_IF_DISABLE	(1u << 0)
+#define	GENI_FW_REVISION_RO	0x068
+#define	 FW_REV_PROTOCOL(x)	(((x) >> 8) & 0xff)
+#define	 GENI_SE_I2C		3
+#define	GENI_DMA_MODE_EN	0x258
+#define	 DMA_MODE_EN		(1u << 0)
+
+static struct ofw_compat_data compat_data[] = {
+	{ "qcom,geni-i2c",	1 },
+	{ NULL,			0 }
+};
+
+static int geniiic_fdt_detach(device_t dev);
+
+static int
+geniiic_fdt_probe(device_t dev)
+{
+	if (!ofw_bus_status_okay(dev))
+		return (ENXIO);
+	if (ofw_bus_search_compatible(dev, compat_data)->ocd_data == 0)
+		return (ENXIO);
+	device_set_desc(dev, "Qualcomm GENI I2C Controller");
+	return (BUS_PROBE_DEFAULT);
+}
+
+static int
+geniiic_fdt_attach(device_t dev)
+{
+	geniiic_softc_t *sc = device_get_softc(dev);
+	uint32_t fw;
+	int error;
+
+	sc->dev = dev;
+	sc->regs_rid = 0;
+	sc->regs_res = bus_alloc_resource_any(dev, SYS_RES_MEMORY,
+	    &sc->regs_rid, RF_ACTIVE);
+	if (sc->regs_res == NULL) {
+		device_printf(dev, "unable to map registers\n");
+		return (ENXIO);
+	}
+
+	/* The first access: it hangs the bus if the engine's clocks are off. */
+	device_printf(dev, "registers at %#jx\n",
+	    (uintmax_t)rman_get_start(sc->regs_res));
+	fw = bus_read_4(sc->regs_res, GENI_FW_REVISION_RO);
+	if (FW_REV_PROTOCOL(fw) != GENI_SE_I2C) {
+		device_printf(dev, "serial engine runs protocol %u, not I2C\n",
+		    FW_REV_PROTOCOL(fw));
+		geniiic_fdt_detach(dev);
+		return (ENXIO);
+	}
+	if (bus_read_4(sc->regs_res, GENI_IF_DISABLE_RO) & FIFO_IF_DISABLE) {
+		device_printf(dev, "FIFOs disabled (GPI DMA only), "
+		    "not supported\n");
+		geniiic_fdt_detach(dev);
+		return (ENXIO);
+	}
+	/* Linux may have left the engine in its DMA mode. */
+	bus_write_4(sc->regs_res, GENI_DMA_MODE_EN,
+	    bus_read_4(sc->regs_res, GENI_DMA_MODE_EN) & ~DMA_MODE_EN);
+
+	sc->intr_rid = 0;
+	sc->intr_res = bus_alloc_resource_any(dev, SYS_RES_IRQ, &sc->intr_rid,
+	    RF_ACTIVE);
+	if (sc->intr_res == NULL) {
+		device_printf(dev, "unable to map interrupt\n");
+		geniiic_fdt_detach(dev);
+		return (ENXIO);
+	}
+	sc->platform_attached = true;
+
+	error = geniiic_attach(sc);
+	if (error != 0)
+		geniiic_fdt_detach(dev);
+	return (error);
+}
+
+static int
+geniiic_fdt_detach(device_t dev)
+{
+	geniiic_softc_t *sc = device_get_softc(dev);
+	int error;
+
+	if (sc->platform_attached) {
+		error = geniiic_detach(sc);
+		if (error != 0)
+			return (error);
+		sc->platform_attached = false;
+	}
+	if (sc->intr_res != NULL) {
+		bus_release_resource(dev, SYS_RES_IRQ, sc->intr_rid,
+		    sc->intr_res);
+		sc->intr_res = NULL;
+	}
+	if (sc->regs_res != NULL) {
+		bus_release_resource(dev, SYS_RES_MEMORY, sc->regs_rid,
+		    sc->regs_res);
+		sc->regs_res = NULL;
+	}
+	return (0);
+}
+
+static int
+geniiic_fdt_suspend(device_t dev)
+{
+	return (geniiic_suspend(device_get_softc(dev)));
+}
+
+static int
+geniiic_fdt_resume(device_t dev)
+{
+	return (geniiic_resume(device_get_softc(dev)));
+}
+
+static phandle_t
+geniiic_fdt_get_node(device_t bus, device_t dev)
+{
+	/* The iicbus child describes the bus with our node. */
+	return (ofw_bus_get_node(bus));
+}
+
+static device_method_t geniiic_fdt_methods[] = {
+	DEVMETHOD(device_probe,		geniiic_fdt_probe),
+	DEVMETHOD(device_attach,	geniiic_fdt_attach),
+	DEVMETHOD(device_detach,	geniiic_fdt_detach),
+	DEVMETHOD(device_suspend,	geniiic_fdt_suspend),
+	DEVMETHOD(device_resume,	geniiic_fdt_resume),
+
+	DEVMETHOD(bus_setup_intr,	bus_generic_setup_intr),
+	DEVMETHOD(bus_teardown_intr,	bus_generic_teardown_intr),
+	DEVMETHOD(bus_alloc_resource,	bus_generic_alloc_resource),
+	DEVMETHOD(bus_release_resource,	bus_generic_release_resource),
+	DEVMETHOD(bus_activate_resource, bus_generic_activate_resource),
+	DEVMETHOD(bus_deactivate_resource, bus_generic_deactivate_resource),
+	DEVMETHOD(bus_adjust_resource,	bus_generic_adjust_resource),
+
+	DEVMETHOD(iicbus_transfer,	geniiic_transfer),
+	DEVMETHOD(iicbus_reset,		geniiic_reset),
+	DEVMETHOD(iicbus_callback,	geniiic_callback),
+
+	DEVMETHOD(ofw_bus_get_node,	geniiic_fdt_get_node),
+
+	DEVMETHOD_END
+};
+
+static driver_t geniiic_fdt_driver = {
+	"geniiic",
+	geniiic_fdt_methods,
+	sizeof(struct geniiic_softc),
+};
+
+DRIVER_MODULE(geniiic, simplebus, geniiic_fdt_driver, 0, 0);
+DRIVER_MODULE(ofw_iicbus, geniiic, ofw_iicbus_driver, 0, 0);
+MODULE_DEPEND(geniiic, iicbus, IICBUS_MINVER, IICBUS_PREFVER, IICBUS_MAXVER);
-- 
