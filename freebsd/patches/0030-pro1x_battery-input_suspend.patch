From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 28 Oct 2026 23:30:00 +0100
Subject: [PATCH] pro1x_battery: input_suspend (dev.pro1x_battery.0.input_suspend)

The charger's USB input suspended (PMI632 smb5 USBIN_CMD_IL), as Linux's
pro1x-charger-icl input_suspend: the phone on its battery with a cable in,
for standby measurements on a hub that cannot switch its ports' power.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/sys/dev/qcom_spmi/pro1x_battery.c b/sys/dev/qcom_spmi/pro1x_battery.c
--- a/sys/dev/qcom_spmi/pro1x_battery.c
+++ b/sys/dev/qcom_spmi/pro1x_battery.c
@@ -424,6 +424,35 @@
 /* --- sysctl ------------------------------------------------------------ */
 
 static int
+sysctl_status(SYSCTL_HANDLER_ARGS);
+
+/*
+ * The charger's USB input suspended (PMI632 smb5 USBIN_CMD_IL, as Linux's
+ * pro1x-charger-icl input_suspend): the phone runs from its battery with
+ * the cable in, for standby measurements on a hub that cannot switch its
+ * ports' power. The bit outlives a reboot: whoever sets it clears it.
+ */
+#define	PMI632_USBIN_CMD_IL	0x1340
+#define	 USBIN_SUSPEND		0x01
+
+static int
+sysctl_input_suspend(SYSCTL_HANDLER_ARGS)
+{
+	struct pro1x_battery_softc *sc = arg1;
+	uint8_t v;
+	int on, error;
+
+	if ((error = qcom_spmi_read(sc->dev, PMI632_USBIN_CMD_IL, &v, 1)) != 0)
+		return (error);
+	on = (v & USBIN_SUSPEND) != 0;
+	error = sysctl_handle_int(oidp, &on, 0, req);
+	if (error != 0 || req->newptr == NULL)
+		return (error);
+	v = on ? (v | USBIN_SUSPEND) : (v & ~USBIN_SUSPEND);
+	return (qcom_spmi_write(sc->dev, PMI632_USBIN_CMD_IL, &v, 1));
+}
+
+static int
 sysctl_status(SYSCTL_HANDLER_ARGS)
 {
 	struct pro1x_battery_softc *sc = arg1;
@@ -627,6 +656,9 @@
 	    "Open-circuit voltage estimate (uV)");
 	SYSCTL_ADD_INT(ctx, tree, OID_AUTO, "current", CTLFLAG_RD, &sc->i_f,
 	    0, "Battery current, filtered (uA, positive discharging)");
+	SYSCTL_ADD_PROC(ctx, tree, OID_AUTO, "input_suspend", CTLTYPE_INT |
+	    CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 0, sysctl_input_suspend, "I",
+	    "The charger's USB input suspended: on the battery with a cable in");
 	SYSCTL_ADD_UINT(ctx, tree, OID_AUTO, "esr", CTLFLAG_RW, &sc->esr_mohm,
 	    0, "Internal resistance for the load compensation (mOhm)");
 	SYSCTL_ADD_INT(ctx, tree, OID_AUTO, "esr_learn", CTLFLAG_RW,
