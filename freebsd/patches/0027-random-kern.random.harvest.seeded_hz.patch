From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 21:59:19 +0100
Subject: [PATCH 6/7] random: kern.random.harvest.seeded_hz

Once seeded, the harvest thread may run fewer than 10 times a second:
a phone sets 1 and wakes once a second instead of ten times; every pool
still gets its share each second (all of them per run instead of a
tenth). Before seeding it stays at 10 Hz for a quick seed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/dev/random/random_harvestq.c | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/sys/dev/random/random_harvestq.c b/sys/dev/random/random_harvestq.c
index 0e90b4d6e..adb51949d 100644
--- a/sys/dev/random/random_harvestq.c
+++ b/sys/dev/random/random_harvestq.c
@@ -122,6 +122,27 @@ static CK_LIST_HEAD(sources_head, random_sources) source_list =
 SYSCTL_NODE(_kern_random, OID_AUTO, harvest, CTLFLAG_RW | CTLFLAG_MPSAFE, 0,
     "Entropy Device Parameters");
 
+/*
+ * How often the kthread runs once the PRNG is seeded (before that always
+ * RANDOM_KTHREAD_HZ, for a quick seed): a phone sets 1, the pools still
+ * get their share every second (all of them per run instead of a tenth),
+ * and the CPU is woken once a second instead of ten times.
+ */
+static u_int random_kthread_seeded_hz = RANDOM_KTHREAD_HZ;
+SYSCTL_UINT(_kern_random_harvest, OID_AUTO, seeded_hz, CTLFLAG_RWTUN,
+    &random_kthread_seeded_hz, 0,
+    "Harvest runs per second once seeded (1-" __XSTRING(RANDOM_KTHREAD_HZ) ")");
+
+static u_int
+random_kthread_hz(void)
+{
+	u_int hz_now = random_kthread_seeded_hz;
+
+	if (!p_random_alg_context->ra_seeded())
+		return (RANDOM_KTHREAD_HZ);
+	return (hz_now < 1 ? 1 : MIN(hz_now, RANDOM_KTHREAD_HZ));
+}
+
 /*
  * Put all the harvest queue context stuff in one place.
  * this make is a bit easier to lock and protect.
@@ -203,7 +224,7 @@ random_kthread(void)
 		}
 		/* XXX: FIX!! This is a *great* place to pass hardware/live entropy to random(9) */
 		tsleep_sbt(&hc->hc_kthread_proc, 0, "-",
-		    SBT_1S/RANDOM_KTHREAD_HZ, 0, C_PREL(1));
+		    SBT_1S / random_kthread_hz(), 0, C_PREL(1));
 	}
 	random_kthread_control = -1;
 	wakeup(&hc->hc_kthread_proc);
@@ -249,7 +270,7 @@ random_sources_feed(void)
 	 * 256 bits * 10 Hz = 2560 bits per second, 320 B/s
 	 *
 	 */
-	npools = howmany(p_random_alg_context->ra_poolcount, RANDOM_KTHREAD_HZ);
+	npools = howmany(p_random_alg_context->ra_poolcount, random_kthread_hz());
 
 	/*-
 	 * If we're not seeded yet, attempt to perform a "full seed", filling
