From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Subject: [PATCH] qcom_spmi: the summary interrupt through the MPM's pin map

Linux's device trees since 6.4 route the arbiter's summary interrupt
through the MPM (qcom,mpm), which FreeBSD has no driver for: the
interrupt could not be set up, the attach failed, and a second attach
found its regions still allocated. Take the GIC SPI from the MPM's
qcom,mpm-pin-map instead (it then does not wake the system from a
suspend), and keep the bus without the summary interrupt rather than
fail: the PMIC's registers work without it.

---
diff --git a/sys/dev/qcom_spmi/qcom_spmi.c b/sys/dev/qcom_spmi/qcom_spmi.c
index 6a8d068..d0db5d6 100644
--- a/sys/dev/qcom_spmi/qcom_spmi.c
+++ b/sys/dev/qcom_spmi/qcom_spmi.c
@@ -673,6 +673,49 @@ qcom_spmi_probe(device_t dev)
 	return (BUS_PROBE_DEFAULT);
 }
 
+/*
+ * The summary interrupt. Linux's device trees since 6.4 route it through the
+ * MPM ("qcom,mpm", the always-on processor's wake-up interrupt controller),
+ * which FreeBSD has no driver for: then the MPM's qcom,mpm-pin-map names the
+ * GIC SPI that pin is wired to, and the interrupt is taken from the GIC
+ * directly (without the MPM it does not wake the system from a suspend).
+ * Otherwise the node's own interrupt.
+ */
+static struct resource *
+qcom_spmi_summary_irq(device_t dev, int *rid)
+{
+	phandle_t node = ofw_bus_get_node(dev), mpm;
+	pcell_t ext[3], gic, map[64], cells[3];
+	ssize_t n;
+	u_int irq;
+	int i;
+
+	if (OF_getencprop(node, "interrupts-extended", ext, sizeof(ext)) ==
+	    sizeof(ext) && (mpm = OF_node_from_xref(ext[0])) > 0 &&
+	    ofw_bus_node_is_compatible(mpm, "qcom,mpm") &&
+	    OF_getencprop(mpm, "interrupt-parent", &gic, sizeof(gic)) ==
+	    sizeof(gic) &&
+	    (n = OF_getencprop(mpm, "qcom,mpm-pin-map", map, sizeof(map))) > 0) {
+		for (i = 0; i + 1 < n / (ssize_t)sizeof(pcell_t); i += 2) {
+			if (map[i] != ext[1])
+				continue;
+			cells[0] = 0;		/* GIC_SPI */
+			cells[1] = map[i + 1];
+			cells[2] = ext[2];	/* the trigger, as for the MPM */
+			irq = ofw_bus_map_intr(dev, gic, 3, cells);
+			*rid = 1;
+			bus_set_resource(dev, SYS_RES_IRQ, *rid, irq, 1);
+			if (bootverbose)
+				device_printf(dev, "summary interrupt: MPM pin "
+				    "%u, GIC SPI %u\n", ext[1], map[i + 1]);
+			return (bus_alloc_resource_any(dev, SYS_RES_IRQ, rid,
+			    RF_ACTIVE));
+		}
+	}
+	*rid = 0;
+	return (bus_alloc_resource_any(dev, SYS_RES_IRQ, rid, RF_ACTIVE));
+}
+
 static int
 qcom_spmi_attach(device_t dev)
 {
@@ -724,14 +767,18 @@ qcom_spmi_attach(device_t dev)
 		    "controller\n");
 		return (ENXIO);
 	}
-	rid = 0;
-	sc->irq = bus_alloc_resource_any(dev, SYS_RES_IRQ, &rid, RF_ACTIVE);
+	/*
+	 * Without the summary interrupt the PMIC's registers still work (the
+	 * RTC, the battery, the power-on reasons); only its interrupts do not
+	 * come. Failing here instead left the bus without its children, and
+	 * a second attach without the regions (still allocated by the first).
+	 */
+	sc->irq = qcom_spmi_summary_irq(dev, &rid);
 	if (sc->irq == NULL || bus_setup_intr(dev, sc->irq,
 	    INTR_TYPE_MISC | INTR_MPSAFE, qcom_spmi_summary, NULL, sc,
-	    &sc->ih) != 0) {
-		device_printf(dev, "unable to set up the summary interrupt\n");
-		return (ENXIO);
-	}
+	    &sc->ih) != 0)
+		device_printf(dev, "unable to set up the summary interrupt: "
+		    "no PMIC interrupts\n");
 
 	for (child = OF_child(node); child > 0; child = OF_peer(child))
 		if (ofw_bus_node_status_okay(child))
