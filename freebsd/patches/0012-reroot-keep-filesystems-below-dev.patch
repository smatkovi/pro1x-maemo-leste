From 9baa6f5d9a625b1208e41f544c0772e294130f2c Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Sun, 25 Oct 2026 18:54:01 +0100
Subject: [PATCH 1/2] reroot: keep the filesystems mounted below /dev

kern_reroot() unmounted everything but /dev and init's temporary
filesystem, which leaves no way to reroot into an md(4) image whose
backing file is on another filesystem. Filesystems mounted below /dev
now stay too, kept out of the mount list while vfs_mountroot() expects
the new root right after /dev.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/kern/kern_shutdown.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/sys/kern/kern_shutdown.c b/sys/kern/kern_shutdown.c
index 38a980106..f068a1856 100644
--- a/sys/kern/kern_shutdown.c
+++ b/sys/kern/kern_shutdown.c
@@ -543,7 +543,8 @@ static int
 kern_reroot(void)
 {
 	struct vnode *oldrootvnode, *vp;
-	struct mount *mp, *devmp;
+	struct mount *mp, *devmp, *kmp, *tmp;
+	TAILQ_HEAD(, mount) keep;
 	int error;
 
 	if (curproc != initproc)
@@ -593,6 +594,17 @@ kern_reroot(void)
 	mtx_lock(&mountlist_mtx);
 	TAILQ_REMOVE(&mountlist, mp, mnt_list);
 	TAILQ_REMOVE(&mountlist, devmp, mnt_list);
+	/*
+	 * Filesystems mounted below /dev stay as well, as /dev does: the new
+	 * root may be an md(4) image in a file on one of them.
+	 */
+	TAILQ_INIT(&keep);
+	TAILQ_FOREACH_SAFE(kmp, &mountlist, mnt_list, tmp) {
+		if (strncmp(kmp->mnt_stat.f_mntonname, "/dev/", 5) == 0) {
+			TAILQ_REMOVE(&mountlist, kmp, mnt_list);
+			TAILQ_INSERT_TAIL(&keep, kmp, mnt_list);
+		}
+	}
 	mtx_unlock(&mountlist_mtx);
 
 	oldrootvnode = rootvnode;
@@ -622,10 +634,16 @@ kern_reroot(void)
 	mountcheckdirs(oldrootvnode, rootvnode);
 
 	/*
-	 * Add the temporary filesystem back and unbusy it.
+	 * Add the temporary filesystem back and unbusy it, and the ones below
+	 * /dev (outside the list while vfs_mountroot() expects the new root
+	 * right after /dev).
 	 */
 	mtx_lock(&mountlist_mtx);
 	TAILQ_INSERT_TAIL(&mountlist, mp, mnt_list);
+	while ((kmp = TAILQ_FIRST(&keep)) != NULL) {
+		TAILQ_REMOVE(&keep, kmp, mnt_list);
+		TAILQ_INSERT_TAIL(&mountlist, kmp, mnt_list);
+	}
 	mtx_unlock(&mountlist_mtx);
 	vfs_unbusy(mp);
 
-- 
2.56.0

