From ef5126ee235608e31c65cfa51c80a7d55cc15649 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Sun, 25 Oct 2026 19:18:00 +0100
Subject: [PATCH] pro1x: /dev/pro1x-host, a mount point below /dev

devfs has no mkdir; a node /dev/pro1x-host/.mnt makes the directory, as
the kernel's reroot/reroot node makes /dev/reroot. The RAM root mounts
userdata there, so that it stays across the reroot.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/arm64/pro1x/ramcons.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/sys/arm64/pro1x/ramcons.c b/sys/arm64/pro1x/ramcons.c
index 623ada663..1fd325a6d 100644
--- a/sys/arm64/pro1x/ramcons.c
+++ b/sys/arm64/pro1x/ramcons.c
@@ -15,6 +15,11 @@
  * screenshot of an unattended test, say) for Linux the same way: at
  * 0x5cc00000 the line "PRO1X-SHOT", its length (32 bits, little endian, at
  * offset 12) and the data from offset 16, up to 3 MiB.
+ *
+ * A node /dev/pro1x-host/.mnt makes the directory /dev/pro1x-host, which
+ * devfs cannot make otherwise (no mkdir): the RAM root mounts userdata
+ * there, below /dev, where it stays across the reroot into the root image
+ * on it (kern_reroot).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -150,6 +155,11 @@ static struct cdevsw shot_cdevsw = {
 	.d_name =	"pro1xshot",
 };
 
+static struct cdevsw mntpt_cdevsw = {
+	.d_version =	D_VERSION,
+	.d_name =	"pro1xmnt",
+};
+
 static void
 shot_init(void *arg)
 {
@@ -159,6 +169,8 @@ shot_init(void *arg)
 	if (shot_buf != NULL)
 		make_dev(&shot_cdevsw, 0, UID_ROOT, GID_WHEEL, 0600,
 		    "pro1xshot");
+	make_dev(&mntpt_cdevsw, 0, UID_ROOT, GID_WHEEL, 0400,
+	    "pro1x-host/.mnt");
 }
 SYSINIT(pro1xshot, SI_SUB_DRIVERS, SI_ORDER_ANY, shot_init, NULL);
 
