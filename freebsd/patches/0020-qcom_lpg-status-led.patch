From 54e55378d0b520d0449ae5626e260f1f8c56b5bb Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 05:59:00 +0100
Subject: [PATCH 2/2] qcom_lpg: PMI632 light pulse generator, the RGB status
 LED

One led(4) per colour of the device tree's led subnodes
(/dev/led/status_red, _green, _blue): each TRILED channel a 9-bit PWM
with a fixed duty cycle (dev.qcom_lpg.0.<colour>), switched through
the TRILED enable bits, as Linux's leds-qcom-lpg without patterns. The
hardware patterns (SDAM lookup table, PBS) stay unused; led(4) blinks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/conf/files.arm64         |   1 +
 sys/dev/qcom_spmi/qcom_lpg.c | 269 +++++++++++++++++++++++++++++++++++
 2 files changed, 270 insertions(+)
 create mode 100644 sys/dev/qcom_spmi/qcom_lpg.c

diff --git a/sys/conf/files.arm64 b/sys/conf/files.arm64
index 3115783dd..539369c74 100644
--- a/sys/conf/files.arm64
+++ b/sys/conf/files.arm64
@@ -747,6 +747,7 @@ dev/qcom_spmi/qcom_spmi.c			optional qcom_spmi fdt
 dev/qcom_spmi/qcom_pon.c			optional qcom_spmi fdt
 dev/qcom_spmi/qcom_rtc.c			optional qcom_spmi fdt
 dev/qcom_spmi/pro1x_battery.c			optional qcom_spmi fdt
+dev/qcom_spmi/qcom_lpg.c			optional qcom_spmi fdt
 dev/qcom_mdio/qcom_mdio_ipq4018.c		optional qcom_mdio fdt mdio mii
 
 # RockChip Drivers
diff --git a/sys/dev/qcom_spmi/qcom_lpg.c b/sys/dev/qcom_spmi/qcom_lpg.c
new file mode 100644
index 000000000..984fcd668
--- /dev/null
+++ b/sys/dev/qcom_spmi/qcom_lpg.c
@@ -0,0 +1,269 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Qualcomm PMI632 light pulse generator ("qcom,pmi632-lpg"): the F(x)tec
+ * Pro1X's RGB status LED, one led(4) per colour of the device tree's led
+ * subnodes (/dev/led/status_red, _green, _blue), so that "echo 1 >" and
+ * led(4)'s blink patterns drive them.
+ *
+ * Only the direct path of Linux's leds-qcom-lpg: each channel a PWM at
+ * 19.2 MHz / 6 / 2^2 with 9 bits (a 640 us period) and a fixed duty cycle,
+ * switched through the TRILED block's enable bits. The hardware patterns
+ * (lookup table in the PMIC's SDAM, started through the PBS) stay unused;
+ * led(4) does the blinking. The duty cycle of "on" per colour is
+ * dev.qcom_lpg.0.<colour> (0-511).
+ *
+ * The node has no "reg": the channels' and the TRILED block's addresses
+ * are the PMI632's, as in Linux.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/module.h>
+#include <sys/sysctl.h>
+
+#include <dev/led/led.h>
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/ofw_bus.h>
+#include <dev/ofw/ofw_bus_subr.h>
+
+#include <dev/qcom_spmi/qcom_spmi.h>
+
+#define	LPG_SUBTYPE		0x05
+#define	 SUBTYPE_LPG		0x02
+#define	 SUBTYPE_PWM		0x0b
+#define	 SUBTYPE_HI_RES_PWM	0x0c
+#define	 SUBTYPE_LPG_LITE	0x11
+#define	LPG_SIZE_CLK		0x41
+#define	 CLK_19M2		3	/* index in {off, 1k, 32k, 19.2M} */
+#define	LPG_PREDIV_CLK		0x42
+#define	 PREDIV_6		(3 << 5)	/* index in {1, 3, 5, 6} */
+#define	 PREDIV_EXP(x)		((x) & 7)
+#define	PWM_TYPE_CONFIG		0x43
+#define	 GLITCH_REMOVAL_OFF	(1 << 5)
+#define	PWM_VALUE		0x44	/* 16 bits, little endian */
+#define	PWM_ENABLE_CONTROL	0x46
+#define	 CTRL_OUTPUT		(1 << 7)
+#define	 CTRL_BUFFER_TRISTATE	(1 << 5)
+#define	 CTRL_SRC_PWM		(1 << 2)
+#define	PWM_SYNC		0x47
+#define	 SYNC_PWM		(1 << 0)
+
+#define	TRILED_BASE		0xd000
+#define	TRI_LED_EN_CTL		0x46
+
+#define	PWM_MAX			511	/* 9 bits */
+
+#define	LPG_NCHAN		3	/* the TRILED channels */
+static const struct {
+	uint16_t	base;
+	uint8_t		triled;
+} lpg_chan[LPG_NCHAN] = {
+	{ 0xb300, 1 << 7 },
+	{ 0xb400, 1 << 6 },
+	{ 0xb500, 1 << 5 },
+};
+
+struct qcom_lpg_softc;
+
+struct qcom_lpg_led {
+	struct qcom_lpg_softc	*sc;
+	struct cdev		*cdev;
+	u_int			chan;
+	uint8_t			subtype;
+	u_int			level;
+	bool			on;
+};
+
+struct qcom_lpg_softc {
+	device_t		dev;
+	struct qcom_lpg_led	led[LPG_NCHAN];
+	u_int			nled;
+};
+
+static int
+lpg_wr(struct qcom_lpg_softc *sc, uint16_t addr, uint8_t v)
+{
+	return (qcom_spmi_write(sc->dev, addr, &v, 1));
+}
+
+static int
+lpg_update(struct qcom_lpg_softc *sc, uint16_t addr, uint8_t mask,
+    uint8_t v)
+{
+	uint8_t old;
+	int error;
+
+	if ((error = qcom_spmi_read(sc->dev, addr, &old, 1)) != 0)
+		return (error);
+	return (lpg_wr(sc, addr, (old & ~mask) | (v & mask)));
+}
+
+/* Linux's lpg_apply() and triled_set() for a channel without pattern */
+static int
+lpg_apply(struct qcom_lpg_led *l)
+{
+	struct qcom_lpg_softc *sc = l->sc;
+	uint16_t b = lpg_chan[l->chan].base;
+	uint8_t size, val[2];
+	u_int level = MIN(l->level, PWM_MAX);
+	bool on = l->on && level > 0;
+	int error;
+
+	switch (l->subtype) {
+	case SUBTYPE_LPG:
+		size = CLK_19M2 | (3 << 4);
+		break;
+	case SUBTYPE_PWM:
+		size = CLK_19M2 | (1 << 2);	/* 9 bits */
+		break;
+	case SUBTYPE_HI_RES_PWM:
+		size = CLK_19M2 | (1 << 4);	/* 9 bits */
+		break;
+	default:				/* LPG lite */
+		size = CLK_19M2 | (1 << 4);
+		break;
+	}
+	val[0] = level & 0xff;
+	val[1] = level >> 8;
+
+	if ((error = lpg_update(sc, b + PWM_TYPE_CONFIG, GLITCH_REMOVAL_OFF,
+	    GLITCH_REMOVAL_OFF)) != 0)
+		return (error);
+	if (on && ((error = lpg_wr(sc, b + LPG_SIZE_CLK, size)) != 0 ||
+	    (error = lpg_wr(sc, b + LPG_PREDIV_CLK,
+	    PREDIV_6 | PREDIV_EXP(2))) != 0 ||
+	    (error = qcom_spmi_write(sc->dev, b + PWM_VALUE, val, 2)) != 0))
+		return (error);
+	if ((error = lpg_wr(sc, b + PWM_ENABLE_CONTROL, CTRL_BUFFER_TRISTATE |
+	    CTRL_SRC_PWM | (on ? CTRL_OUTPUT : 0))) != 0)
+		return (error);
+	/* The LPG needs the value again once the PWM is enabled (Linux). */
+	if (on && (error = qcom_spmi_write(sc->dev, b + PWM_VALUE, val,
+	    2)) != 0)
+		return (error);
+	if ((error = lpg_wr(sc, b + PWM_SYNC, SYNC_PWM)) != 0 ||
+	    (error = lpg_update(sc, b + PWM_TYPE_CONFIG, GLITCH_REMOVAL_OFF,
+	    0)) != 0)
+		return (error);
+	return (lpg_update(sc, TRILED_BASE + TRI_LED_EN_CTL,
+	    lpg_chan[l->chan].triled, on ? lpg_chan[l->chan].triled : 0));
+}
+
+static void
+qcom_lpg_led_func(void *arg, int onoff)
+{
+	struct qcom_lpg_led *l = arg;
+
+	l->on = onoff != 0;
+	(void)lpg_apply(l);
+}
+
+static int
+qcom_lpg_level_sysctl(SYSCTL_HANDLER_ARGS)
+{
+	struct qcom_lpg_led *l = arg1;
+	u_int level = l->level;
+	int error;
+
+	error = sysctl_handle_int(oidp, &level, 0, req);
+	if (error != 0 || req->newptr == NULL)
+		return (error);
+	if (level > PWM_MAX)
+		return (EINVAL);
+	l->level = level;
+	return (l->on ? lpg_apply(l) : 0);
+}
+
+static int
+qcom_lpg_probe(device_t dev)
+{
+	if (!ofw_bus_status_okay(dev))
+		return (ENXIO);
+	if (!ofw_bus_is_compatible(dev, "qcom,pmi632-lpg"))
+		return (ENXIO);
+	device_set_desc(dev, "Qualcomm PMI632 LPG (status LED)");
+	return (BUS_PROBE_DEFAULT);
+}
+
+static int
+qcom_lpg_attach(device_t dev)
+{
+	struct qcom_lpg_softc *sc = device_get_softc(dev);
+	struct sysctl_ctx_list *ctx = device_get_sysctl_ctx(dev);
+	struct sysctl_oid_list *tree =
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev));
+	static const char *const colour[] = { NULL, "red", "green", "blue" };
+	phandle_t node = ofw_bus_get_node(dev), child;
+	char name[32], knob[16];
+	pcell_t reg, color;
+	int error;
+
+	sc->dev = dev;
+	/* A known state: whatever Linux left on goes off. */
+	if ((error = lpg_wr(sc, TRILED_BASE + TRI_LED_EN_CTL, 0)) != 0) {
+		device_printf(dev, "TRILED not writable: %d\n", error);
+		return (ENXIO);
+	}
+	for (child = OF_child(node); child > 0 && sc->nled < LPG_NCHAN;
+	    child = OF_peer(child)) {
+		struct qcom_lpg_led *l = &sc->led[sc->nled];
+
+		if (!ofw_bus_node_status_okay(child) ||
+		    OF_getencprop(child, "reg", &reg, sizeof(reg)) <= 0 ||
+		    reg < 1 || reg > LPG_NCHAN)
+			continue;
+		if (OF_getencprop(child, "color", &color, sizeof(color)) <= 0 ||
+		    color >= nitems(colour) || colour[color] == NULL)
+			snprintf(knob, sizeof(knob), "channel%u", reg);
+		else
+			strlcpy(knob, colour[color], sizeof(knob));
+		snprintf(name, sizeof(name), "status_%s", knob);
+		l->sc = sc;
+		l->chan = reg - 1;
+		l->level = PWM_MAX;
+		if (qcom_spmi_read(dev, lpg_chan[l->chan].base + LPG_SUBTYPE,
+		    &l->subtype, 1) != 0)
+			continue;
+		if (lpg_apply(l) != 0)
+			continue;
+		l->cdev = led_create(qcom_lpg_led_func, l, name);
+		SYSCTL_ADD_PROC(ctx, tree, OID_AUTO, knob,
+		    CTLTYPE_UINT | CTLFLAG_RW | CTLFLAG_MPSAFE, l, 0,
+		    qcom_lpg_level_sysctl, "IU", "duty cycle when on (0-511)");
+		device_printf(dev, "%s: channel %u at %#x, subtype %#x\n",
+		    name, reg, lpg_chan[l->chan].base, l->subtype);
+		sc->nled++;
+	}
+	return (sc->nled > 0 ? 0 : ENXIO);
+}
+
+static int
+qcom_lpg_detach(device_t dev)
+{
+	struct qcom_lpg_softc *sc = device_get_softc(dev);
+
+	for (u_int i = 0; i < sc->nled; i++) {
+		led_destroy(sc->led[i].cdev);
+		sc->led[i].on = false;
+		(void)lpg_apply(&sc->led[i]);
+	}
+	return (0);
+}
+
+static device_method_t qcom_lpg_methods[] = {
+	DEVMETHOD(device_probe,		qcom_lpg_probe),
+	DEVMETHOD(device_attach,	qcom_lpg_attach),
+	DEVMETHOD(device_detach,	qcom_lpg_detach),
+	DEVMETHOD_END
+};
+
+static driver_t qcom_lpg_driver = {
+	"qcom_lpg",
+	qcom_lpg_methods,
+	sizeof(struct qcom_lpg_softc),
+};
+
+DRIVER_MODULE(qcom_lpg, qcom_pmic, qcom_lpg_driver, 0, 0);
-- 
