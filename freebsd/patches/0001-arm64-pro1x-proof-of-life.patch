@@ -87,6 +87,41 @@
  */
 
 ENTRY(_start)
+#ifdef PRO1X_PROOF_OF_LIFE
+	/*
+	 * F(x)tec Pro1X bring-up: paint the top 120 lines of the bootloader's
+	 * framebuffer (0x5c000000, 1080 pixels of 4 bytes) green before
+	 * anything else, while the MMU is still off and the stores go straight
+	 * to memory: the kernel was entered. x0 (the DTB) is left alone.
+	 */
+	movz	x9, #0x5c00, lsl #16
+	movz	x10, #0x0007, lsl #16
+	movk	x10, #0xe900		/* 1080 * 4 * 120 bytes */
+	movz	w11, #0xff00, lsl #16
+	movk	w11, #0xff00		/* a8r8g8b8 opaque green */
+1:	str	w11, [x9], #4
+	subs	x10, x10, #4
+	b.ne	1b
+	/*
+	 * And "PRO1X-FBSD:ENTERED\n" in the spare splash memory behind the
+	 * framebuffer (0x5ca00000), which Linux reads after the next boot.
+	 */
+	movz	x9, #0x5ca0, lsl #16
+	movz	x10, #0x5250
+	movk	x10, #0x314f, lsl #16
+	movk	x10, #0x2d58, lsl #32
+	movk	x10, #0x4246, lsl #48
+	str	x10, [x9]
+	movz	x10, #0x4453
+	movk	x10, #0x453a, lsl #16
+	movk	x10, #0x544e, lsl #32
+	movk	x10, #0x5245, lsl #48
+	str	x10, [x9, #8]
+	movz	x10, #0x4445
+	movk	x10, #0x000a, lsl #16
+	str	x10, [x9, #16]
+	dsb	sy
+#endif
 	/* Enter the kernel exception level */
 	bl	enter_kernel_el
 
