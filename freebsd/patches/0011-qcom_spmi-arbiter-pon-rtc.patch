+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Register access for the peripherals of Qualcomm SPMI PMICs: drivers of
+ * PMIC peripherals (children of a qcom_pmic bus) read and write the PMIC's
+ * registers by their 16-bit address; qcom_spmi_base() gives the
+ * peripheral's own addresses (its "reg" entries).
+ */
+
+#ifndef _DEV_QCOM_SPMI_QCOM_SPMI_H_
+#define	_DEV_QCOM_SPMI_QCOM_SPMI_H_
+
+int	qcom_spmi_read(device_t periph, uint16_t addr, void *buf, size_t len);
+int	qcom_spmi_write(device_t periph, uint16_t addr, const void *buf,
+	    size_t len);
+uint16_t qcom_spmi_base(device_t periph, int index);
+/* The interrupt controller's xref, for interrupts of peripheral subnodes */
+phandle_t qcom_spmi_intr_xref(device_t periph);
+
+/* Interrupt registers of every peripheral, after its base */
+#define	QPNPINT_RT_STS		0x10
+#define	QPNPINT_SET_TYPE	0x11
+#define	QPNPINT_POLARITY_HIGH	0x12
+#define	QPNPINT_POLARITY_LOW	0x13
+#define	QPNPINT_LATCHED_CLR	0x14
+#define	QPNPINT_EN_SET		0x15
+#define	QPNPINT_EN_CLR		0x16
+#define	QPNPINT_LATCHED_STS	0x18
+
+#endif
