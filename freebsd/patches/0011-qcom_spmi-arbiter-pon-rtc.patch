+    BUS_PASS_INTERRUPT + BUS_PASS_ORDER_LATE);
+
+/* --- a PMIC: a bus of peripherals ------------------------------------ */
+
+static int
+qcom_pmic_probe(device_t dev)
+{
+	if (!ofw_bus_status_okay(dev))
+		return (ENXIO);
+	if (!ofw_bus_is_compatible(dev, "qcom,spmi-pmic"))
+		return (ENXIO);
+	device_set_desc(dev, "Qualcomm SPMI PMIC");
+	return (BUS_PROBE_DEFAULT);
+}
+
+/* A peripheral's interrupts, mapped through the arbiter */
+static void
+qcom_pmic_child_irqs(device_t dev, device_t child, phandle_t node)
+{
+	struct qcom_spmi_devinfo *di = spmi_dinfo(child);
+	struct qcom_spmi_softc *arb = device_get_softc(device_get_parent(dev));
+	pcell_t *cells;
+	ssize_t n;
+	u_int irq;
+	int i, rid;
+
+	n = OF_getencprop_alloc_multi(node, "interrupts", sizeof(pcell_t),
+	    (void **)&cells);
+	for (i = 0, rid = 0; i + 4 <= n; i += 4, rid++) {
+		irq = ofw_bus_map_intr(dev, arb->xref, 4, cells + i);
+		resource_list_add(&di->rl, SYS_RES_IRQ, rid, irq, irq, 1);
+	}
+	if (n > 0)
+		OF_prop_free(cells);
+}
+
+static int
+qcom_pmic_attach(device_t dev)
+{
+	phandle_t node = ofw_bus_get_node(dev), child;
+	device_t cdev;
+
+	for (child = OF_child(node); child > 0; child = OF_peer(child)) {
+		if (!ofw_bus_node_status_okay(child))
+			continue;
+		cdev = spmi_add_child(dev, child, 1);
+		if (cdev != NULL)
+			qcom_pmic_child_irqs(dev, cdev, child);
+	}
+	bus_attach_children(dev);
+	return (0);
+}
+
+static device_method_t qcom_pmic_methods[] = {
+	DEVMETHOD(device_probe,		qcom_pmic_probe),
+	DEVMETHOD(device_attach,	qcom_pmic_attach),
+	DEVMETHOD(device_detach,	bus_generic_detach),
