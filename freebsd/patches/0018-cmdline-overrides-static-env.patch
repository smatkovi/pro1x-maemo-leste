From ccf2660c856653721f847c6fbbdc36a7eb7fde70 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Mon, 26 Oct 2026 05:50:15 +0100
Subject: [PATCH] pro1x: the command line overrides the static environment

The RAM console patch copied the kernel config's environment into the
buffer before the command line, and the first of two equal names is
the one found: kern.smp.disabled=0 or boot_verbose=0 from
freebsd/cmdline had no effect. The command line now goes first, and a
static entry is only added when nothing has it yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/arm64/arm64/machdep_boot.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/sys/arm64/arm64/machdep_boot.c b/sys/arm64/arm64/machdep_boot.c
index 3b022b614..483b9ae48 100644
--- a/sys/arm64/arm64/machdep_boot.c
+++ b/sys/arm64/arm64/machdep_boot.c
@@ -164,11 +164,13 @@ parse_fdt_bootargs(void)
 	if (loader_envp == NULL && fdt_get_chosen_bootargs(linux_command_line,
 	    LBABI_MAX_COMMAND_LINE) == 0) {
 		init_static_kenv(static_kenv, sizeof(static_kenv));
+		cmdline_set_env(linux_command_line, CMDLINE_GUARD);
 #ifdef PRO1X_RAMCONS
 		/*
 		 * Pro1X bring-up: keep the kernel config's static environment
-		 * (config(8) "env"), which the empty buffer just replaced; the
-		 * command line can only add to it.
+		 * (config(8) "env") next to the command line's, which wins:
+		 * the first of two equal names is the one found, so only
+		 * what neither the command line nor kern_envp has is added.
 		 */
 		for (const char *cp = static_env; *cp != '\0';
 		    cp += strlen(cp) + 1) {
@@ -178,10 +180,11 @@ parse_fdt_bootargs(void)
 			if (eq == NULL || (size_t)(eq - cp) >= sizeof(name))
 				continue;
 			strlcpy(name, cp, eq - cp + 1);
+			if (testenv(name))
+				continue;
 			kern_setenv(name, eq + 1);
 		}
 #endif
-		cmdline_set_env(linux_command_line, CMDLINE_GUARD);
 	}
 }
 
