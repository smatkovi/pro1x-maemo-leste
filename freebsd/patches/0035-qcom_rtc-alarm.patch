+/*
+ * A wake-up source fired: the RTC alarm (qcom_rtc), the power key
+ * (qcom_pon), from their interrupt threads, with what it was. A suspend
+ * in progress ends (freebsd/pm's pro1x_pm registers for it); also one
+ * whose CPUs were awake at that moment, between its freezes.
+ */
+#include <sys/eventhandler.h>
+typedef void (*power_wakeup_fn)(void *, const char *);
+EVENTHANDLER_DECLARE(power_wakeup, power_wakeup_fn);
+
 /* Interrupt registers of every peripheral, after its base */
 #define	QPNPINT_RT_STS		0x10
 #define	QPNPINT_SET_TYPE	0x11
