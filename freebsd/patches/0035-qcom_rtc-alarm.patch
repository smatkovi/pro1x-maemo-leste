+
+/* The alarm at the real time when, off for a time not in the future */
+static int
+qcom_rtc_alarm_set(struct qcom_rtc_softc *sc, int64_t when)
+{
+	uint32_t cnt, alarm, was;
+	int64_t now;
+	int on, error;
+
+	mtx_lock(&sc->mtx);
+	if ((error = qcom_rtc_now(sc, &cnt, &now)) != 0 ||
+	    (error = qrtc_alarm_get(&sc->io, sc->abase, &was, &on)) != 0)
+		goto out;
+	error = qrtc_alarm_count(cnt, now, when, &alarm);
+	if (error == EINVAL) {
+		error = on ? qrtc_alarm_off(&sc->io, sc->abase) : 0;
+		if (error == 0 && on)
+			device_printf(sc->dev, "alarm off (counter %u)\n", cnt);
+		goto out;
+	}
+	if (error != 0)
+		goto out;
+	error = qrtc_alarm_set(&sc->io, sc->abase, alarm);
+	/* each change on the console, not each call */
+	if (error == 0 && (!on || was != alarm))
+		device_printf(sc->dev, "alarm at counter %u, in %u s "
+		    "(counter %u)\n", alarm, alarm - cnt, cnt);
+out:
+	mtx_unlock(&sc->mtx);
+	if (error != 0 && error != ERANGE)
+		device_printf(sc->dev, "alarm not set: error %d\n", error);
+	return (error);
+}
+
+static void
+qcom_rtc_alarm_intr(void *arg)
+{
+	struct qcom_rtc_softc *sc = arg;
+	uint32_t alarm, cnt;
+	int64_t now;
+	int on, error;
+
+	mtx_lock(&sc->mtx);
+	error = qrtc_alarm_get(&sc->io, sc->abase, &alarm, &on);
+	if (error == 0)
+		error = qrtc_alarm_ack(&sc->io, sc->abase, qcom_rtc_alarm_clear);
+	(void)qcom_rtc_now(sc, &cnt, &now);
+	if (error != 0 || !on) {
+		/* not an alarm of ours, or its registers not readable */
+		if (sc->stale++ == 0)
+			device_printf(sc->dev, "alarm interrupt with the alarm "
+			    "off (error %d, counter %u)\n", error, cnt);
+		mtx_unlock(&sc->mtx);
+		return;
+	}
+	sc->alarms++;
+	sc->last_cnt = cnt;
+	sc->last = now;
+	mtx_unlock(&sc->mtx);
+	device_printf(sc->dev, "alarm: counter %u, set for %u\n", cnt, alarm);
+	EVENTHANDLER_INVOKE(power_wakeup, "the RTC alarm");
+	devctl_notify("PMIC", "RTC", "ALARM", NULL);
+}
+
+static int
+qcom_rtc_sysctl_wakealarm(SYSCTL_HANDLER_ARGS)
+{
+	struct qcom_rtc_softc *sc = arg1;
+	uint32_t cnt, alarm;
+	int64_t now, t;
+	int on, error;
+
+	mtx_lock(&sc->mtx);
+	error = qcom_rtc_now(sc, &cnt, &now);
+	if (error == 0)
+		error = qrtc_alarm_get(&sc->io, sc->abase, &alarm, &on);
+	mtx_unlock(&sc->mtx);
+	if (error != 0)
+		return (error);
+	t = on ? qrtc_alarm_time(cnt, now, alarm) : 0;
+	error = sysctl_handle_64(oidp, &t, 0, req);
+	if (error != 0 || req->newptr == NULL)
+		return (error);
+	return (qcom_rtc_alarm_set(sc, t));
+}
+
+static int
+qcom_rtc_sysctl_alarm(SYSCTL_HANDLER_ARGS)
+{
+	struct qcom_rtc_softc *sc = arg1;
+	struct sbuf sb;
+	uint32_t cnt, alarm;
+	int64_t now;
+	int on, error;
+
+	error = sysctl_wire_old_buffer(req, 0);
+	if (error != 0)
+		return (error);
+	sbuf_new_for_sysctl(&sb, NULL, 256, req);
+	mtx_lock(&sc->mtx);
+	error = qcom_rtc_now(sc, &cnt, &now);
+	if (error == 0)
+		error = qrtc_alarm_get(&sc->io, sc->abase, &alarm, &on);
+	if (error != 0)
+		sbuf_printf(&sb, "not readable: error %d", error);
+	else {
+		sbuf_printf(&sb, "counter %u, alarm ", cnt);
+		if (on)
+			sbuf_printf(&sb, "on at counter %u (in %d s, at %jd)",
+			    alarm, (int32_t)(alarm - cnt),
+			    (intmax_t)qrtc_alarm_time(cnt, now, alarm));
+		else
+			sbuf_printf(&sb, "off");
+		sbuf_printf(&sb, "; %ju alarms", (uintmax_t)sc->alarms);
+		if (sc->alarms != 0)
+			sbuf_printf(&sb, ", the last at counter %u (%jd)",
+			    sc->last_cnt, (intmax_t)sc->last);
+		if (sc->stale != 0)
+			sbuf_printf(&sb, ", %ju interrupts with it off",
+			    (uintmax_t)sc->stale);
+		sbuf_printf(&sb, "; interrupt %s",
+		    sc->ih != NULL ? "set up" : "none");
+	}
+	mtx_unlock(&sc->mtx);
+	error = sbuf_finish(&sb);
+	sbuf_delete(&sb);
+	return (error);
+}
