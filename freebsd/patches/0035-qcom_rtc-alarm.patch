+/*
+ * The alarm's peripheral: what the previous system left (an alarm Linux
+ * set, e.g. for Leste's alarmd, stays on and fires here), whether this EE
+ * may write it, its interrupt.
+ */
+static void
+qcom_rtc_alarm_attach(struct qcom_rtc_softc *sc)
+{
+	device_t dev = sc->dev;
+	struct sysctl_ctx_list *ctx = device_get_sysctl_ctx(dev);
+	struct sysctl_oid_list *ch = SYSCTL_CHILDREN(device_get_sysctl_tree(dev));
+	uint32_t cnt, alarm;
+	int64_t now;
+	uint8_t type[2], ctrl;
+	int on, error;
+	char irq[40];
+
+	mtx_lock(&sc->mtx);
+	error = qcom_rtc_now(sc, &cnt, &now);
+	if (error == 0)
+		error = sc->io.rd(sc->io.arg, sc->abase + QRTC_PERPH_TYPE, type,
+		    2);
+	if (error == 0)
+		error = qrtc_alarm_get(&sc->io, sc->abase, &alarm, &on);
+	/* writable from here? The same value again changes nothing */
+	if (error == 0 && (error = sc->io.rd(sc->io.arg, sc->abase +
+	    QRTC_ALARM_CTRL, &ctrl, 1)) == 0)
+		error = sc->io.wr(sc->io.arg, sc->abase + QRTC_ALARM_CTRL,
+		    &ctrl, 1);
+	mtx_unlock(&sc->mtx);
+	if (error != 0) {
+		device_printf(dev, "alarm at %#x %s (error %d): none\n",
+		    sc->abase, error == EPERM ? "not writable from this EE" :
+		    "not readable", error);
+		sc->abase = 0;
+		return;
+	}
+
+	sc->irq_rid = 0;
+	sc->irq = bus_alloc_resource_any(dev, SYS_RES_IRQ, &sc->irq_rid,
+	    RF_ACTIVE);
+	if (sc->irq != NULL && bus_setup_intr(dev, sc->irq,
+	    INTR_TYPE_MISC | INTR_MPSAFE, NULL, qcom_rtc_alarm_intr, sc,
+	    &sc->ih) != 0) {
+		bus_release_resource(dev, SYS_RES_IRQ, sc->irq_rid, sc->irq);
+		sc->irq = NULL;
+		sc->ih = NULL;
+	}
+	if (sc->irq != NULL)
+		snprintf(irq, sizeof(irq), "irq %ju",
+		    (uintmax_t)rman_get_start(sc->irq));
+	else
+		strlcpy(irq, "no interrupt (not this EE's?)", sizeof(irq));
+	if (on)
+		device_printf(dev, "alarm at %#x (type %#x/%u), %s; on, as "
+		    "the previous system left it: at counter %u, in %d s\n",
+		    sc->abase, type[0], type[1], irq, alarm,
+		    (int32_t)(alarm - cnt));
+	else
+		device_printf(dev, "alarm at %#x (type %#x/%u), %s; off\n",
+		    sc->abase, type[0], type[1], irq);
+
+	SYSCTL_ADD_PROC(ctx, ch, OID_AUTO, "wakealarm",
+	    CTLTYPE_S64 | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 0,
+	    qcom_rtc_sysctl_wakealarm, "Q",
+	    "The alarm's real time (s since the epoch, UTC), 0: off");
+	SYSCTL_ADD_PROC(ctx, ch, OID_AUTO, "alarm",
+	    CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_MPSAFE, sc, 0,
+	    qcom_rtc_sysctl_alarm, "A", "The counter, the alarm, its interrupts");
+	SYSCTL_ADD_U64(ctx, ch, OID_AUTO, "alarms", CTLFLAG_RD, &sc->alarms, 0,
+	    "The alarms that fired");
 }
 
