#!/bin/sh
#
# PROVIDE: pro1x_setup
# REQUIRE: DAEMON ldconfig
# BEFORE: local LOGIN hildon_setup
# KEYWORD: nojail
#
# F(x)tec Pro1X: root's home is the dataset pro1x/root on the writable
# pool (filled from /usr/local/share/pro1x/root the first time), else on a
# read-only root a tmpfs mounted and filled here; and the caches packages
# build when they are installed, built into /var at every boot:
# gdk-pixbuf's list of image loaders (found through GDK_PIXBUF_MODULE_FILE,
# ~/.xinitrc) and, in the background, fontconfig's font cache; the time
# zone's name (/var/db/zoneinfo). Hildon's
# GConf defaults and theme: rc.d/hildon_setup, after this.

. /etc/rc.subr

name="pro1x_setup"
rcvar="pro1x_setup_enable"
start_cmd="pro1x_setup_start"
stop_cmd=":"

pro1x_setup_start()
{
	if [ ! -w /root ] || [ "$(kenv -q pro1x.rootrw)" != 1 ]; then
		mount -t tmpfs -o mode=700 tmpfs /root
		cp -Rp /usr/local/share/pro1x/root/. /root/
	elif [ ! -e /root/.pro1x-home ]; then
		cp -Rp /usr/local/share/pro1x/root/. /root/
		touch /root/.pro1x-home
	fi
	# the time zone's name, as tzsetup leaves it (clockd reads it)
	[ -f /usr/local/share/pro1x/zoneinfo ] &&
	    cp /usr/local/share/pro1x/zoneinfo /var/db/zoneinfo
	if [ -x /usr/local/bin/gdk-pixbuf-query-loaders ]; then
		/usr/local/bin/gdk-pixbuf-query-loaders \
		    > /var/db/gdk-pixbuf-loaders.cache 2>/dev/null
	fi
	if [ -x /usr/local/bin/fc-cache ]; then
		(nice /usr/local/bin/fc-cache -s > /dev/null 2>&1 &)
	fi
}

load_rc_config $name
: ${pro1x_setup_enable:="YES"}
run_rc_command "$1"
