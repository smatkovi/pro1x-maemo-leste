#!/bin/sh
#
# PROVIDE: pro1x_setup
# REQUIRE: DAEMON ldconfig
# BEFORE: local LOGIN
# KEYWORD: nojail
#
# F(x)tec Pro1X, read-only root: root's home is a tmpfs (/etc/fstab),
# filled here from /usr/local/share/pro1x/root; and the caches packages
# build when they are installed, built into /var at every boot:
# gdk-pixbuf's list of image loaders (found through GDK_PIXBUF_MODULE_FILE,
# ~/.xinitrc), Hildon's GConf defaults from the schemas (found through
# /usr/local/etc/gconf/2/local-defaults.path), Hildon's theme for the
# factor in pro1x-display.conf on userdata (pro1x-hidpi: /etc/hildon/theme
# points into /var) and, in the background, fontconfig's font cache.

. /etc/rc.subr

name="pro1x_setup"
rcvar="pro1x_setup_enable"
start_cmd="pro1x_setup_start"
stop_cmd=":"

pro1x_setup_start()
{
	cp -Rp /usr/local/share/pro1x/root/. /root/
	if [ -x /usr/local/bin/gdk-pixbuf-query-loaders ]; then
		/usr/local/bin/gdk-pixbuf-query-loaders \
		    > /var/db/gdk-pixbuf-loaders.cache 2>/dev/null
	fi
	if [ -x /usr/local/bin/gconftool-2 ] &&
	    [ -d /usr/local/share/gconf/schemas ]; then
		mkdir -p /var/db/gconf
		GCONF_CONFIG_SOURCE=xml:merged:/var/db/gconf/gconf.xml.defaults \
		    /usr/local/bin/gconftool-2 --makefile-install-rule \
		    /usr/local/share/gconf/schemas/*.schemas > /dev/null 2>&1
	fi
	if [ -x /usr/local/bin/pro1x-hidpi ]; then
		GDK_PIXBUF_MODULE_FILE=/var/db/gdk-pixbuf-loaders.cache \
		    /usr/local/bin/pro1x-hidpi theme
	fi
	if [ -x /usr/local/bin/fc-cache ]; then
		(nice /usr/local/bin/fc-cache -s > /dev/null 2>&1 &)
	fi
}

load_rc_config $name
: ${pro1x_setup_enable:="YES"}
run_rc_command "$1"
