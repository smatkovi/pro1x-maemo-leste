#!/bin/sh
#
# PROVIDE: pro1x_audiod
# REQUIRE: FILESYSTEMS pro1x_modem
# BEFORE: LOGIN
# KEYWORD: nojail shutdown
#
# The sound (freebsd/audio/README.md, runs pro1x.test=audio): sound(4)
# with snd_pro1x.ko (/dev/dsp, /dev/mixer), whose PCM pro1x-audiod moves
# through the ADSP, and the codec's replay sequences. Needs the ADSP
# running with its APR channel (pd_mapper, pro1x-dsp start adsp; with
# pro1x_audiod_adsp="YES" this script starts it). Without the daemon
# /dev/dsp still works, nothing is heard. Off until the device tests pass.
#
#   pro1x_audiod_enable="YES"
#   pro1x_audiod_adsp="YES"           start the ADSP first
#   pro1x_audiod_args="-r hph"        the headphones (spk, ear)
#   pro1x_audiod_jack="auto"          the jack's interrupts (pro1x-audiod -j):
#                                     auto (SoundWire alerts through
#                                     qcom_swr.ko, checked; else polled),
#                                     irq, poll, clkstop (alerts and the
#                                     bus' clock stopped between them: the
#                                     power profile's default)

. /etc/rc.subr

name=pro1x_audiod
desc="Sound through the ADSP"
rcvar=pro1x_audiod_enable
load_rc_config $name
: ${pro1x_audiod_enable:=NO}
: ${pro1x_audiod_adsp:=NO}
: ${pro1x_audiod_modules:="qcom_dsp qrtr qcom_apr qcom_lpass qcom_swr sound snd_pro1x"}
: ${pro1x_audiod_log:=/var/log/pro1x-audiod.log}
: ${pro1x_audiod_args:=}
if [ -z "${pro1x_audiod_jack}" ]; then
	pro1x_audiod_jack=auto
	[ -r /usr/local/share/pro1x/power.subr ] &&
	    . /usr/local/share/pro1x/power.subr && pro1x_power_on &&
	    pro1x_audiod_jack=clkstop
fi

pidfile=/var/run/${name}.pid
procname=/usr/local/sbin/pro1x-audiod
command=/usr/sbin/daemon
command_args="-o ${pro1x_audiod_log} -p ${pidfile} ${procname} -d -j ${pro1x_audiod_jack} ${pro1x_audiod_args}"
start_precmd=pro1x_audiod_prestart

pro1x_audiod_prestart()
{
	local i
	# qcom_swr: without it the jack is polled
	kldload -n ${pro1x_audiod_modules} ||
	    for i in ${pro1x_audiod_modules}; do kldload -n $i; done
	if checkyesno pro1x_audiod_adsp &&
	    ! sysctl -n hw.qcom_apr 2> /dev/null | grep -q "^open"; then
		service pd_mapper onestart
		/usr/local/sbin/pro1x-dsp start adsp
		i=0
		while [ $i -lt 30 ] &&
		    ! sysctl -n hw.qcom_apr | grep -q "^open"; do
			sleep 1
			i=$((i + 1))
		done
	fi
}

run_rc_command "$1"
