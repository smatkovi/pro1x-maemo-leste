#!/bin/sh
#
# PROVIDE: pro1x_statusled
# REQUIRE: DAEMON devd
# KEYWORD: nojail shutdown
#
# F(x)tec Pro1X: the RGB status LED shows charging and full, as on Leste
# (/usr/local/libexec/pro1x-statusled): set once at boot, then by devd on
# every change pro1x_battery reports (etc/devd/pro1x.conf).

. /etc/rc.subr

name="pro1x_statusled"
rcvar="pro1x_statusled_enable"
start_cmd="/usr/local/libexec/pro1x-statusled"
stop_cmd="/usr/local/libexec/pro1x-statusled off"

load_rc_config $name
: ${pro1x_statusled_enable:="YES"}
run_rc_command "$1"
