#!/bin/sh
# pro1x-statusled [STATUS]: the RGB status LED shows the battery as on Leste
# (mce's PatternBatteryCharging 255;10;0 and PatternBatteryFull 0;255;0),
# when pro1x-led (the notification light, freebsd/pm/tools) does not run:
# orange while charging, green when full, off on battery. Run by devd when
# pro1x_battery tells it of a change (etc/devd/pro1x.conf), so nothing
# polls, as the N9's mce got BME's events; without STATUS it reads the
# state now (rc.d/pro1x_statusled at boot). The LED is qcom_lpg's
# /dev/led/status_* with the duty cycle dev.qcom_lpg.0.<colour> (0-511).
led() {
	for c in red green blue; do
		v=$1
		shift
		sysctl -q dev.qcom_lpg.0.$c=$v > /dev/null
		if [ "$v" -gt 0 ]; then echo 1; else echo 0; fi > /dev/led/status_$c
	done
}
[ -c /dev/led/status_red ] || exit 0
# pro1x-led (Maemo's notification light) has the LED and the battery's
# colours itself when it runs
pgrep -q -F /var/run/pro1x-led.pid -x pro1x-led 2> /dev/null && exit 0
st=${1:-$(sysctl -n dev.pro1x_battery.0.status 2> /dev/null)}
case $st in
charging)	led 511 20 0 ;;
full)		led 0 511 0 ;;
*)		led 0 0 0 ;;
esac
