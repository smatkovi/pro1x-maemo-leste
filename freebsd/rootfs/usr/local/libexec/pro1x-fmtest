#!/bin/sh
# pro1x-fmtest [STEP]: the FM radio's test runs of freebsd/fm/README.md,
# each layer after the one below it, up to STEP (kernel environment
# pro1x.fm, set in the boot menu's freebsd/cmdline with pro1x.test=fm):
#   uart   qcom_geni_uart.ko: the serial engine's clock, its pins, the QUP
#          version, /dev/cuau0; the UART alone through its internal
#          loopback at 115200 and 3000000 baud (no chip involved)
#   bt     uart, then the WCN3950: its rails at the RPM (qcom_dsp),
#          pro1x-fmd brings it up (power pulses, version, baud rate,
#          rampatch and NVM download, HCI_RESET, in-band sleep)
#   radio  bt, then the FM receiver: on, tune (pro1x.fm_freq, default
#          99.9 MHz), signal and stereo, RDS for 15 s, three seeks, off
#          (headphones plugged in: their cable is the antenna)
#   audio  radio's receiver left on, then the ADSP and its APR and SLIMbus
#          services (pro1x-q6, freebsd/dsp): what FreeBSD can ask of the
#          audio path so far
#   slim   bt, the receiver on and tuned, the ADSP, then pro1x-fmaudio:
#          the SLIMbus NGD's capability exchange, the WCN3950's logical
#          addresses and revision (probe), its FM stream on channels
#          160/161 for 5 s (slim)
#   afe    slim, then the ADSP's AFE: SLIMBUS_8_TX started alone (afe -N),
#          the output path's clock votes (clocks), then Android's play-fm
#          (clocks, loopback, RX_CODEC_DMA_RX_0, SLIMBUS_8_TX: afe), then
#          the same through pro1x-fmd ("audio on", "audio off"); no codec
#          behind it yet, so nothing to hear
# pro1x.fm_debug=1: every frame on the UART in the log; pro1x.fm_speed=
# 115200: the chip left at its boot rate throughout; pro1x.fm_audio_opts:
# more options for pro1x-fmaudio (-T: every register access, -c, -p, -g).
# Everything goes to the console, which the RAM console keeps for Linux
# after the next boot. From userdata (next to the kernel) first: a newer
# copy of this script in freebsd/fm/, pro1x-fmd, pro1x-fmctl and
# pro1x-q6 there, the modules in freebsd/modules, the chip's firmware
# (linux-firmware's qca/cmbtfw12.tlv, qca/cmnv12.bin) in
# freebsd/firmware/qca.
step=${1:-$(kenv -q pro1x.fm)}
step=${step:-uart}
host=/dev/pro1x-host/freebsd
if [ -f $host/fm/pro1x-fmtest ] && [ "${PRO1X_FMTEST_HOST:-}" != 1 ]; then
	echo "=== the newer pro1x-fmtest from $host/fm"
	PRO1X_FMTEST_HOST=1 exec sh $host/fm/pro1x-fmtest "$step"
fi
# rc's PATH has no /usr/local
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
[ -d $host/fm ] && PATH=$host/fm:$PATH
export PATH
echo "=== FM test up to: $step"
if [ -d $host/modules ]; then
	kldconfig -i $host/modules
	echo "modules from $host/modules first"
fi
tty=/dev/cuau0
freq=$(kenv -q pro1x.fm_freq)
freq=${freq:-99.9}
speed=$(kenv -q pro1x.fm_speed)
speed=${speed:-3000000}
v=
[ "$(kenv -q pro1x.fm_debug)" = 1 ] && v=-v
log=/tmp/pro1x-fmd.log

# SW_CTRL of the WCN3950 (the stock device tree's bt-sw-ctrl-gpio, gpio 87):
# read only, for the record
swctrl() {
	echo "SW_CTRL (gpio 87, $1): $(gpioctl -f /dev/gpioc0 87 2>&1)"
}

echo "--- qcom_geni_uart"
swctrl "before"
kldload qcom_geni_uart && echo "qcom_geni_uart loaded"
kldstat | grep -E "uart"
dmesg | grep -E "^uart|qcom_geni|geni" | tail -20
sysctl dev.uart.0 2>&1
ls -la /dev/cuau0 /dev/ttyu0 2>&1
if [ -c $tty ]; then
	echo "--- the UART alone, through its internal loopback"
	sysctl dev.uart.0.loopback=1
	pro1x-fmd -L 115200,3000000 -d $tty 2>&1
	sysctl dev.uart.0.loopback=0
	sysctl dev.uart.0.rx_bytes dev.uart.0.tx_bytes dev.uart.0.overruns \
	    dev.uart.0.clock dev.uart.0.clock_div dev.uart.0.baud 2>&1
else
	echo "no $tty: nothing more to test"
	exit 0
fi
[ "$step" = uart ] && exit 0

echo "--- the WCN3950"
kldload qcom_dsp && echo "qcom_dsp loaded"
sysctl hw.qcom_rpm.edge 2>&1
ls -la $host/firmware/qca /usr/local/share/pro1x/firmware/qca 2>&1
rm -f /var/run/pro1x-fm.sock
pro1x-fmd -F $v -d $tty -s "$speed" -a "-v $(kenv -q pro1x.fm_audio_opts)" \
    -f $host/firmware:/usr/local/share/pro1x/firmware > $log 2>&1 &
fmd=$!
i=0
while [ ! -S /var/run/pro1x-fm.sock ] && [ $i -lt 20 ]; do
	sleep 0.5
	i=$((i + 1))
done
step_t() { echo "$(date +%T) $*"; }
step_t "on"
pro1x-fmctl on
pro1x-fmctl info
swctrl "after the bring-up"
sysctl hw.qcom_rpm.regulator hw.qcom_rpm.requests hw.qcom_rpm.refused \
    hw.qcom_rpm.timeouts 2>&1
sysctl dev.uart.0.rx_bytes dev.uart.0.tx_bytes dev.uart.0.overruns \
    dev.uart.0.parity_errors dev.uart.0.baud 2>&1

if [ "$step" = slim ] || [ "$step" = afe ]; then
	echo "--- the FM receiver, tuned (its SLIMbus port on)"
	step_t "tune $freq"
	pro1x-fmctl tune "$freq"
	pro1x-fmctl station
elif [ "$step" != bt ]; then
	echo "--- the FM receiver"
	pro1x-fmctl debug 1
	step_t "tune $freq"
	pro1x-fmctl tune "$freq"
	pro1x-fmctl station
	step_t "RDS for 15 s"
	pro1x-fmctl -t 15 watch
	pro1x-fmctl ps
	pro1x-fmctl rt
	pro1x-fmctl station
	for i in 1 2 3; do
		step_t "seek up"
		pro1x-fmctl seek up
		pro1x-fmctl station
	done
	pro1x-fmctl mute 1
	pro1x-fmctl mono 1
	pro1x-fmctl station
	pro1x-fmctl info
fi
if [ "$step" = audio ] || [ "$step" = slim ] || [ "$step" = afe ]; then
	echo "--- the audio path (the receiver on, its SLIMbus port on)"
	pro1x-fmctl status
	# the ADSP with its APR channel (qcom_apr) and QRTR services, the
	# protection domain mapper for its audio PD (run dsp3/dsp4 of
	# freebsd/dsp/README.md)
	kldload qrtr && echo "qrtr loaded"
	kldload qcom_apr && echo "qcom_apr loaded"
	service pd_mapper onestart
	pro1x-dsp start adsp
	echo "ADSP start: $?"
	i=0
	while [ $i -lt 30 ] && ! sysctl -n hw.qcom_apr | grep -q "^open"; do
		sleep 1
		i=$((i + 1))
	done
	echo "after $i s: hw.qcom_apr: $(sysctl -n hw.qcom_apr)"
	sleep 3
	sysctl net.qrtr.servers
	if [ "$step" = audio ]; then
		pro1x-q6 test 2>&1
	else
		# pro1x-q6 slim would switch the bus off again: the core only
		pro1x-q6 core 2>&1
	fi
	sysctl hw.qcom_apr
	dmesg | grep -E "qcom_(apr|pas|smp2p)|glink" | tail -20
fi
if [ "$step" = slim ] || [ "$step" = afe ]; then
	# pro1x-fmaudio (freebsd/fm/README.md, stage 3): /dev/qcom_lpass,
	# QMI power before any register, every message (-v)
	kldload qcom_lpass && echo "qcom_lpass loaded"
	sysctl hw.qcom_lpass.windows 2>&1
	o=$(kenv -q pro1x.fm_audio_opts)
	pro1x-fmctl status
	# fma ARGS: pro1x-fmaudio, its output after it; with cycle=1 the
	# receiver is switched off and on while it waits for the chip on the
	# bus (the chip powered after the bus came up, as on Android)
	cycle=0
	fma() {
		if [ $cycle = 1 ]; then
			pro1x-fmaudio -v $o -w 40 "$@" > /tmp/fma.log 2>&1 &
			fp=$!
			sleep 8
			step_t "the receiver off and on while the bus is up"
			pro1x-fmctl off
			pro1x-fmctl on
			pro1x-fmctl tune "$freq"
			wait $fp
			r=$?
		else
			pro1x-fmaudio -v $o "$@" > /tmp/fma.log 2>&1
			r=$?
		fi
		cat /tmp/fma.log
		return $r
	}
	step_t "pro1x-fmaudio probe"
	fma probe
	echo "probe: $?"
	if grep -q "is not on the bus" /tmp/fma.log; then
		echo "--- the WCN3950 not on the bus: once more, the chip powered while the bus is up"
		cycle=1
		step_t "pro1x-fmaudio probe (the chip after the bus)"
		fma probe
		echo "probe: $?"
	fi
	step_t "pro1x-fmaudio slim"
	fma -t 5 slim
	echo "slim: $?"
	if [ "$step" = afe ]; then
		step_t "pro1x-fmaudio afe -N (SLIMBUS_8_TX alone)"
		fma -N -t 5 afe
		echo "afe -N: $?"
		step_t "pro1x-fmaudio clocks"
		pro1x-fmaudio -v $o -t 3 clocks 2>&1
		echo "clocks: $?"
		step_t "pro1x-fmaudio afe (play-fm)"
		fma -t 5 afe
		echo "afe: $?"
		# stage 4: the same through pro1x-fmd, as the app asks for it
		# (its output in pro1x-fmd's log below)
		if [ $cycle = 1 ]; then
			echo "stage 4 left out: the chip needs the power cycle, which \"off\" would end"
		else
			step_t "pro1x-fmd: audio on"
			pro1x-fmctl audio on
			pro1x-fmctl status
			sleep 3
			step_t "pro1x-fmd: audio off"
			pro1x-fmctl audio off
			pro1x-fmctl audio
		fi
	fi
	pro1x-fmctl status
	sysctl hw.qcom_apr hw.qcom_lpass.windows 2>&1
	dmesg | grep -E "qcom_(apr|pas|smp2p|lpass)|glink|smmu" | tail -20
fi
step_t "off"
pro1x-fmctl off
kill $fmd 2> /dev/null
sleep 1
echo "--- pro1x-fmd's log"
cat $log
swctrl "after off"
sysctl hw.qcom_rpm.regulator 2>&1
