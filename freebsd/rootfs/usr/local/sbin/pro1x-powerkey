#!/bin/sh
# pro1x-powerkey PRESS|RELEASE (from devd, etc/devd/pro1x.conf): powers the
# phone off when the power key stays down for 2 s. A short press goes to
# the N9's stand-by screen or back from it (pro1x-standby, SIGUSR1); without
# pro1x-standby it blanks the X session's screen or brings it back, as on
# Leste. A touch or a key brings a blank screen back too; the press after
# that one only clears the note that it is blank (xset cannot tell), the
# next blanks again.
#
# Before it powers off it asks the PMIC whether the key is still down
# (dev.qcom_pon.0.power_key, patches/0051): a RELEASE that never reached
# devd does not switch the phone off. What it does goes to /dev/console,
# which the RAM console keeps (patches/0050) for Linux to read after the
# next boot.
pid=/var/run/pro1x-powerkey.pid
blank=/var/run/pro1x-blanked
standby=/var/run/pro1x-standby.pid
say() { echo "pro1x-powerkey: $*" > /dev/console 2> /dev/null; }
case "$1" in
PRESS)
	(
		sleep 2
		rm -f "$pid"
		if [ "$(sysctl -n dev.qcom_pon.0.power_key 2> /dev/null)" = 0 ]; then
			say "up again without a RELEASE: staying on"
			exit 0
		fi
		say "held for 2 s: powering off"
		shutdown -p now "power key"
	) &
	echo $! > "$pid"
	;;
RELEASE)
	[ -f "$pid" ] || exit 0
	kill "$(cat "$pid")" 2>/dev/null
	rm -f "$pid"
	# only the stand-by screen's own process (not a reused number)
	sp=$(cat "$standby" 2>/dev/null)
	if [ -n "$sp" ] && [ "$(ps -p "$sp" -o comm= 2>/dev/null)" = pro1x-standby ] &&
	    kill -USR1 "$sp" 2>/dev/null; then
		exit 0
	fi
	export DISPLAY=:0 XAUTHORITY=/root/.Xauthority
	if [ -f "$blank" ]; then
		rm -f "$blank"
		/usr/local/bin/xset s reset 2>/dev/null
	elif /usr/local/bin/xset s activate 2>/dev/null; then
		touch "$blank"
	fi
	;;
esac
