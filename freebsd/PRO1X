#
# PRO1X -- FreeBSD for the F(x)tec Pro1X (Qualcomm SM6115), bring-up.
#
# Deliberately not GENERIC: GENERIC brings drivers that match nodes of the
# phone's device tree (sdhci, dwc3/xhci, ...) and touch blocks whose clocks
# no FreeBSD driver has switched on, which can stall the bus. This has only
# what the start needs plus the frameworks the Pro1X drivers build on; each
# new driver is added here on its own.
#
# What the start needs: LINUX_BOOT_ABI (std.arm64: the Linux arm64 Image
# header, so that the phone's bootloader or Linux kexec starts the kernel
# with the device tree), the GIC, the generic timer and PSCI (standard on
# arm64), vt_simplefb (the console on the framebuffer the bootloader leaves
# running) and a root filesystem built into the kernel.
#
cpu		ARM64
ident		PRO1X

include		"std.arm64"
options 	FDT

# Root filesystem in RAM (freebsd/build.sh fills in the path)
makeoptions	MFS_IMAGE=@MFS_IMAGE@
options 	MD_ROOT_READONLY
device		md

# Console: the bootloader's framebuffer, and the keyboard multiplexer;
# the display Linux leaves running is pointed at that framebuffer (0017)
device		vt
device		vt_simplefb
device		kbdmux
device		qcom_dpu
device		backlight	# the panel's brightness, by DCS (0022)

# Pro1X drivers (patches/0004 on)
device		qcom_wdt		# APSS watchdog: a hang resets the phone
device		ufshci			# UFS, on the link Linux left up (0005)
device		qcom_tlmm_sm6115	# GPIOs and their interrupts (0006)

# On the GPIOs: modifier keys and switches (gpio-keys), the touchscreen's
# bit-banged I2C bus, the keyboard backlight
device		gpiokeys
device		gpioiic
device		iicbb
device		gpioled
device		goodix			# the touchscreen (0007)

# The QUP serial engines: I2C (the keyboard's bus), on the setup Linux left
device		geniiic			# FDT attachment (0008)
device		pro1xkbd		# the keyboard matrix on it (0009)
device		aw86224			# the vibration motor on it (0019)

# CPU frequency: the firmware's lookup table per cluster (0010)
device		cpufreq
device		qcom_cpufreq_hw
# CPU idle states through PSCI, the memory-mapped timer as their wake-up
# (pm/README.md, patches/0032); off until hw.psci_idle.enable=1; the
# SoC's sleep (MPM hand-over) and suspend-to-idle on top (0033), off until
# hw.pro1x_pm.mpm=1 or hw.pro1x_pm.suspend=N
device		psci_idle
device		pro1x_pm

# The PMICs over SPMI: power and volume-down keys, the RTC (0011), the
# battery (0015), the RGB status LED (0020)
device		qcom_spmi

# Disks and file systems: CAM, GPT, ext4 (userdata, where the system
# images live), ZFS (root.zfs, rootzfs.sh)
device		scbus
device		da
device		pass
options 	GEOM_PART_GPT
options 	EXT2FS
options 	ZFS
# the writable pool's blocks inside userdata (mfsroot/etc/pro1x-pool.sh;
# shared nops: patches/0029)
options 	GEOM_NOP
options 	GEOM_CONCAT

# Frameworks for the SoC drivers to come
device		clk
device		phy
device		hwreset
device		nvmem
device		regulator
device		syscon
device		gpio
device		fdt_pinctrl
device		iicbus
device		iic
device		evdev
options 	EVDEV_SUPPORT
device		uinput
# The PCI framework, without a host bridge (the SoC has no PCIe and no node
# matches): LinuxKPI, which the Wi-Fi's ath10k builds on (freebsd/dsp),
# depends on it and keeps its DMA functions there
device		pci

# Basics
device		loop
device		ether
device		bpf
device		crypto
device		armv8crypto
device		armv8_rng

# Settings that cannot come from the command line: the bootloader appends
# its own arguments, and FreeBSD reads bootargs only when they start with
# "FreeBSD:" and fit 512 bytes (patches/0003 keeps this environment).
env		"@ENV_FILE@"

# Green stripe at the top of the screen and a marker as soon as the kernel
# is entered (patches/0001), and the RAM console that keeps the console
# output for Linux to read after the next boot (patches/0003)
makeoptions	CONF_CFLAGS="-DPRO1X_PROOF_OF_LIFE -DPRO1X_RAMCONS"

# Every SYSINIT step on the console, to see how far the boot gets
options 	VERBOSE_SYSINIT=1
