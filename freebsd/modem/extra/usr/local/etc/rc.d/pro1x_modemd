#!/bin/sh
#
# PROVIDE: pro1x_modemd
# REQUIRE: dbus pro1x_modem
# KEYWORD: nojail shutdown
#
# The modem's calls, SMS and network on the system bus as oFono's API
# (org.ofono; freebsd/modem/README.md), for sphone and the other Hildon
# apps written for oFono. QMI over QRTR to the modem pro1x_modem started.
# The SIM PIN comes from /dev/pro1x-host/freebsd/sim-pin (the user's file
# on userdata), tried once per boot; the call audio program runs while
# there are calls when pro1x_modemd_flags names it:
#
#   pro1x_modemd_enable="YES"
#   pro1x_modemd_flags="-A /usr/local/sbin/pro1x-callaudio"

. /etc/rc.subr

name=pro1x_modemd
desc="The modem's calls and SMS on D-Bus (oFono's API)"
rcvar=pro1x_modemd_enable
load_rc_config $name
: ${pro1x_modemd_enable:=NO}

pidfile=/var/run/${name}.pid
procname=/usr/local/sbin/pro1x-modemd
command=/usr/sbin/daemon
command_args="-r -R 10 -C 5 -P ${pidfile} -o /var/log/pro1x-modemd.log ${procname}"
start_precmd=pro1x_modemd_prestart

pro1x_modemd_prestart()
{
	kldload -n qcom_dsp qrtr || return 1
}

run_rc_command "$1"
