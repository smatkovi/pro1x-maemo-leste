# Static kernel environment for PRO1X (kernel config "env").
# The other CPUs come up through PSCI, which is untested under Qualcomm's
# hypervisor: start with one.
kern.smp.disabled=1
# Verbose boot messages on the screen
boot_verbose=1
# ZFS root: a transaction group every 30 s instead of 5 (fewer wake-ups and
# copy-on-write metadata writes to the flash; a crash loses up to 30 s of
# changes, the battery makes a power loss rare)
vfs.zfs.txg.timeout=30
# The random harvester once a second once seeded, not ten times
# (patches/0027): the pools still get their share every second
kern.random.harvest.seeded_hz=1
