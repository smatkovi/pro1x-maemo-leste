+// the Pro1X (FreeBSD): its light sensor is the ADSP's, which
+// pro1x-light reads once (libssc)
+function checkPro1X(var lux: integer): boolean;
+const
+  tool = '/usr/local/bin/pro1x-light';
+var
+  output: string;
+begin
+  lux := 0;
+  checkPro1X := false;
+  if not SysUtils.FileExists(tool) then exit;
+  if not process.RunCommand(tool, [], output) then exit;
+  lux := SysUtils.StrToIntDef(SysUtils.Trim(output), -1);
+  checkPro1X := lux >= 0;
+  if lux < 0 then lux := 0;
+end;
