 int
 hwrtc_set_alarm(const struct tm *utc, int enabled)
 {
+#ifndef __linux__
+  struct tm tm = *utc;
+  int64_t   t  = enabled ? (int64_t)hwrtc_mktime(&tm) : 0;
+
+  log_debug("hwrtc: alarm at: %04d-%02d-%02d %02d:%02d:%02d (%lld)\n",
+            utc->tm_year + 1900, utc->tm_mon + 1, utc->tm_mday,
+            utc->tm_hour, utc->tm_min, utc->tm_sec, (long long)t);
+  return hwrtc_set_wakealarm(t);
+#else
   int err = -1;
   int fd  = -1;
 
@@ -258,4 +359,5 @@
