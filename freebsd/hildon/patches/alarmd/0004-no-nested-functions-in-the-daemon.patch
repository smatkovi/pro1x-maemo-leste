+    va_list va;\
+    char k[64];\
+    va_start(va, f);\
+    vsnprintf(k, sizeof k, f, va);\
+    va_end(va);\
+    inifile_setfmt(ini, s, k, fmt, v);\
+  }\
+}
+
+QUEUE_SAVE(queue_save_u, unsigned,           v != 0,   "%u")
