FreeBSD: libpython preloaded (Qt loads PyOtherSide with local symbols, Python's extension modules need them global); qmlscene from Qt's bin directory.

--- a/gpodder-leste.in
+++ b/gpodder-leste.in
@@ -10,4 +10,13 @@
 # with fewer wake-ups than the default output (pro1x-maemo-leste's
 # pro1x-music-sink); QtMultimedia's player sets no role of its own
 export PULSE_PROP="media.role=music${PULSE_PROP:+ $PULSE_PROP}"
+# FreeBSD: Qt loads PyOtherSide's plugin, and with it libpython, with its
+# symbols local, which Python's own extension modules (math, ...) then do
+# not see; preloaded, they are global
+if [ "$(uname -s)" = FreeBSD ]; then
+	p=$(ldd /usr/local/lib/qt5/qml/io/thp/pyotherside/libpyothersideplugin.so 2>/dev/null |
+	    awk '/libpython/ {print $3; exit}')
+	[ -n "$p" ] && export LD_PRELOAD=$p${LD_PRELOAD:+:$LD_PRELOAD}
+	export PATH=$PATH:/usr/local/lib/qt5/bin
+fi
 exec qmlscene @APP@/touch/gpodder.qml "$@"
