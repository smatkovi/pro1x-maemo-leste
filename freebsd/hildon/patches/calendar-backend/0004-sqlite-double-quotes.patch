From 7501aefcda128dcfde054fe53abaa953c7388b8d Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Fri, 30 Oct 2026 07:44:36 +0100
Subject: [PATCH 2/2] Double-quoted strings in SQL also with an SQLite built
 without them

Much of the SQL in DbCalls.h and the sources quotes string values with
double quotes (insert into Calendars values(1,"cal_ti_calendar_synced",
...), select ... where Id = "21"). An SQLite built with SQLITE_DQS=0, as
FreeBSD's is, takes those for column names: the default calendars are
not created and the repeating events' rules are not found. Allow them
again for calendar-backend's connection (SQLite 3.29 and later).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/CCalendarDB.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/CCalendarDB.cpp b/src/CCalendarDB.cpp
index 2dbb492..a351a51 100644
--- a/src/CCalendarDB.cpp
+++ b/src/CCalendarDB.cpp
@@ -409,6 +409,12 @@ int CCalendarDB::initDB()
     iRet = sqlite3_open(szCaldb.c_str(), &pDb);
    
     sqlite3_busy_handler(pDb, busy_handler, NULL);
+#ifdef SQLITE_DBCONFIG_DQS_DML
+    /* the SQL here quotes strings with double quotes too, which an SQLite
+     * built without them (SQLITE_DQS=0) takes for column names */
+    sqlite3_db_config(pDb, SQLITE_DBCONFIG_DQS_DML, 1, (int *)0);
+    sqlite3_db_config(pDb, SQLITE_DBCONFIG_DQS_DDL, 1, (int *)0);
+#endif
 
     if (iRet) {
     CAL_DEBUG_LOG("Can't open database: %s", sqlite3_errmsg(pDb));
-- 
