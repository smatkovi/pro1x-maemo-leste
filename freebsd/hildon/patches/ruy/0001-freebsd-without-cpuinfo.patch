From 70febf98bdd17b22cb842c937cc99cf35ee3d3ba Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 29 Oct 2026 11:35:59 +0100
Subject: [PATCH] FreeBSD: without cpuinfo, dot products from HWCAP

---
 ruy/CMakeLists.txt |  4 ++--
 ruy/cpuinfo.cc     | 15 +++++++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/ruy/CMakeLists.txt b/ruy/CMakeLists.txt
index 67f0f54..a5c17d9 100644
--- a/ruy/CMakeLists.txt
+++ b/ruy/CMakeLists.txt
@@ -403,7 +403,7 @@ if(CMAKE_SYSTEM_PROCESSOR STREQUAL ppc64 OR CMAKE_SYSTEM_PROCESSOR STREQUAL ppc6
   set(ruy_5_DRUY_HAVE_CPUINFO "")
 elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL s390 OR CMAKE_SYSTEM_PROCESSOR STREQUAL s390x)
   set(ruy_5_DRUY_HAVE_CPUINFO "")
-elseif(CMAKE_SYSTEM_NAME STREQUAL Fuchsia)
+elseif(CMAKE_SYSTEM_NAME STREQUAL Fuchsia OR CMAKE_SYSTEM_NAME STREQUAL FreeBSD)
   set(ruy_5_DRUY_HAVE_CPUINFO "")
 else()
   set(ruy_5_DRUY_HAVE_CPUINFO "-DRUY_HAVE_CPUINFO")
@@ -413,7 +413,7 @@ if(CMAKE_SYSTEM_PROCESSOR STREQUAL ppc64 OR CMAKE_SYSTEM_PROCESSOR STREQUAL ppc6
   set(ruy_6_cpuinfo_cpuinfo "")
 elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL s390 OR CMAKE_SYSTEM_PROCESSOR STREQUAL s390x)
   set(ruy_6_cpuinfo_cpuinfo "")
-elseif(CMAKE_SYSTEM_NAME STREQUAL Fuchsia)
+elseif(CMAKE_SYSTEM_NAME STREQUAL Fuchsia OR CMAKE_SYSTEM_NAME STREQUAL FreeBSD)
   set(ruy_6_cpuinfo_cpuinfo "")
 else()
   set(ruy_6_cpuinfo_cpuinfo "cpuinfo::cpuinfo")
diff --git a/ruy/cpuinfo.cc b/ruy/cpuinfo.cc
index 8a0e912..b31ee28 100644
--- a/ruy/cpuinfo.cc
+++ b/ruy/cpuinfo.cc
@@ -12,6 +12,13 @@
 #include <cpuinfo.h>
 #endif
 
+// FreeBSD has no cpuinfo port for arm64: the kernel's HWCAP bits tell the
+// one feature ruy picks kernels by there (dot products, ARMv8.2)
+#if !defined(RUY_HAVE_CPUINFO) && defined(__FreeBSD__) && defined(__aarch64__)
+#include <sys/auxv.h>
+#define RUY_FREEBSD_HWCAP 1
+#endif
+
 namespace ruy {
 
 namespace {
@@ -158,7 +165,15 @@ bool CpuInfo::EnsureInitialized() {
   RUY_DCHECK_EQ(init_status_, InitStatus::kInitialized);
   return true;
 }
+#ifdef RUY_FREEBSD_HWCAP
+bool CpuInfo::NeonDotprod() {
+  unsigned long hwcap = 0;
+  return elf_aux_info(AT_HWCAP, &hwcap, sizeof(hwcap)) == 0 &&
+         (hwcap & HWCAP_ASIMDDP) != 0;
+}
+#else
 bool CpuInfo::NeonDotprod() { return false; }
+#endif
 bool CpuInfo::Sse42() { return false; }
 bool CpuInfo::Avx() { return false; }
 bool CpuInfo::Avx2Fma() { return false; }
-- 
2.56.0

