The launcher (conversations, which starts conversations_qml or _slim and
waits for it) has its child killed when it dies, with Linux's
PR_SET_PDEATHSIG; without sys/prctl.h (FreeBSD) the child outlived it.
hildon-session ends the background instance by ending the launcher, and
X stays for the next desktop (pro1x-desktop): the old conversations_qml
stayed on the dead session bus, and the next session's launcher only
woke it over its IPC socket and ended, again every 2 s, with no SMS
received. FreeBSD's procctl(PROC_PDEATHSIG_CTL) does the same as Linux.

--- a/src/launcher.c
+++ b/src/launcher.c
@@ -26,6 +26,9 @@
 #ifdef HAVE_SYS_PRCTL_H
 #include <sys/prctl.h>
 #include <signal.h>
+#elif defined(__FreeBSD__)
+#include <sys/procctl.h>
+#include <signal.h>
 #endif
 
 #include "lib/utils_c.h"
@@ -82,6 +85,13 @@
       perror("prctl");
       _exit(1);
     }
+#elif defined(__FreeBSD__)
+    // the same on FreeBSD
+    int sig = SIGKILL;
+    if (procctl(P_PID, 0, PROC_PDEATHSIG_CTL, &sig) == -1) {
+      perror("procctl");
+      _exit(1);
+    }
 #endif
     // pass correct argv[0] to this fork
     if (file_exists(slim_config_path)) {
