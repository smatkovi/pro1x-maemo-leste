+typedef struct {
+	SSCSensor *sensor;
+	gulong report_id;
+	guint timeout_id;
+	gboolean done;
+} FlushContext;
+
+static void
+flush_done (GTask *task, GError *error)
+{
+	FlushContext *fc = g_task_get_task_data (task);
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (fc->sensor);
+
+	if (fc->done) {
+		g_clear_error (&error);
+		return;
+	}
+	fc->done = TRUE;
+	g_object_ref (task);
+	if (fc->report_id)
+		g_signal_handler_disconnect (priv->client, fc->report_id);
+	fc->report_id = 0;
+	if (fc->timeout_id)
+		g_source_remove (fc->timeout_id);
+	fc->timeout_id = 0;
+	if (error)
+		g_task_return_error (task, error);
+	else
+		g_task_return_boolean (task, TRUE);
+	g_object_unref (task);
+}
+
+static void
+flush_report (SSCClient *client, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	FlushContext *fc = g_task_get_task_data (task);
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (fc->sensor);
+
+	if (msg_id == SSC_MSG_EVENT_FLUSH && uid_high == priv->uid_high && uid_low == priv->uid_low) {
+		g_debug ("Flush complete for '%s' sensor", priv->data_type);
+		flush_done (task, NULL);
+	}
+}
+
+static gboolean
+flush_timeout (gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	FlushContext *fc = g_task_get_task_data (task);
+
+	fc->timeout_id = 0;
+	flush_done (task, g_error_new (G_IO_ERROR, G_IO_ERROR_TIMED_OUT, "No flush event within %d ms", FLUSH_TIMEOUT_MS));
+	return G_SOURCE_REMOVE;
+}
+
+static void
+flush_sent (SSCClient *client, GAsyncResult *result, gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	GError *error = NULL;
+
+	if (!ssc_client_send_finish (client, result, &error))
+		flush_done (task, error);
+	g_object_unref (task);
+}
+
+/**
+ * ssc_sensor_flush:
+ *
+ * Asks the sensor core for everything it has batched for this sensor; the
+ * events arrive as usual ("measurement" signals), then the task completes.
+ * It fails after 5 s without the sensor core's flush event, at once for a
+ * closed sensor.
+ */
+void
+ssc_sensor_flush (SSCSensor *self, GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (self);
+	GTask *task = g_task_new (self, cancellable, callback, user_data);
+	FlushContext *fc;
+
+	if (!priv->opened) {
+		g_task_return_new_error (task, ssc_sensor_error_quark (), SSC_SENSOR_ERROR_UNAVAILABLE,
+					 "Cannot flush a sensor that is not open");
+		g_object_unref (task);
+		return;
+	}
+	fc = g_new0 (FlushContext, 1);
+	fc->sensor = self;
+	g_task_set_task_data (task, fc, g_free);
+	fc->report_id = g_signal_connect_data (priv->client, "report", G_CALLBACK (flush_report),
+					       g_object_ref (task), (GClosureNotify) g_object_unref, 0);
+	fc->timeout_id = g_timeout_add_full (G_PRIORITY_DEFAULT, FLUSH_TIMEOUT_MS, flush_timeout,
+					     g_object_ref (task), g_object_unref);
+	ssc_client_send_delivery (priv->client, priv->uid_high, priv->uid_low, SSC_MSG_REQUEST_FLUSH,
+				  NULL, &priv->delivery, cancellable,
+				  (GAsyncReadyCallback) flush_sent, g_object_ref (task));
+	g_object_unref (task);
+}
+
+gboolean
+ssc_sensor_flush_finish (SSCSensor *self, GAsyncResult *result, GError **error)
+{
+	return g_task_propagate_boolean (G_TASK (result), error);
+}
