+
+/* --batch-ms, --no-wakeup, --flush-only, --flush-every: the delivery */
+static gint cli_batch_ms = -1;
+static gboolean cli_no_wakeup = FALSE;
+static gboolean cli_flush_only = FALSE;
+static gint cli_flush_every = 0;
+
+static void
+cli_delivery (SSCSensor *sensor)
+{
+	if (cli_batch_ms < 0 && !cli_no_wakeup && !cli_flush_only)
+		return;		/* libssc.conf's */
+	ssc_sensor_set_delivery (sensor, !cli_no_wakeup,
+				 cli_batch_ms > 0 ? (guint32) cli_batch_ms * 1000 : 0, 0,
+				 cli_flush_only);
+}
+
+static void
+cli_flush_done (GObject *src, GAsyncResult *res, gpointer user_data)
+{
+	g_autoptr (GError) err = NULL;
+
+	if (ssc_sensor_flush_finish (SSC_SENSOR (src), res, &err))
+		g_printf ("Flush complete\n");
+	else
+		g_printf ("Flush failed: %s\n", err->message);
+	fflush (stdout);
+}
+
+static gboolean
+cli_flush_cb (gpointer sensor)
+{
+	ssc_sensor_flush (SSC_SENSOR (sensor), NULL, cli_flush_done, NULL);
+	return G_SOURCE_CONTINUE;
+}
+
+static void
+cli_flush (SSCSensor *sensor)
+{
+	if (cli_flush_every > 0)
+		g_timeout_add_seconds (cli_flush_every, cli_flush_cb, sensor);
+}
+
+/* --probe TYPE: whether the sensor core has a sensor of that data type */
+static void
+probe_ready (GObject *src, GAsyncResult *res, gpointer user_data)
+{
+	SSCSensor **out = user_data;
+	g_autoptr (GError) err = NULL;
+
+	*out = ssc_sensor_new_finish (res, &err);
+	if (!*out && err)
+		g_printf ("Probing failed: %s\n", err->message);
+	*out = *out ? *out : (SSCSensor *) GINT_TO_POINTER (1);
+}
+
+static int
+probe (const gchar *data_type)
+{
+	SSCSensor *sensor = NULL;
+	g_autofree gchar *name = NULL, *vendor = NULL;
+	guint stream_type = 0;
+	gboolean available = FALSE;
+	gfloat rate = 0;
+
+	ssc_sensor_new ((gchar *) data_type, NULL, probe_ready, &sensor);
+	while (!sensor)
+		g_main_context_iteration (NULL, TRUE);
+	if (sensor == (SSCSensor *) GINT_TO_POINTER (1)) {
+		g_printf ("No '%s' sensor\n", data_type);
+		return INIT_FAIL_EXIT_CODE;
+	}
+	g_object_get (sensor, SSC_SENSOR_NAME, &name, SSC_SENSOR_VENDOR, &vendor,
+		      SSC_SENSOR_STREAM_TYPE, &stream_type, SSC_SENSOR_AVAILABLE, &available,
+		      SSC_SENSOR_SAMPLE_RATE, &rate, NULL);
+	g_printf ("'%s' sensor: %s (%s), %s, %s, lowest rate %.1f Hz\n", data_type,
+		  name ? name : "?", vendor ? vendor : "?",
+		  stream_type == 1 ? "on-change" : "streaming",
+		  available ? "available" : "not available", rate);
+	g_object_unref (sensor);
+	return 0;
+}
