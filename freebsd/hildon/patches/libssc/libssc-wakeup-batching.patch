+#ifndef _LIBSSC_REQUEST_PRIVATE_H_
+#define _LIBSSC_REQUEST_PRIVATE_H_
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+#define SSC_SUSPEND_MODE_NO_WAKEUP	1
+
+/*
+ * How the sensor core delivers a sensor's events (SscClientConfig and
+ * SscClientRequestBody.batching of the enable request):
+ *
+ * @wakeup: TRUE: events are sent as they become due, also to a suspended
+ *   application processor (WAKEUP, libssc's only mode before). FALSE: the
+ *   sensor core keeps them while the processor is suspended and sends them
+ *   when it is awake again (NO_WAKEUP).
+ * @batch_period_us: events wait up to this long in the sensor core and go
+ *   out together, one report for many; 0: every event at once. The core
+ *   treats periods below its registry's min_batch_period_thrshld_ms (10 ms
+ *   on the SM6115) as 0 and rejects periods below 1 ms.
+ * @flush_period_us: the core keeps at least this much of the newest events;
+ *   0: its default (the batch period plus 0.75 s).
+ * @flush_only: events only on a flush request or when the buffer is full.
+ *
+ * Without any of these (wakeup TRUE, the rest 0) the request carries no
+ * batch spec at all and is the same as libssc's before.
+ */
+typedef struct {
+	gboolean wakeup;
+	guint32 batch_period_us;
+	guint32 flush_period_us;
+	gboolean flush_only;
+} SSCDelivery;
+
+#define SSC_DELIVERY_DEFAULT { TRUE, 0, 0, FALSE }
+
+GArray		*ssc_request_pack	(guint64 uid_high, guint64 uid_low, guint32 msg_id,
+					 const guint8 *payload, gsize payload_len,
+					 const SSCDelivery *delivery);
+
+void		 ssc_request_delivery_defaults	(const gchar *data_type, gboolean continuous,
+						 SSCDelivery *delivery);
+
+void		 ssc_request_reset_config	(void);
+
+gboolean	 ssc_report_parse_count		(const guint8 *buf, gsize len, guint *count);
+
+G_END_DECLS
+
+#endif /* _LIBSSC_REQUEST_PRIVATE_H_ */
