+/*
+ * One client request to the sensor core (SscClientRequest): the sensor, the
+ * message, the delivery (suspend config and batch spec) and the sensor's own
+ * payload. The field numbers are those of the sensor core's client API
+ * (sns_client_request_msg, its suspend_config and sns_std_request with its
+ * batch_spec), see docs/sensors.md in the Pro1X repository.
+ */
+GArray *
+ssc_request_pack (guint64 uid_high, guint64 uid_low, guint32 msg_id,
+		  const guint8 *payload, gsize payload_len, const SSCDelivery *delivery)
+{
+	static const SSCDelivery fallback = SSC_DELIVERY_DEFAULT;
+	SscClientRequest client_msg;
+	SscClientConfig config_msg;
+	SscClientRequestBody body_msg;
+	SscBatchSpec batch_msg;
+	SscUid uid_msg;
+	GArray *buf;
+
+	if (!delivery)
+		delivery = &fallback;
+
+	ssc_client_config__init (&config_msg);
+	config_msg.processor = SSC_PROCESSOR_APSS_ID;
+	config_msg.suspend_mode = delivery->wakeup ? SSC_SUSPEND_WAKEUP_ID : SSC_SUSPEND_MODE_NO_WAKEUP;
+
+	ssc_client_request_body__init (&body_msg);
+	if (payload) {
+		body_msg.has_msg = true;
+		body_msg.msg.data = (uint8_t *) payload;
+		body_msg.msg.len = payload_len;
+	}
+
+	/* Only a request that batches carries a batch spec: without one the
+	 * bytes are the same as before batching existed in libssc */
+	ssc_batch_spec__init (&batch_msg);
+	if (delivery->batch_period_us > 0 || delivery->flush_only) {
+		batch_msg.batch_period = delivery->batch_period_us;
+		if (delivery->flush_period_us > 0) {
+			batch_msg.has_flush_period = true;
+			batch_msg.flush_period = MAX (delivery->flush_period_us, delivery->batch_period_us);
+		}
+		if (delivery->flush_only) {
+			batch_msg.has_flush_only = true;
+			batch_msg.flush_only = true;
+		}
+		body_msg.batching = &batch_msg;
+	}
+
+	ssc_uid__init (&uid_msg);
+	uid_msg.low = uid_low;
+	uid_msg.high = uid_high;
+
+	ssc_client_request__init (&client_msg);
+	client_msg.uid = &uid_msg;
+	client_msg.msg_id = msg_id;
+	client_msg.config = &config_msg;
+	client_msg.request = &body_msg;
+
+	buf = g_array_new (FALSE, FALSE, 1);
+	g_array_set_size (buf, ssc_client_request__get_packed_size (&client_msg));
+	ssc_client_request__pack (&client_msg, (unsigned char *) buf->data);
+
+	return buf;
+}
+
+/*****************************************************************************/
+
+/*
+ * The system's defaults for the delivery, from libssc.conf: LIBSSC_CONF if
+ * set (empty: none), else /etc/libssc.conf, else /usr/local/etc/libssc.conf.
+ *
+ *   [delivery]
+ *   continuous-batch-ms=200
+ *	batch period of streaming sensors (accelerometer, gyroscope,
+ *	magnetometer, ...); on-change sensors (light, proximity, the step
+ *	counter) report rarely and are not batched by default
+ *   no-wakeup=accel;mag;gyro;rotv;ambient_light;pedometer
+ *	data types whose events never wake a suspended processor
+ *
+ * The environment overrides the file for one process:
+ * LIBSSC_CONTINUOUS_BATCH_MS and LIBSSC_NO_WAKEUP (separated by ';' or ',').
+ * Without the file and the variables nothing changes: every event at once,
+ * waking the processor, as libssc did before. A client can still set its
+ * own (ssc_sensor_set_delivery).
+ */
+
+typedef struct {
+	guint continuous_batch_ms;
+	gchar **no_wakeup;
+} DeliveryConfig;
+
+static DeliveryConfig *config;
+G_LOCK_DEFINE_STATIC (config);
+
+static gchar **
+split_list (const gchar *s)
+{
+	gchar **v = g_strsplit_set (s, ";, \t", -1);
+	GPtrArray *out = g_ptr_array_new ();
+
+	for (gchar **p = v; *p; p++)
+		if (**p)
+			g_ptr_array_add (out, g_strdup (*p));
+	g_ptr_array_add (out, NULL);
+	g_strfreev (v);
+	return (gchar **) g_ptr_array_free (out, FALSE);
+}
+
+static DeliveryConfig *
+load_config (void)
+{
+	DeliveryConfig *c = g_new0 (DeliveryConfig, 1);
+	const gchar *env = g_getenv ("LIBSSC_CONF");
+	const gchar *files[] = { "/etc/libssc.conf", "/usr/local/etc/libssc.conf", NULL };
+	g_autoptr (GKeyFile) kf = g_key_file_new ();
+	gboolean loaded = FALSE;
+	const gchar *v;
+
+	if (env) {
+		if (*env)
+			loaded = g_key_file_load_from_file (kf, env, G_KEY_FILE_NONE, NULL);
+	} else {
+		for (guint i = 0; files[i] && !loaded; i++)
+			loaded = g_key_file_load_from_file (kf, files[i], G_KEY_FILE_NONE, NULL);
+	}
+
+	if (loaded) {
+		g_autofree gchar *list = NULL;
+		gint ms = g_key_file_get_integer (kf, "delivery", "continuous-batch-ms", NULL);
+
+		c->continuous_batch_ms = ms > 0 ? (guint) ms : 0;
+		list = g_key_file_get_value (kf, "delivery", "no-wakeup", NULL);
+		if (list)
+			c->no_wakeup = split_list (list);
+	}
+
+	v = g_getenv ("LIBSSC_CONTINUOUS_BATCH_MS");
+	if (v)
+		c->continuous_batch_ms = (guint) strtoul (v, NULL, 10);
+	v = g_getenv ("LIBSSC_NO_WAKEUP");
+	if (v) {
+		g_strfreev (c->no_wakeup);
+		c->no_wakeup = split_list (v);
+	}
+	if (!c->no_wakeup)
+		c->no_wakeup = g_new0 (gchar *, 1);
+
+	/* the sensor core rejects batch periods below 1 ms and streams below
+	 * its threshold anyway; keep a period within what a uint32 of
+	 * microseconds holds */
+	c->continuous_batch_ms = MIN (c->continuous_batch_ms, G_MAXUINT32 / 1000);
+
+	g_debug ("Delivery defaults: continuous sensors batched %u ms, no wakeup for '%s'",
+		 c->continuous_batch_ms, c->no_wakeup[0] ? c->no_wakeup[0] : "");
+	return c;
+}
+
+void
+ssc_request_reset_config (void)
+{
+	G_LOCK (config);
+	if (config) {
+		g_strfreev (config->no_wakeup);
+		g_free (config);
+		config = NULL;
+	}
+	G_UNLOCK (config);
+}
+
+void
+ssc_request_delivery_defaults (const gchar *data_type, gboolean continuous, SSCDelivery *delivery)
+{
+	G_LOCK (config);
+	if (!config)
+		config = load_config ();
+
+	delivery->wakeup = !(data_type && g_strv_contains ((const gchar * const *) config->no_wakeup, data_type));
+	delivery->batch_period_us = continuous ? config->continuous_batch_ms * 1000 : 0;
+	delivery->flush_period_us = 0;
+	delivery->flush_only = FALSE;
+	G_UNLOCK (config);
+}
+
+/*****************************************************************************/
+
+static gboolean
+read_varint (const guint8 **p, const guint8 *end, guint64 *value)
+{
+	guint shift = 0;
+
+	*value = 0;
+	while (*p < end && shift < 64) {
+		guint8 b = *(*p)++;
+		*value |= (guint64)(b & 0x7f) << shift;
+		if (!(b & 0x80))
+			return TRUE;
+		shift += 7;
+	}
+	return FALSE;
+}
+
+/*
+ * The count in a step counter's report: field 1, a varint (the step events
+ * 1028 and 775), a float or packed floats (a standard sensor event, 1025).
+ */
+gboolean
+ssc_report_parse_count (const guint8 *buf, gsize len, guint *steps)
+{
+	const guint8 *p = buf, *end = buf + len;
+	guint64 key, value;
+	gfloat f;
+
+	while (p < end) {
+		if (!read_varint (&p, end, &key))
+			return FALSE;
+		switch (key & 7) {
+		case 0:
+			if (!read_varint (&p, end, &value))
+				return FALSE;
+			if ((key >> 3) == 1) {
+				*steps = (guint) value;
+				return TRUE;
+			}
+			break;
+		case 1:
+			p += 8;
+			break;
+		case 2:
+			if (!read_varint (&p, end, &value) || value > (guint64)(end - p))
+				return FALSE;
+			if ((key >> 3) == 1 && value >= sizeof (f)) {
+				memcpy (&f, p, sizeof (f));
+				*steps = f > 0 ? (guint)(f + 0.5f) : 0;
+				return TRUE;
+			}
+			p += value;
+			break;
+		case 5:
+			if (end - p < 4)
+				return FALSE;
+			if ((key >> 3) == 1) {
+				memcpy (&f, p, sizeof (f));
+				*steps = f > 0 ? (guint)(f + 0.5f) : 0;
+				return TRUE;
+			}
+			p += 4;
+			break;
+		default:
+			return FALSE;
+		}
+	}
+	return FALSE;
+}
