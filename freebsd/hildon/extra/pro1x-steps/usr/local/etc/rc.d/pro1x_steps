#!/bin/sh
#
# PROVIDE: pro1x_steps
# REQUIRE: dbus hexagonrpcd
# KEYWORD: nojail shutdown
#
# The ADSP's hardware step counter on the system bus (org.pro1x.Steps,
# tools/pro1x-steps), as on Leste.
#
#   pro1x_steps_enable="YES"

. /etc/rc.subr

name=pro1x_steps
rcvar=pro1x_steps_enable
load_rc_config $name
: ${pro1x_steps_enable:=NO}

pidfile=/var/run/${name}.pid
procname=/usr/local/sbin/pro1x-steps
command=/usr/sbin/daemon
command_args="-r -R 5 -P ${pidfile} -o /var/log/pro1x-steps.log ${procname}"

run_rc_command "$1"
