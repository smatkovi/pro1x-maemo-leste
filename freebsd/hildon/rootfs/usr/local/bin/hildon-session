#!/bin/sh
# Hildon on FreeBSD (F(x)tec Pro1X): what Leste's Xsession.d and
# Xsession.post scripts do, for startx:
#   startx hildon     (~/.xinitrc), or startx /usr/local/bin/hildon-session
# The status menu and home run beside hildon-desktop and come back when
# they crash (Leste: dsmetool -t). The session ends with hildon-desktop and
# takes them along: X may stay for the next desktop (pro1x-desktop).
export GTK2_RC_FILES=/etc/hildon/theme/gtk-2.0/gtkrc
# FreeBSD's login class sets C.UTF-8, which has no texts: English then
case ${LANG:-C} in C|C.*|POSIX) LANG=en_GB.UTF-8 ;; esac
export LANG
export HILDON_DESKTOP_APPS_PRESTART=auto
export CLUTTER_BACKEND=x11
# Qt apps in Hildon's look (Leste's /etc/profile.d/qt-maemo.sh; its "maemo"
# platform plugin is Leste's own Qt, FreeBSD's Qt has xcb)
export QT_STYLE_OVERRIDE=maemo5 QT_QPA_PLATFORMTHEME=maemo5
# The image loaders' list: on the Pro1X built at boot (rc.d/pro1x_setup)
if [ -f /var/db/gdk-pixbuf-loaders.cache ]; then
	export GDK_PIXBUF_MODULE_FILE=/var/db/gdk-pixbuf-loaders.cache
fi

mkdir -p /tmp/hildon-desktop /tmp/af-piddir
# As Leste: no key repeat for Return and the hardware keys
xset -r 36 -r 70 -r 72 -r 9 -r 104 2> /dev/null

# At the N900's size on the full resolution: HILDON_SCALE, GTK 3 and Qt
# factors, Xft.dpi (pro1x-hidpi)
eval "$(/usr/local/bin/pro1x-hidpi env)"
/usr/local/bin/pro1x-hidpi x11

# The bus ends with the X server (or at the end of this session, below);
# --exit-with-session would end it when stdin closes
eval "$(dbus-launch --sh-syntax --exit-with-x11)"

# The theme engine's image server, before any GTK program (Leste:
# Xsession.d/03gtk2-engines-sapwood, there without shared memory images)
GDK_DISABLE_XSHM=1 /usr/local/lib/sapwood/sapwood-server &
sapwood=$!
# Hildon's icons are in hicolor's hildon directories, which FreeBSD's
# hicolor index does not list: a merged index found first (osso-icons-default)
export XDG_DATA_DIRS=/usr/local/share/pro1x/hicolor-hildon:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
# Qt 5's tools (qmlscene, for QML apps such as gPodder)
export PATH=$PATH:/usr/local/lib/qt5/bin

# A daemon restarted when it ends, for as long as this session runs: a
# loop left over from a session that was killed would restart a daemon
# without its bus every 2 s for ever.
session=$$
respawn() {
	trap 'kill $pid 2> /dev/null; exit 0' TERM
	while kill -0 "$session" 2> /dev/null; do
		"$@" &
		pid=$!
		wait $pid
		sleep 2
	done
}
# The alarm daemon and the system UI, which shows its alarm dialog (Leste:
# Xsession.d/03alarmd and 03osso-systemui): alarmd needs this session's
# bus, so alarms ring while Hildon runs. Its queue is in /var/cache/alarmd
# (kept over a reboot only with the writable ZFS root).
alarm=
if [ -x /usr/local/sbin/alarmd ]; then
	mkdir -p /var/cache/alarmd
	respawn /usr/local/sbin/alarmd &
	alarm=$!
fi
if [ -x /usr/local/bin/systemui ]; then
	respawn /usr/local/bin/systemui &
	alarm="$alarm $!"
fi
# Sounds play through PulseAudio, which starts for the session when there
# is a sound device. The notification and alarm sound daemon from the
# start, not at the first sound: it decodes the profile's and the alarms'
# tones into WAV files 90 s after its start, and an alarm that comes
# before finds none. Then the key and touch screen clicks of Maemo 5 at
# the profile's key sound level (Leste:
# Xsession.post/01maemo-xinput-sounds-start).
sounds=
if command -v pulseaudio > /dev/null; then
	pulseaudio --start --exit-idle-time=-1 2> /dev/null || true
fi
if [ -x /usr/local/bin/hildon-sv-notification-daemon ]; then
	respawn /usr/local/bin/hildon-sv-notification-daemon &
	sounds=$!
fi
if [ -x /usr/local/bin/maemo-xinput-sounds ]; then
	respawn /usr/local/bin/maemo-xinput-sounds &
	sounds="$sounds $!"
fi
respawn /usr/local/bin/hildon-status-menu &
menu=$!
respawn /usr/local/bin/hildon-home &
home=$!
/usr/local/bin/hildon-desktop
kill $menu $home $alarm $sounds $sapwood 2> /dev/null
kill "$DBUS_SESSION_BUS_PID" 2> /dev/null
xset r 36 r 70 r 72 r 9 r 104 2> /dev/null
