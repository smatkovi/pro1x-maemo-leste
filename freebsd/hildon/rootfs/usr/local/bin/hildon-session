#!/bin/sh
# Hildon on FreeBSD (F(x)tec Pro1X): what Leste's Xsession.d and
# Xsession.post scripts do, for startx:
#   startx hildon     (~/.xinitrc), or startx /usr/local/bin/hildon-session
# The status menu and home run beside hildon-desktop and come back when
# they crash (Leste: dsmetool -t). The session ends with hildon-desktop and
# takes them along: X may stay for the next desktop (pro1x-desktop).
export GTK2_RC_FILES=/etc/hildon/theme/gtk-2.0/gtkrc
export LANG=${LANG:-en_GB.UTF-8}
export HILDON_DESKTOP_APPS_PRESTART=auto
export CLUTTER_BACKEND=x11
# The image loaders' list, built at boot (rc.d/pro1x_setup)
export GDK_PIXBUF_MODULE_FILE=/var/db/gdk-pixbuf-loaders.cache

mkdir -p /tmp/hildon-desktop /tmp/af-piddir
# As Leste: no key repeat for Return and the hardware keys
xset -r 36 -r 70 -r 72 -r 9 -r 104 2> /dev/null

# At the N900's size on the full resolution: HILDON_SCALE, GTK 3 and Qt
# factors, Xft.dpi (pro1x-hidpi)
eval "$(/usr/local/bin/pro1x-hidpi env)"
/usr/local/bin/pro1x-hidpi x11

eval "$(dbus-launch --sh-syntax --exit-with-session)"

respawn() {
	trap 'kill $pid 2> /dev/null; exit 0' TERM
	while :; do
		"$@" &
		pid=$!
		wait $pid
		sleep 2
	done
}
respawn /usr/local/bin/hildon-status-menu &
menu=$!
respawn /usr/local/bin/hildon-home &
home=$!
/usr/local/bin/hildon-desktop
kill $menu $home 2> /dev/null
kill "$DBUS_SESSION_BUS_PID" 2> /dev/null
xset r 36 r 70 r 72 r 9 r 104 2> /dev/null
