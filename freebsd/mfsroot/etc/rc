#!/bin/sh
# FreeBSD on the Pro1X: the root filesystem in RAM (built into the kernel).
#
# Reports what the kernel found on the console (the screen and the RAM
# console, which Linux reads after the next boot). Then, as Leste's boot
# does with its loop image: userdata read only at /dev/pro1x-host (below
# /dev, which the kernel keeps across a reroot: patches/0012, 0016), the
# root image from it as md1, and a reroot into it: the writable ZFS pool
# freebsd/pool.zfs (Leste's pro1x-freebsd-pool made it; through its own
# blocks, /etc/pro1x-pool.sh), its boot environment read-write; else
# freebsd/root.zfs (the ZFS pool "pro1x" of rootzfs.sh, imported read
# only). The root is ZFS only: without either, no system starts.
#
# Kernel environment (freebsd/cmdline next to the kernel):
#   pro1x.root=ram   stay here: report (userdata and the image attached
#                    and released again), then Enter for a shell or reboot
#   pro1x.pool=off   not the writable pool: root.zfs read only
#   pro1x.be=NAME    the writable pool's boot environment NAME (else its
#                    bootfs; b + Enter within 5 s at boot: a menu)
#   pro1x.test=1     unattended test: the full system reports and reboots
PATH=/rescue; export PATH
. /etc/pro1x-pool.sh
HOST=/dev/pro1x-host
ZIMAGE=$HOST/freebsd/root.zfs

echo "=== FreeBSD on the F(x)tec Pro1X: rc ==="
uname -a
sysctl hw.model hw.machine_arch hw.ncpu hw.physmem kern.bootfile
echo "--- devices:"
echo /dev/*
echo "--- disks:"
camcontrol devlist
gpart show -p
echo "--- input:"
ls /dev/input /dev/kbd* 2>/dev/null
sysctl dev.pro1x_battery hw.acpi dev.cpu.0.freq dev.cpu.0.freq_levels \
    2>/dev/null

# pro1x.test=smp|idle|suspend|usb: the power management device tests
# (/etc/pro1x-pmtest.sh, freebsd/pm/README.md); each reboots at its end
. /etc/pro1x-pmtest.sh

# pro1x.test=power: the standby power of FreeBSD itself, here in the RAM
# root (no desktop): the panel off (DCS), both clusters at their lowest
# frequency (what powerd's adaptive mode gives an idle system), the
# charger's USB input suspended (on the battery with the cable in:
# patches/0030), the battery every 30 s on the console for pro1x.power_min
# minutes (30), then the input back and back to the boot menu. Linux
# reads the console after the next boot (scripts/68-power-standby.sh's
# logger has the same columns).
if [ "$(kenv -q pro1x.test)" = power ]; then
	min=$(kenv -q pro1x.power_min)
	min=${min:-30}
	echo "=== power: $min min, the panel off, on the battery"
	sysctl dev.qcom_dpu.0.display=0
	for c in 0 4; do
		l=$(sysctl -n dev.cpu.$c.freq_levels 2>/dev/null) || continue
		l=${l##* }
		sysctl dev.cpu.$c.freq=${l%%/*}
	done
	sysctl dev.pro1x_battery.0.input_suspend=1
	echo "power: s mA mV % status"
	t=0
	while [ $t -lt $((min * 60)) ]; do
		sleep 30
		t=$((t + 30))
		i=$(sysctl -n dev.pro1x_battery.0.current)
		v=$(sysctl -n dev.pro1x_battery.0.voltage)
		echo "power: $t $((-i / 1000)) $((v / 1000)) $(sysctl -n dev.pro1x_battery.0.capacity)" \
		    "$(sysctl -n dev.pro1x_battery.0.status)"
	done
	sysctl dev.pro1x_battery.0.input_suspend=0
	sysctl dev.qcom_dpu.0.display=1
	echo "=== power: done, rebooting"
	reboot
fi

if [ -e /dev/gpt/userdata ] && [ -d $HOST ] &&
    mount -t ext2fs -o ro /dev/gpt/userdata $HOST; then
	echo "--- userdata at $HOST:"
	df -h $HOST
	ls -la $HOST/freebsd
	if [ "$(kenv -q pro1x.pool)" != off ] &&
	    sysctl -q vfs.zfs.version.spa > /dev/null &&
	    pool_rw $HOST /dev/gpt/userdata; then
		zfs list -o name,used,avail,refer,compressratio
		if [ "$(kenv -q pro1x.root)" != ram ]; then
			bootfs=$(pool_bootfs)
			kenv vfs.root.mountfrom=zfs:$bootfs
			kenv vfs.root.mountfrom.options=rw
			kenv pro1x.rootrw=1
			echo "=== rerooting into $bootfs (read-write)"
			reboot -r
			exit 0
		fi
		zpool export pro1x
		pool_undo
		mount -t ext2fs -o ro /dev/gpt/userdata $HOST
	fi
	if [ -f $ZIMAGE ] &&
	    sysctl -q vfs.zfs.version.spa > /dev/null &&
	    mdconfig -a -t vnode -o readonly -f $ZIMAGE -u 1; then
		if zpool import -f -N -o readonly=on -o cachefile=none \
		    -d /dev/md1 pro1x; then
			zfs list -o name,used,refer,compressratio
			if [ "$(kenv -q pro1x.root)" != ram ]; then
				kenv vfs.root.mountfrom=zfs:pro1x/ROOT/default
				kenv vfs.root.mountfrom.options=ro
				echo "=== rerooting into $ZIMAGE"
				reboot -r
				exit 0
			fi
			zpool export pro1x
		else
			echo "!! $ZIMAGE: no pool pro1x"
		fi
		mdconfig -d -u 1
	fi
	umount $HOST
fi

# No ZFS root (or pro1x.root=ram): with the keyboard (gpiokeys, pro1xkbd behind kbdmux)
# Enter starts a shell on the console; otherwise back to the boot menu,
# which also ends unattended tests.
echo "=== rc done: Enter within 10 s for a shell, else reboot"
if read -t 10 key < /dev/console; then
	echo "shell; 'reboot' returns to the boot menu"
	exec sh < /dev/console > /dev/console 2>&1
fi
reboot
