#!/bin/sh
# First FreeBSD on the Pro1X: a root filesystem in RAM, no keyboard yet.
# Reports what the kernel found on the console (the screen and the RAM
# console, which Linux reads after the next boot), then reboots into the
# boot menu.
PATH=/rescue; export PATH
echo "=== FreeBSD on the F(x)tec Pro1X: rc ==="
uname -a
sysctl hw.model hw.machine_arch hw.ncpu hw.physmem kern.bootfile
echo "--- devices:"
echo /dev/*
echo "=== rc done, rebooting into the boot menu in 30 s"
sleep 30
reboot
