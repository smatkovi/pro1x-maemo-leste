# PRO1XQ's static environment: all CPUs; the rest from QEMU's -append
# ("FreeBSD:..." on the command line, patches/0018)
kern.smp.disabled=0
# the root filesystem in RAM (the phone's boot menu passes no root either)
vfs.root.mountfrom=ufs:/dev/md0
# qcom_rtc_sim: the PL031's count less 1700000000 is the "PMIC's" count, the
# offset handed over as on the phone (the system clock then real)
hint.qcom_rtc.0.offset=1700000000
