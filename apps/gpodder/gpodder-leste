#!/bin/sh
# gPodder 4 with the touch QML UI on Maemo Leste (apps/gpodder/install.sh)
for d in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_DATA_HOME:-$HOME/.local/share}" \
	"${XDG_CACHE_HOME:-$HOME/.cache}"; do
	mkdir -p "$d/gpodder"
done
export PYTHONPATH=/opt/gpodder/lib${PYTHONPATH:+:$PYTHONPATH}
exec qmlscene /opt/gpodder/touch/gpodder.qml "$@"
