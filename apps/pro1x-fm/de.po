# German for pro1x-fm
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de\n"

msgid "FM Radio"
msgstr "UKW-Radio"

msgid "Seek down"
msgstr "Suchen ◀"

msgid "Seek up"
msgstr "Suchen ▶"

msgid "Mute"
msgstr "Stumm"

msgid "Stereo"
msgstr "Stereo"

msgid "Mono"
msgstr "Mono"

msgid "Stereo  RDS"
msgstr "Stereo  RDS"

msgid "Mono  RDS"
msgstr "Mono  RDS"

msgid "Stations"
msgstr "Sender"

msgid "Save station"
msgstr "Sender speichern"

msgid "Remove station"
msgstr "Sender entfernen"

msgid "Station saved"
msgstr "Sender gespeichert"

msgid "Station removed"
msgstr "Sender entfernt"

msgid "No saved stations"
msgstr "Keine gespeicherten Sender"

msgid "Searching..."
msgstr "Suche läuft …"

msgid "No station found."
msgstr "Kein Sender gefunden."

msgid "The receiver is busy."
msgstr "Der Empfänger ist beschäftigt."

msgid "The receiver does not answer."
msgstr "Der Empfänger antwortet nicht."

msgid "No FM receiver (kernel without radio-qca-fm?)"
msgstr "Kein UKW-Empfänger (Kernel ohne radio-qca-fm?)"

msgid "Bluetooth is blocked or failed: the receiver needs it powered."
msgstr "Bluetooth ist gesperrt oder ausgefallen: der Empfänger braucht es eingeschaltet."

msgid "No FM sound yet: the receiver's SLIMbus path is missing."
msgstr "Noch kein UKW-Ton: der SLIMbus-Weg des Empfängers fehlt."

msgid "Plug in headphones: their cable is the antenna."
msgstr "Bitte Kopfhörer anschließen: ihr Kabel ist die Antenne."

msgid "Switching the receiver on (the headphone cable is the antenna)..."
msgstr "Empfänger wird eingeschaltet (das Kopfhörerkabel ist die Antenne) …"

msgid "The FM sound does not start (see the kernel log)."
msgstr "Der UKW-Ton startet nicht (siehe Kernel-Protokoll)."

msgid "No FM sound: its path did not come up (see pro1x-fmd's log)."
msgstr "Kein UKW-Ton: Sein Weg ist nicht zustande gekommen (siehe Protokoll von pro1x-fmd)."

msgid "The FM sound reaches the DSP; FreeBSD has no headphone output for it yet."
msgstr "Der UKW-Ton erreicht den DSP; FreeBSD hat für ihn noch keinen Kopfhörerausgang."

msgid "The FM daemon pro1x-fmd is not running."
msgstr "Der UKW-Dienst pro1x-fmd läuft nicht."

msgid "The Bluetooth chip did not come up (see pro1x-fmd's log)."
msgstr "Der Bluetooth-Chip ist nicht hochgefahren (siehe das Protokoll von pro1x-fmd)."
