#!/bin/sh
# pro1x-boot -- choose what the F(x)tec Pro1X boots.
#
#   pro1x-boot list                 systems, default, next, active slot
#   pro1x-boot next <system>        boot <system> once, on the next start
#   pro1x-boot default <system>     preselect <system> in the boot menu
#   pro1x-boot timeout <seconds>    boot menu countdown (0 = no menu)
#   pro1x-boot slot a|b             make the bootloader start slot a or b
#   pro1x-boot reboot <system>      next <system> + reboot
#   pro1x-boot current              the system that is running now
#   pro1x-boot trial <kernel> [n]   slot b on trial for kernel version <kernel>
#                                   (after flashing it, 65-kernel-update.sh): n
#                                   starts (2-7, default 3), then slot a
#   pro1x-boot trial-ok             (in a system) this start of the kernel on
#                                   trial went well; the next boot ends the trial
#   pro1x-boot trial-stop           end a trial by hand (slot b as before)
#
# Systems: leste, meego, kali, luneos, arch, freebsd, kolibri (started from slot b through
# the boot menu in the initramfs) and sailfish (slot a, its own kernel). MeeGo is
# Harmattan (/harmattan.img) running on Maemo Leste's hardware layer: from its
# own copy of it (/meego-leste.img, meego/45-meego-image.sh) or else from the
# Leste image; the initramfs records the choice in pro1x-boot/current.
# Kali (/kali.img, kali/ in the repo), LuneOS (/luneos.img, luneos/) and
# Arch Linux ARM (/arch.img, arch/) boot Leste's kernel from their own images;
# more such systems can be listed in $CONF/extra (lines key|label|image|,
# read by the initramfs too, so a new one needs no new boot image).
# A system on Btrfs (Arch) lists its snapshots in $CONF/snapshots/<key>
# (lines number|label, written by the system itself): the menu then has
# "<label>: snapshots", and <key>@<number> boots that snapshot (read-only,
# with its changes in RAM); FreeBSD (/freebsd/kernel.bin, freebsd/) and
# KolibriOS (/kolibri/kernel.bin, github smatkovi/kolibrios-arm) their own
# kernels, which the initramfs starts with kexec.
# Works in the initramfs, in Maemo Leste/MeeGo (userdata on /host) and in
# Sailfish OS (userdata on /userdata), so the choice never depends on keys:
# pick the next system from the running one, then reboot.
#
# Internal, for the initramfs: entries, snapshots, take-next, get-default, get-timeout,
# set-current.
set -eu

if [ -n "${PRO1X_BOOT_HOST:-}" ]; then HOST=$PRO1X_BOOT_HOST
elif [ -d /host/pro1x-boot ] || grep -q ' /host ' /proc/mounts 2>/dev/null; then HOST=/host
else HOST=/userdata
fi
CONF=$HOST/pro1x-boot

die() { echo "pro1x-boot: $*" >&2; exit 1; }

# key|label|image|also-needed -- the image is empty for sailfish (a slot);
# "a:b" means the first of the images that exists
all_entries() {
	echo "leste|Maemo Leste|/maemo-leste.img|"
	echo "meego|MeeGo Harmattan|/meego-leste.img:/maemo-leste.img|/harmattan.img"
	echo "kali|Kali Linux|/kali.img|"
	echo "luneos|LuneOS|/luneos.img|"
	echo "arch|Arch Linux ARM|/arch.img|"
	echo "freebsd|FreeBSD|/freebsd/kernel.bin|"
	echo "kolibri|KolibriOS|/kolibri/kernel.bin|"
	echo "sailfish|Sailfish OS||"
	# more images booted with Leste's kernel, one key|label|image| a line
	[ ! -f "$CONF/extra" ] || grep -E '^[a-z0-9-]+\|[^|]+\|/[^|]+\|$' "$CONF/extra" || true
}

# key|label|image of the systems that are installed, and after a system
# with snapshots one entry key@|label: snapshots|image for them
entries() {
	all_entries | while IFS='|' read -r key label images needs; do
		image=
		for i in $(echo "$images" | tr ':' ' '); do
			[ -f "$HOST$i" ] && { image=$i; break; }
		done
		if [ -n "$images" ]; then
			if [ -n "$image" ] && { [ -z "$needs" ] || [ -f "$HOST$needs" ]; }; then
				echo "$key|$label|$image"
				[ ! -s "$CONF/snapshots/$key" ] ||
					echo "$key@|$label: snapshots|$image"
			fi
		elif part_of boot_a >/dev/null 2>&1; then
			echo "$key|$label|$image"
		fi
	done
}

# key@number|label of a system's snapshots, newest first
snapshots() {
	[ -f "$CONF/snapshots/$1" ] || return 0
	grep -E '^[0-9]+\|' "$CONF/snapshots/$1" | sort -t'|' -k1,1 -rn |
		sed "s/^/$1@/"
}

valid_key() {
	case $1 in
	*@[0-9]*)
		snapshots "${1%@*}" | cut -d'|' -f1 | grep -qx "$1" ||
			die "no snapshot ${1#*@} of '${1%@*}'"
		return ;;
	esac
	all_entries | cut -d'|' -f1 | grep -qx "$1" || die "unknown system '$1' ($(all_entries | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//; s/ /, /g'))"
}

# tries left and "successful" of boot_b, as the bootloader sees them
slot_b_state() {
	p=$(part_of boot_b) || return 1
	set -- $p
	a=$(attrs "$1" "$2")
	echo "$(( (0x$a >> 51) & 7 )) tries left, $( [ $(( (0x$a >> 54) & 1 )) -eq 1 ] &&
		echo successful || echo not successful)"
}

# "disk partition-number" for a partition label
part_of() {
	# (tests: the partitions of a GPT in an image file)
	if [ -n "${PRO1X_BOOT_GPT:-}" ]; then
		n=$(sgdisk -p "$PRO1X_BOOT_GPT" | awk -v l="$1" '$NF == l { print $1 }')
		[ -n "$n" ] && echo "$PRO1X_BOOT_GPT $n"
		return
	fi
	dev=$(readlink -f "/dev/disk/by-partlabel/$1" 2>/dev/null || true)
	[ -b "$dev" ] || dev=$(blkid -t "PARTLABEL=$1" -o device 2>/dev/null | head -1)
	[ -b "$dev" ] || return 1
	name=${dev##*/}
	disk=$(basename "$(readlink -f "/sys/class/block/$name/..")")
	echo "/dev/$disk $(cat "/sys/class/block/$name/partition")"
}

attrs() { sgdisk -i "$2" "$1" | sed -n 's/^Attribute flags: //p'; }

active_slot() {
	p=$(part_of boot_a) || return 1
	set -- $p
	a=$(attrs "$1" "$2")
	# bit 50 of the GPT attributes = slot active (Qualcomm layout)
	case $(( (0x${a%????????????} >> 2) & 1 )) in 1) echo a ;; *) echo b ;; esac
}

# Qualcomm A/B attribute bits: 48-49 priority, 50 active, 51-53 retry
# count, 54 successful, 55 unbootable. Like `fastboot set_active` the target
# gets priority 3, active, 7 retries; unlike it, "successful" is kept set,
# because Sailfish never marks its boot successful and would otherwise lose
# its slot after seven starts. Slot b on trial ($CONF/trial, pro1x-boot
# trial) gets the trial's tries and stays not successful: the bootloader
# then takes one try for every start of it and starts slot a when none
# are left (as it did on 2026-10-24, before slot b was marked successful).
set_slot() {
	target=$1
	case $target in a) other=b ;; b) other=a ;; *) die "slot must be a or b" ;; esac
	command -v sgdisk >/dev/null || die "sgdisk missing"
	p=$(part_of "boot_$target") || die "boot_$target not found"
	set -- $p
	tdisk=$1 tnum=$2
	p=$(part_of "boot_$other") || die "boot_$other not found"
	set -- $p
	odisk=$1 onum=$2
	[ "$tdisk" = "$odisk" ] || die "boot_a and boot_b on different disks"
	sgdisk -v "$tdisk" | grep -q 'No problems found' || die "GPT of $tdisk not clean, not touching it"
	mkdir -p "$CONF"
	sgdisk -b "$CONF/gpt-${tdisk##*/}.bak" "$tdisk" >/dev/null
	tries=7 succ=set
	if [ "$target" = b ] && [ -f "$CONF/trial" ]; then
		tries=$(cut -d' ' -f2 "$CONF/trial") succ=clear
	fi
	r1=clear r2=clear r4=clear
	[ $((tries & 1)) -eq 0 ] || r1=set
	[ $((tries & 2)) -eq 0 ] || r2=set
	[ $((tries & 4)) -eq 0 ] || r4=set
	sgdisk -A "$tnum:set:48" -A "$tnum:set:49" -A "$tnum:set:50" \
	       -A "$tnum:$r1:51" -A "$tnum:$r2:52" -A "$tnum:$r4:53" \
	       -A "$tnum:$succ:54" -A "$tnum:clear:55" \
	       -A "$onum:clear:48" -A "$onum:set:49" -A "$onum:clear:50" \
	       "$tdisk" >/dev/null
	sync
	[ "$(active_slot)" = "$target" ] || die "slot $target did not become active"
	echo "slot $target active (boot_$target $(attrs "$tdisk" "$tnum"), boot_$other $(attrs "$odisk" "$onum"))"
}

case "${1:-list}" in
list)
	echo "systems:"
	entries | while IFS='|' read -r key label image; do
		echo "  $key  $label${image:+  ($HOST$image)}"
	done
	for f in "$CONF"/snapshots/*; do
		[ -s "$f" ] || continue
		echo "snapshots of ${f##*/} (pro1x-boot next ${f##*/}@<number>):"
		snapshots "${f##*/}" | while IFS='|' read -r key label; do
			echo "  $key  $label"
		done
	done
	echo "running: $(cat "$CONF/current" 2>/dev/null || echo ?)"
	echo "default: $(cat "$CONF/default" 2>/dev/null || echo leste)"
	echo "next:    $(cat "$CONF/next" 2>/dev/null || echo -)"
	echo "timeout: $(cat "$CONF/timeout" 2>/dev/null || echo 5) s"
	echo "active slot: $(active_slot 2>/dev/null || echo ?)"
	if [ -f "$CONF/trial" ]; then
		echo "trial:   kernel $(cut -d' ' -f1 "$CONF/trial") on slot b, boot_b $(slot_b_state || echo ?)$( [ ! -f "$CONF/trial-ok" ] || echo ', start confirmed')"
	fi
	;;
trial)
	[ $# -ge 2 ] && [ $# -le 3 ] || die "usage: pro1x-boot trial <kernel version> [tries]"
	n=${3:-3}
	case $n in [2-7]) ;; *) die "tries: 2 to 7 (one is taken by the start that confirms)" ;; esac
	mkdir -p "$CONF"
	echo "$2 $n" > "$CONF/trial"
	rm -f "$CONF/trial-ok"
	set_slot b
	sync
	echo "kernel $2 on trial: $n starts of slot b, then slot a, unless a start is confirmed (pro1x-boot-trial)"
	;;
trial-ok)
	[ -f "$CONF/trial" ] || { echo "no trial"; exit 0; }
	[ "$(cut -d' ' -f1 "$CONF/trial")" = "$(uname -r)" ] ||
		{ echo "the trial is not for the running kernel"; exit 0; }
	touch "$CONF/trial-ok"
	sync
	echo "start of $(uname -r) confirmed; the next boot ends the trial"
	;;
trial-check)
	# For the initramfs: none, stale (the trial's kernel is not the one
	# running: its image was replaced), passed (a start was confirmed:
	# trial over, slot b successful again) or running.
	if [ ! -f "$CONF/trial" ]; then
		echo none
	elif [ "$(cut -d' ' -f1 "$CONF/trial")" != "$(uname -r)" ]; then
		rm -f "$CONF/trial" "$CONF/trial-ok"
		set_slot b > /dev/null
		echo stale
	elif [ -f "$CONF/trial-ok" ]; then
		rm -f "$CONF/trial" "$CONF/trial-ok"
		set_slot b > /dev/null
		echo passed
	else
		echo running
	fi
	;;
trial-stop)
	rm -f "$CONF/trial" "$CONF/trial-ok"
	set_slot b
	sync
	;;
next|default)
	[ $# -eq 2 ] || die "usage: pro1x-boot $1 <system>"
	valid_key "$2"
	mkdir -p "$CONF"
	echo "$2" > "$CONF/$1"
	# Starting a slot-b system from Sailfish also needs slot b active.
	if [ "$1" = next ] && [ "$2" != sailfish ] && [ "$(active_slot)" = a ]; then
		set_slot b
	elif [ "$1" = next ] && [ "$2" = sailfish ]; then
		set_slot a
	fi
	sync
	;;
timeout)
	[ $# -eq 2 ] && [ "$2" -ge 0 ] 2>/dev/null || die "usage: pro1x-boot timeout <seconds>"
	mkdir -p "$CONF"
	echo "$2" > "$CONF/timeout"
	sync
	;;
slot)
	[ $# -eq 2 ] || die "usage: pro1x-boot slot a|b"
	set_slot "$2"
	;;
reboot)
	[ $# -eq 2 ] || die "usage: pro1x-boot reboot <system>"
	"$0" next "$2"
	reboot
	;;
entries) entries ;;
snapshots)
	[ $# -eq 2 ] || die "usage: pro1x-boot snapshots <system>"
	snapshots "$2"
	;;
take-next)
	# Print the one-shot choice and forget it.
	if [ -f "$CONF/next" ]; then cat "$CONF/next"; rm -f "$CONF/next"; sync; fi
	;;
get-default) cat "$CONF/default" 2>/dev/null || echo leste ;;
current) cat "$CONF/current" 2>/dev/null || echo leste ;;
set-current)
	[ $# -eq 2 ] || die "usage: pro1x-boot set-current <system>"
	mkdir -p "$CONF"
	echo "$2" > "$CONF/current"
	;;
get-timeout) cat "$CONF/timeout" 2>/dev/null || echo 5 ;;
*)
	sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
