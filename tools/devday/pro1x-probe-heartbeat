#!/bin/sh
# pro1x-probe-heartbeat SECONDS [stopwd]: for SECONDS from now, a line every
# 2 s in the kernel log at error level (so on the console and in the pstore
# of a start that dies, loglevel=4): uptime, load, and every 6 s which
# processes hold the watchdog open, and the context switches of the kernel's
# watchdogd thread (it switches once for every ping the watchdog core
# sends while no one has /dev/watchdog open). The first line also has the watchdog
# core's open_timeout, whether qcom_wdt is loaded and its bark interrupt's
# count. Started by pro1x-probe when /host/pro1x-probe/heartbeat names the
# seconds (probe.sh arm KVER SECONDS [stopwd]). Only looks, unless stopwd:
# then it stops the trial's watchdog as soon as /dev/watchdog is there
# (the magic close, as pro1x-boot-trial does once the user interface runs),
# so the start goes on as one without a trial would.
end=$(( $(cut -d. -f1 /proc/uptime) + ${1:-120} ))
stopwd=${2:-}
say() { echo "<3>pro1x-probe: $*" > /dev/kmsg 2> /dev/null; }
wdinfo() {
	m=no
	grep -q '^qcom_wdt ' /proc/modules && m=yes
	echo "open_timeout=$(cat /sys/module/watchdog/parameters/open_timeout 2> /dev/null)" \
	    "handle_boot_enabled=$(cat /sys/module/watchdog/parameters/handle_boot_enabled 2> /dev/null)" \
	    "qcom_wdt=$m bark-irq=[$(grep -i 'bark\|wdt' /proc/interrupts | tr -s ' ' | cut -c1-60 | tr '\n' ';')]"
}
wdd=
for c in /proc/[0-9]*/comm; do
	[ "$(cat "$c" 2> /dev/null)" = watchdogd ] && { wdd=${c%/comm}; break; }
done
wdsw() { [ -n "$wdd" ] && sed -n 's/^voluntary_ctxt_switches:[[:space:]]*/ watchdogd-sw=/p' "$wdd/status" 2> /dev/null; }
say "heartbeat: $(wdinfo)"
n=0
while :; do
	now=$(cut -d. -f1 /proc/uptime)
	[ "$now" -lt "$end" ] || break
	if [ "$stopwd" = stopwd ] && [ -c /dev/watchdog ]; then
		if { printf V > /dev/watchdog; } 2> /dev/null; then
			say "trial watchdog stopped (magic close); $(wdinfo)"
		else
			say "trial watchdog: /dev/watchdog busy or refused"
		fi
		stopwd=done
	fi
	w=
	if [ $((n % 3)) -eq 0 ]; then
		for p in /proc/[0-9]*; do
			ls -l "$p/fd" 2> /dev/null | grep -q watchdog && w="$w ${p#/proc/}:$(cat "$p/comm" 2> /dev/null)"
		done
		w=", watchdog open by [${w# }]"
	fi
	say "alive, load $(cut -d' ' -f1-3 /proc/loadavg)$(wdsw)$w"
	n=$((n + 1))
	sleep 2
done
say "heartbeat ends: $(wdinfo)"
